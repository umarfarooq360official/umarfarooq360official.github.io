27:["$","article",null,{"className":"article-body ","children":[false,[["$","section","Build a country-by-country shortlist",{"id":"section-1","children":[["$","h2",null,{"children":"Build a country-by-country shortlist"}],[["$","p","Erasmus Mundus degrees span multiple institutions and countries, while DAAD and Stipendium Hungaricum operate within national systems. Tuition, visa rules and work options still depend on the host country.",{"children":"Erasmus Mundus degrees span multiple institutions and countries, while DAAD and Stipendium Hungaricum operate within national systems. Tuition, visa rules and work options still depend on the host country."}],["$","p","Compare the programme consortium, mobility path, language, degree award and funding terms—not just the headline destination.",{"children":"Compare the programme consortium, mobility path, language, degree award and funding terms—not just the headline destination."}]],"$undefined",["$","ul",null,{"children":[["$","li","Check whether the degree moves between countries",{"children":"Check whether the degree moves between countries"}],["$","li","Confirm scholarship and programme deadlines",{"children":"Confirm scholarship and programme deadlines"}],["$","li","Review residence-permit rules for each mobility stage",{"children":"Review residence-permit rules for each mobility stage"}],["$","li","Compare living allowances with local costs",{"children":"Compare living allowances with local costs"}],["$","li","Verify the final degree title and awarding institutions",{"children":"Verify the final degree title and awarding institutions"}]]}],"$undefined"]}],["$","section","How AspireCompass verifies listings",{"id":"section-2","children":[["$","h2",null,{"children":"How AspireCompass verifies listings"}],[["$","p","We summarise eligibility, funding and timing from the programme owner whenever an official page is available. Every listing shows the source and the date it was last checked.",{"children":"We summarise eligibility, funding and timing from the programme owner whenever an official page is available. Every listing shows the source and the date it was last checked."}],["$","p","Scholarship and recruitment details can change without notice. Always read the official call, confirm the deadline in your time zone and apply through the programme owner's portal. AspireCompass does not award scholarships or charge an application fee.",{"children":"Scholarship and recruitment details can change without notice. Always read the official call, confirm the deadline in your time zone and apply through the programme owner's portal. AspireCompass does not award scholarships or charge an application fee."}]],"$undefined","$undefined","$undefined"]}],["$","section","Three funding routes that work differently",{"id":"section-3","children":[["$","h2",null,{"children":"Three funding routes that work differently"}],[["$","p","Erasmus Mundus funding is tied to a specific joint master's programme, whose consortium sets language, admission and scholarship instructions. DAAD EPOS supports eligible development-related postgraduate courses in Germany, with course-specific applications and professional-experience conditions. Stipendium Hungaricum depends on a country sending partner, eligible Hungarian university courses and a nomination stage.",{"children":"Erasmus Mundus funding is tied to a specific joint master's programme, whose consortium sets language, admission and scholarship instructions. DAAD EPOS supports eligible development-related postgraduate courses in Germany, with course-specific applications and professional-experience conditions. Stipendium Hungaricum depends on a country sending partner, eligible Hungarian university courses and a nomination stage."}],"$L2b"],"$undefined","$L2c","$undefined"]}],"$L2d","$L2e"]]}]
