29:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is there one scholarship application for studying in Europe?",{"children":[["$","summary",null,{"children":["Is there one scholarship application for studying in Europe?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Erasmus Mundus, DAAD, Stipendium Hungaricum and university awards use different application systems. Start with the exact programme and country, then follow that programme owner's current instructions."}]]}],["$","details","Does a European scholarship automatically cover every living cost?",{"children":[["$","summary",null,{"children":["Does a European scholarship automatically cover every living cost?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not necessarily. Tuition, stipend, accommodation, insurance and travel coverage differ by award and city. Compare the official benefit list with the cost of the actual study location."}]]}],["$","details","Should I choose a country or a scholarship first?",{"children":[["$","summary",null,{"children":["Should I choose a country or a scholarship first?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Choose the degree and realistic destinations together. A strong shortlist matches academic fit, eligibility, funding and the admission route rather than chasing a funding label alone."}]]}]]}]]}]
