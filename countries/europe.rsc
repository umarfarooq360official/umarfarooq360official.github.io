2d:["$","section","Budget for the exact location and mobility pattern",{"id":"section-4","children":[["$","h2",null,{"children":"Budget for the exact location and mobility pattern"}],[["$","p","For a joint degree, note where each semester is taught, what travel is provided and whether visa or residence permissions change along the way. For a single-country award, compare the stipend and housing support with that city's actual expenses.",{"children":"For a joint degree, note where each semester is taught, what travel is provided and whether visa or residence permissions change along the way. For a single-country award, compare the stipend and housing support with that city's actual expenses."}],["$","p","Build a shortlist with degree title, official source, eligibility, confirmed deadline, funding exclusions and your next step. Consider the UK scholarship routes separately when comparing Europe because their university-offer and citizenship rules differ.",{"children":"Build a shortlist with degree title, official source, eligibility, confirmed deadline, funding exclusions and your next step. Consider the UK scholarship routes separately when comparing Europe because their university-offer and citizenship rules differ."}]],"$undefined","$undefined","$undefined"]}]
2e:["$","section","Italy: connect funding to the regional and university system",{"id":"section-5","children":[["$","h2",null,{"children":"Italy: connect funding to the regional and university system"}],[["$","p","Italy adds three routes to a European shortlist: the national MAECI call, regional DSU benefits and university merit or fee-waiver schemes. Applicants must identify the correct regional body and should not treat one DSU deadline or economic threshold as a national rule.",{"children":"Italy adds three routes to a European shortlist: the national MAECI call, regional DSU benefits and university merit or fee-waiver schemes. Applicants must identify the correct regional body and should not treat one DSU deadline or economic threshold as a national rule."}],["$","p","Use the Italy hub to compare selected university fees, language evidence, admission and Universitaly pre-enrolment alongside funding. This prevents a scholarship shortlist from ignoring the separate course and visa sequence.",{"children":"Use the Italy hub to compare selected university fees, language evidence, admission and Universitaly pre-enrolment alongside funding. This prevents a scholarship shortlist from ignoring the separate course and visa sequence."}]],"$undefined","$undefined","$undefined"]}]
