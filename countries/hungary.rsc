1f:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Does Stipendium Hungaricum cover every living cost?",{"children":[["$","summary",null,{"children":["Does Stipendium Hungaricum cover every living cost?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Its official site describes the stipend and accommodation support as contributions toward living expenses. Budget the remaining cost for your specific city."}]]}],["$","details","Can every nationality apply for every Hungarian degree?",{"children":[["$","summary",null,{"children":["Can every nationality apply for every Hungarian degree?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Availability depends on the sending-partner agreement and eligible fields and programmes for your country. Check the current official partner list."}]]}],["$","details","Is IELTS automatically required for Hungary scholarships?",{"children":[["$","summary",null,{"children":["Is IELTS automatically required for Hungary scholarships?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"There is no single rule for every Hungarian programme. The chosen institution sets its language requirements; confirm the accepted evidence for the exact degree."}]]}]]}]]}]
