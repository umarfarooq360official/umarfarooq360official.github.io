{"children":"ER.GO: international students"}],["$","span",null,{"children":"Official guidance for applicants whose family income or assets are outside Italy"}]]}],["$","$L4",null,{"ref":"$undefined","iconNode":"$23:props:children:3:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L3","https://www.unipd.it/en/ammissione-studenti-internazionali",{"href":"https://www.unipd.it/en/ammissione-studenti-internazionali","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"University of Padua: international admissions"}],["$","span",null,{"children":"Official 2027–2028 first-call dates and foreign-qualification guidance"}]]}],["$","$L4",null,{"ref":"$undefined","iconNode":"$23:props:children:3:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L3","https://www.polimi.it/en/prospective-students/how-to-apply/admission-to-laurea-magistrale/foreign-qualification",{"href":"https://www.polimi.it/en/prospective-students/how-to-apply/admission-to-laurea-magistrale/foreign-qualification","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Politecnico di Milano: students with a foreign qualification"}],["$","span",null,{"children":"Official master's admission route"}]]}],["$","$L4",null,{"ref":"$undefined","iconNode":"$23:props:children:3:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L3","https://vistoperitalia.esteri.it/home/en",{"href":"https://vistoperitalia.esteri.it/home/en","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Visa for Italy"}],["$","span",null,{"children":"Italian Ministry of Foreign Affairs visa information"}]]}],["$","$L4",null,{"ref":"$undefined","iconNode":"$23:props:children:3:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
24:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can international students study in Italy with a scholarship?",{"children":[["$","summary",null,{"children":["Can international students study in Italy with a scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Possible routes include MAECI, regional DSU benefits, university merit awards, fee waivers and research funding. Eligibility, coverage and application ownership differ."}]]}],["$","details","Can I study in Italy without IELTS?",{"children":[["$","summary",null,{"children":["Can I study in Italy without IELTS?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Possibly, when the exact programme accepts another certificate or documented prior education in English. There is no country-wide IELTS waiver, so verify the programme's accepted evidence."}]]}],["$","details","Are Italian public universities free?",{"children":[["$","summary",null,{"children":["Are Italian public universities free?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not automatically. Fees can be reduced according to income, status or a waiver, but each university publishes its own calculation, deadlines and mandatory charges."}]]}],["$","details","Is Universitaly the university application portal?",{"children":[["$","summary",null,{"children":["Is Universitaly the university application portal?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Usually it is a later pre-enrolment step for eligible international applicants. You first follow the university's own admission instructions unless that institution explicitly states another route."}]]}],["$","details","Does a scholarship guarantee an Italian student visa?",{"children":[["$","summary",null,{"children":["Does a scholarship guarantee an Italian student visa?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Admission, funding and the visa are separate decisions. The competent Italian diplomatic mission makes the visa decision using its current requirements."}]]}]]}]]}]
25:["$","aside",null,{"className":"content-sidebar","children":[["$","div",null,{"className":"sidebar-card sidebar-card--contents","children":[["$","span",null,{"children":"On this page"}],["$","h2",null,{"children":"Jump to a section"}],["$","nav",null,{"children":[["$","a","Quick answer: Italy has three main funding routes",{"href":"#section-1","children":[["$","b",null,{"children":"01"}],"Quick answer: Italy has three main funding routes"]}],["$","a","Current planning status on 29 September 2026",{"href":"#section-2","children":[["$","b",null,{"children":"02"}],"Current planning status on 29 September 2026"]}],["$","a","Choose a degree before choosing a funding headline",{"href":"#section-3","children":[["$","b",null,{"children":"03"}],"Choose a degree before choosing a funding headline"]}],["$","a","English requirements are programme-specific",{"href":"#section-4","children":[["$","b",null,{"children":"04"}],"English requirements are programme-specific"]}],["$","a","Understand tuition before estimating the scholarship gap",{"href":"#section-5","children":[["$","b",null,{"children":"05"}],"Understand tuition before estimating the scholarship gap"]}],["$","a","Follow the admission, Universitaly and visa sequence",{"href":"#section-6","children":[["$","b",null,{"children":"06"}],"Follow the admission, Universitaly and visa sequence"]}],["$","a","A practical Italy shortlist",{"href":"#section-7","children":[["$","b",null,{"children":"07"}],"A practical Italy shortlist"]}]]}]]}],["$","div",null,{"className":"sidebar-card sidebar-card--accent","children":[["$","$L4",null,{"ref":"$undefined","iconNode":"$9:1:props:children:props:children:props:fallback:props:children:props:children:0:props:children:props:iconNode","className":"lucide-compass","aria-hidden":"true"}],["$","span",null,{"children":"Find your route"}],["$","h2",null,{"children":"Not sure where to begin?"}],["$","p",null,{"children":"Filter the opportunity database by type, level and destination."}],["$","$L3",null,{"href":"/matcher","children":["Use the matcher ",["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]],"data-slot":"button","data-variant":"default","data-size":"default","className":"inline-flex shrink-0 items-center justify-center gap-2 rounded-md text-sm font-medium whitespace-nowrap transition-all outline-none focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 disabled:pointer-events-none disabled:opacity-50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&_svg]:pointer-events-none [&_svg]:shrink-0 [&_svg:not([class*='size-'])]:size-4 bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4 py-2 has-[>svg]:px-3 brand-button","ref":null}]]}],["$","div",null,{"className":"sidebar-card","children":[["$","h2",null,{"children":"Safety check"}],["$","ul",null,{"children":[["$","li",null,{"children":[["$","$L4",null,{"ref":"$undefined","iconNode":"$7:props:children:0:props:children:0:props:children:2:props:children:0:props:iconNode","className":"lucide-circle-check","aria-hidden":"true"}],"Apply on the official domain"]}],["$","li",null,{"children":[["$","$L4",null,{"ref":"$undefined","iconNode":"$7:props:children:0:props:children:0:props:children:2:props:children:0:props:iconNode","className":"lucide-circle-check","aria-hidden":"true"}],"Verify the current deadline"]}],["$","li",null,{"children":[["$","$L4",null,{"ref":"$undefined","iconNode":"$7:props:children:0:props:children:0:props:children:2:props:children:0:props:iconNode","className":"lucide-circle-check","aria-hidden":"true"}],"Never pay for a guarantee"]}],["$","li",null,{"children":[["$","$L4",null,{"ref":"$undefined","iconNode":"$7:props:children:0:props:children:0:props:children:2:props:children:0:props:iconNode","className":"lucide-circle-check","aria-hidden":"true"}],"Protect personal documents"]}]]}],["$","$L3",null,{"href":"/legal","children":["Read the full safety guide ",["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
26:["$","section","Choose a degree before choosing a funding headline",{"id":"section-3","children":[["$","h2",null,{"children":"Choose a degree before choosing a funding headline"}],[["$","p","Start with the exact bachelor's, single-cycle, master's or doctoral programme. Record the teaching language, academic prerequisites, intake, application portal and whether admission is limited by a test or ranking. For a bachelor's route, a foreign school qualification normally needs to represent at least 12 years of education; university-specific rules explain how shorter school systems are assessed.",{"children":"Start with the exact bachelor's, single-cycle, master's or doctoral programme. Record the teaching language, academic prerequisites, intake, application portal and whether admission is limited by a test or ranking. For a bachelor's route, a foreign school qualification normally needs to represent at least 12 years of education; university-specific rules explain how shorter school systems are assessed."}],["$","p","For a master's application, compare your previous degree, subjects, credits and grades with the programme requirements. A university can reject an academically mismatched application even when the applicant qualifies for a general scholarship category.",{"children":"For a master's application, compare your previous degree, subjects, credits and grades with the programme requirements. A university can reject an academically mismatched application even when the applicant qualifies for a general scholarship category."}]],["$","ul",null,{"children":[["$","li","Exact programme and campus",{"children":"Exact programme and campus"}],["$","li","Degree level and prior qualification",{"children":"Degree level and prior qualification"}],["$","li","Teaching language",{"children":"Teaching language"}],["$","li","Admission call and deadline",{"children":"Admission call and deadline"}],["$","li","Application fee and document format",{"children":"Application fee and document format"}],["$","li","Separate funding deadline",{"children":"Separate funding deadline"}]]}]]}]
27:["$","section","English requirements are programme-specific",{"id":"section-4","children":[["$","h2",null,{"children":"English requirements are programme-specific"}],[["$","p","Italy does not have one IELTS score for every university. English-taught programmes commonly ask for a CEFR level such as B1 or B2 and publish their own accepted certificates, minimum scores and deadlines. Some institutions may accept a completed qualification taught entirely in English when the official documents clearly state the language of instruction.",{"children":"Italy does not have one IELTS score for every university. English-taught programmes commonly ask for a CEFR level such as B1 or B2 and publish their own accepted certificates, minimum scores and deadlines. Some institutions may accept a completed qualification taught entirely in English when the official documents clearly state the language of instruction."}],["$","p","Treat a Medium of Instruction letter as evidence to be checked, not a universal IELTS waiver. Verify the exact course notice, scholarship condition and consular checklist. An English-taught degree can also carry a later Italian-language learning requirement at some institutions.",{"children":"Treat a Medium of Instruction letter as evidence to be checked, not a universal IELTS waiver. Verify the exact course notice, scholarship condition and consular checklist. An English-taught degree can also carry a later Italian-language learning requirement at some institutions."}]],"$undefined"]}]
28:["$","section","Understand tuition before estimating the scholarship gap",{"id":"section-5","children":[["$","h2",null,{"children":"Understand tuition before estimating the scholarship gap"}],[["$","p","Public-university tuition can depend on the programme, study load, citizenship or residence category and the family's economic documentation. For 2026–2027, the University of Padua describes general degree costs from zero to about €3,000 a year. Politecnico di Milano shows a standard annual range from €157.04 up to €3,943.04, while reserved non-EU master's students with a foreign qualification may be charged the maximum when no qualifying scholarship applies.",{"children":"Public-university tuition can depend on the programme, study load, citizenship or residence category and the family's economic documentation. For 2026–2027, the University of Padua describes general degree costs from zero to about €3,000 a year. Politecnico di Milano shows a standard annual range from €157.04 up to €3,943.04, while reserved non-EU master's students with a foreign qualification may be charged the maximum when no qualifying scholarship applies."}],["$","p","The University of Bologna uses a fixed €157.04 component plus a variable programme and economic component. These examples are planning references for a named academic year. Your final amount comes from the university account after your documents are assessed.",{"children":"The University of Bologna uses a fixed €157.04 component plus a variable programme and economic component. These examples are planning references for a named academic year. Your final amount comes from the university account after your documents are assessed."}]],"$undefined"]}]
29:["$","section","Follow the admission, Universitaly and visa sequence",{"id":"section-6","children":[["$","h2",null,{"children":"Follow the admission, Universitaly and visa sequence"}],[["$","p","Apply first through the university's stated admission system. After a positive evaluation, non-EU applicants living abroad generally complete the required pre-enrolment through Universitaly. The university validates the request so it can support the study-visa process with the relevant Italian diplomatic mission.",{"children":"Apply first through the university's stated admission system. After a positive evaluation, non-EU applicants living abroad generally complete the required pre-enrolment through Universitaly. The university validates the request so it can support the study-visa process with the relevant Italian diplomatic mission."}],["$","p","University validation does not guarantee a visa. Follow the embassy or consulate serving your place of residence for financial, accommodation, insurance and document requirements. Keep university admission, scholarship, Universitaly and visa tasks as four separate rows in your tracker.",{"children":"University validation does not guarantee a visa. Follow the embassy or consulate serving your place of residence for financial, accommodation, insurance and document requirements. Keep university admission, scholarship, Universitaly and visa tasks as four separate rows in your tracker."}]],"$undefined"]}]
2a:["$","section","A practical Italy shortlist",{"id":"section-7","children":[["$","h2",null,{"children":"A practical Italy shortlist"}],[["$","p","For every programme, create one record containing the official degree page, admission call, tuition page, language rule, scholarship owner and current deadline. Add a personal budget showing tuition after any waiver, housing, food, transport, insurance, visa-related costs and money needed before the first benefit payment.",{"children":"For every programme, create one record containing the official degree page, admission call, tuition page, language rule, scholarship owner and current deadline. Add a personal budget showing tuition after any waiver, housing, food, transport, insurance, visa-related costs and money needed before the first benefit payment."}],["$","p","Use the dedicated AspireCompass guides below for the detailed checks. Return to the original university or government page immediately before submission because annual calls and document rules can change.",{"children":"Use the dedicated AspireCompass guides below for the detailed checks. Return to the original university or government page immediately before submission because annual calls and document rules can change."}]],["$","ul",null,{"children":[["$","li","Italy scholarships and current-cycle status",{"children":"Italy scholarships and current-cycle status"}],["$","li","DSU and foreign-income documents",{"children":"DSU and foreign-income documents"}],["$","li","Selected universities and 2026–2027 fees",{"children":"Selected universities and 2026–2027 fees"}],["$","li","English evidence and admission sequence",{"children":"English evidence and admission sequence"}]]}]]}]
