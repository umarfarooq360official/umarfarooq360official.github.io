1f:["$","article",null,{"className":"article-body ","children":[false,[["$","section","Choose your next Italy step",{"id":"section-1","children":[["$","h2",null,{"children":"Choose your next Italy step"}],[["$","p","Start with the task that is blocking your application. Each guide below answers a different question.",{"children":"Start with the task that is blocking your application. Each guide below answers a different question."}]],"$undefined",["$","ul",null,{"children":[["$","li","No university shortlist yet? Compare the three profiles.",{"children":"No university shortlist yet? Compare the three profiles."}],["$","li","Need regional support? Read DSU and then the financial-document route.",{"children":"Need regional support? Read DSU and then the financial-document route."}],["$","li","Already admitted? Check the university's Universitaly instructions.",{"children":"Already admitted? Check the university's Universitaly instructions."}]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Choose your next Italy step","children":[["$","$L3","/guides/university-of-padua-admissions-scholarships/",{"href":"/guides/university-of-padua-admissions-scholarships/","children":["University of Padua",["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","/guides/politecnico-di-milano-masters-admissions/",{"href":"/guides/politecnico-di-milano-masters-admissions/","children":["Politecnico di Milano",["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","/guides/university-of-bologna-admissions-scholarships/",{"href":"/guides/university-of-bologna-admissions-scholarships/","children":["University of Bologna",["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L