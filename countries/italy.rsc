21:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can international students study in Italy with a scholarship?",{"children":[["$","summary",null,{"children":["Can international students study in Italy with a scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Possible routes include MAECI, regional DSU benefits, university merit awards, fee waivers and research funding. Eligibility, coverage and application ownership differ."}]]}],["$","details","Can I study in Italy without IELTS?",{"children":[["$","summary",null,{"children":["Can I study in Italy without IELTS?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Possibly, when the exact programme accepts another certificate or documented prior education in English. There is no country-wide IELTS waiver, so verify the programme's accepted evidence."}]]}],["$","details","Are Italian public universities free?",{"children":[["$","summary",null,{"children":["Are Italian public universities free?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not automatically. Fees can be reduced according to income, status or a waiver, but each university publishes its own calculation, deadlines and mandatory charges."}]]}],["$","details","Is Universitaly the university application portal?",{"children":[["$","summary",null,{"children":["Is Universitaly the university application portal?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Usually it is a later pre-enrolment step for eligible international applicants. You first follow the university's own admission instructions unless that institution explicitly states another route."}]]}],["$","details","Does a scholarship guarantee an Italian student visa?",{"children":[["$","summary",null,{"children":["Does a scholarship guarantee an Italian student visa?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Admission, funding and the visa are separate decisions. The competent Italian diplomatic mission makes the visa decision using its current requirements."}]]}]]}]]}]
