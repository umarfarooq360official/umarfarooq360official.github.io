2b:["$","section","Current planning status: checked 5 October 2026",{"id":"section-3","children":[["$","h2",null,{"children":"Current planning status: checked 5 October 2026"}],[["$","p","Checked 5 October 2026. The table is a selected tracker, not a complete national calendar. The Polimi Engineering page has an academic-year heading inconsistent with its September 2027 rows: confirm your programme with admissions.",{"children":"Checked 5 October 2026. The table is a selected tracker, not a complete national calendar. The Polimi Engineering page has an academic-year heading inconsistent with its September 2027 rows: confirm your programme with admissions."}]],[["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Named calls and tasks: keep the academic year attached","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Named calls and tasks: keep the academic year attached"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th","Task",{"scope":"col","children":"Task"}],["$","th","Published date",{"scope":"col","children":"Published date"}],["$","th","Category/status",{"scope":"col","children":"Category/status"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[["$","th","0",{"scope":"row","children":"Padua first admission call"}],["$","td","1",{"children":"15 Sep–15 Nov 2026"}],["$","td","2",{"children":"Most 2027–2028 programmes; exceptions apply"}]]}],["$","tr","1",{"children":[["$","th","0",{"scope":"row","children":"Polimi Engineering first call"}],["$","td","1",{"children":"1 Oct–1 Dec 2026"}],["$","td","2",{"children":"September 2027 intake; 23:59 CET"}]]}],["$","tr","2",{"children":[["$","th","0",{"scope":"row","children":"Polimi Architecture/Design general call"}],["$","td","1",{"children":"1 Oct 2026–28 Jan 2027"}],["$","td","2",{"children":"September 2027 intake; 23:59 CET"}]]}],["$","tr","3",{"children":[["$","th","0",{"scope":"row","children":"Polimi merit form"}],["$","td","1",{"children":"15 Dec 2026, noon Italian time"}],["$","td","2",{"children":"2027–2028; eligible early-bird admission first"}]]}],["$","tr","4",{"children":[["$","th","0",{"scope":"row","children":"Padua Excellence notice"}],["$","td","1",{"children":"Further call information expected Nov 2026"}],["$","td","2",{"children":"Do not label the future award confirmed/open"}]]}],["$","tr","5",{"children":[["$","th","0",{"scope":"row","children":"Bologna admission"}],["$","td","1",{"children":"Read selected degree call"}],["$","td","2",{"children":"No universal university-wide deadline"}]]}]]}]]}]}],"$undefined"],"$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Current planning status: checked 5 October 2026","children":[["$","$L3","https://www.unipd.it/en/ammissione-studenti-internazionali",{"href":"https://www.unipd.it/en/ammissione-studenti-internazionali","children":["Padua international admissions",["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","https://www.polimi.it/en/prospective-students/how-to-apply/admission-to-laurea-magistrale/foreign-qualification/deadlines",{"href":"https://www.polimi.it/en/prospective-students/how-to-apply/admission-to-laurea-magistrale/foreign-qualification/deadlines","children":["Polimi admission windows by study area",["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","https://www.polimi.it/fileadmin/user_upload/futuri_studenti/borse-di-studio/Merit_Based_Call_For_Applications_a.y._2027-2028.pdf",{"href":"https://www.polimi.it/fileadmin/user_upload/futuri_studenti/borse-di-studio/Merit_Based_Call_For_Applications_a.y._2027-2028.pdf","children":["Polimi merit-scholarship call: 2027–2028 PDF",["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","https://www.unipd.it/en/padua-international-excellence-scholarship-programme",{"href":"https://www.unipd.it/en/padua-international-excellence-scholarship-programme","children":["Padua International Excellence: award and future-call notice","$L31"]}]]}]]}]
2c:["$","section","Choose a degree before choosing a funding headline",{"id":"section-4","children":[["$","h2",null,{"children":"Choose a degree before choosing a funding headline"}],[["$","p","Start with the exact bachelor's, single-cycle, master's or doctoral programme. Record the teaching language, academic prerequisites, intake, application portal and whether admission is limited by a test or ranking. For a bachelor's route, a foreign school qualification normally needs to represent at least 12 years of education; university-specific rules explain how shorter school systems are assessed.",{"children":"Start with the exact bachelor's, single-cycle, master's or doctoral programme. Record the teaching language, academic prerequisites, intake, application portal and whether admission is limited by a test or ranking. For a bachelor's route, a foreign school qualification normally needs to represent at least 12 years of education; university-specific rules explain how shorter school systems are assessed."}],["$","p","For a master's application, compare your previous degree, subjects, credits and grades with the programme requirements. A university can reject an academically mismatched application even when the applicant qualifies for a general scholarship category.",{"children":"For a master's application, compare your previous degree, subjects, credits and grades with the programme requirements. A university can reject an academically mismatched application even when the applicant qualifies for a general scholarship category."}]],"$undefined",["$","ul",null,{"children":[["$","li","Exact programme and campus",{"children":"Exact programme and campus"}],["$","li","Degree level and prior qualification",{"children":"Degree level and prior qualification"}],["$","li","Teaching language",{"children":"Teaching language"}],["$","li","Admission call and deadline",{"children":"Admission call and deadline"}],["$","li","Application fee and document format",{"children":"Application fee and document format"}],["$","li","Separate funding deadline",{"children":"Separate funding deadline"}]]}],"$undefined"]}]
2d:["$","section","English requirements are programme-specific",{"id":"section-5","children":[["$","h2",null,{"children":"English requirements are programme-specific"}],[["$","p","Italy does not have one IELTS score for every university. English-taught programmes commonly ask for a CEFR level such as B1 or B2 and publish their own accepted certificates, minimum scores and deadlines. Some institutions may accept a completed qualification taught entirely in English when the official documents clearly state the language of instruction.",{"children":"Italy does not have one IELTS score for every university. English-taught programmes commonly ask for a CEFR level such as B1 or B2 and publish their own accepted certificates, minimum scores and deadlines. Some institutions may accept a completed qualification taught entirely in English when the official documents clearly state the language of instruction."}],["$","p","Treat a Medium of Instruction letter as evidence to be checked, not a universal IELTS waiver. Verify the exact course notice, scholarship condition and consular checklist. An English-taught degree can also carry a later Italian-language learning requirement at some institutions.",{"children":"Treat a Medium of Instruction letter as evidence to be checked, not a universal IELTS waiver. Verify the exact course notice, scholarship condition and consular checklist. An English-taught degree can also carry a later Italian-language learning requirement at some institutions."}]],"$undefined","$undefined","$undefined"]}]
2e:["$","section","Understand tuition before estimating the scholarship gap",{"id":"section-6","children":[["$","h2",null,{"children":"Understand tuition before estimating the scholarship gap"}],[["$","p","Public-university tuition can depend on the programme, study load, citizenship or residence category and the family's economic documentation. For 2026–2027, the University of Padua describes general degree costs from zero to about €3,000 a year. Politecnico di Milano shows a standard annual range from €157.04 up to €3,943.04, while reserved non-EU master's students with a foreign qualification may be charged the maximum when no qualifying scholarship applies.",{"children":"Public-university tuition can depend on the programme, study load, citizenship or residence category and the family's economic documentation. For 2026–2027, the University of Padua describes general degree costs from zero to about €3,000 a year. Politecnico di Milano shows a standard annual range from €157.04 up to €3,943.04, while reserved non-EU master's students with a foreign qualification may be charged the maximum when no qualifying scholarship applies."}],["$","p","The University of Bologna uses a fixed €157.04 component plus a variable programme and economic component. These examples are planning references for a named academic year. Your final amount comes from the university account after your documents are assessed.",{"children":"The University of Bologna uses a fixed €157.04 component plus a variable programme and economic component. These examples are planning references for a named academic year. Your final amount comes from the university account after your documents are assessed."}]],"$undefined","$undefined","$undefined"]}]
2f:["$","section","Follow the admission, Universitaly and visa sequence",{"id":"section-7","children":[["$","h2",null,{"children":"Follow the admission, Universitaly and visa sequence"}],[["$","p","Apply first through the university's stated admission system. After a positive evaluation, non-EU applicants living abroad generally complete the required pre-enrolment through Universitaly. The university validates the request so it can support the study-visa process with the relevant Italian diplomatic mission.",{"children":"Apply first through the university's stated admission system. After a positive evaluation, non-EU applicants living abroad generally complete the required pre-enrolment through Universitaly. The university validates the request so it can support the study-visa process with the relevant Italian diplomatic mission."}],["$","p","University validation does not guarantee a visa. Follow the embassy or consulate serving your place of residence for financial, accommodation, insurance and document requirements. Keep university admission, scholarship, Universitaly and visa tasks as four separate rows in your tracker.",{"children":"University validation does not guarantee a visa. Follow the embassy or consulate serving your place of residence for financial, accommodation, insurance and document requirements. Keep university admission, scholarship, Universitaly and visa tasks as four separate rows in your tracker."}]],"$undefined","$undefined","$undefined"]}]
30:["$","section","A practical Italy shortlist",{"id":"section-8","children":[["$","h2",null,{"children":"A practical Italy shortlist"}],[["$","p","For every programme, create one record containing the official degree page, admission call, tuition page, language rule, scholarship owner and current deadline. Add a personal budget showing tuition after any waiver, housing, food, transport, insurance, visa-related costs and money needed before the first benefit payment.",{"children":"For every programme, create one record containing the official degree page, admission call, tuition page, language rule, scholarship owner and current deadline. Add a personal budget showing tuition after any waiver, housing, food, transport, insurance, visa-related costs and money needed before the first benefit payment."}],["$","p","Use the dedicated AspireCompass guides below for the detailed checks. Return to the original university or government page immediately before submission because annual calls and document rules can change.",{"children":"Use the dedicated AspireCompass guides below for the detailed checks. Return to the original university or government page immediately before submission because annual calls and document rules can change."}]],"$undefined",["$","ul",null,{"children":[["$","li","Italy scholarships and current-cycle status",{"children":"Italy scholarships and current-cycle status"}],["$","li","DSU and foreign-income documents",{"children":"DSU and foreign-income documents"}],["$","li","Selected universities and 2026–2027 fees",{"children":"Selected universities and 2026–2027 fees"}],["$","li","English evidence and admission sequence",{"children":"English evidence and admission sequence"}]]}],"$undefined"]}]
31:["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]
