$","article",null,{"className":"article-body ","children":[false,[["$","section","Where Canadian funding is found",{"id":"section-1","children":[["$","h2",null,{"children":"Where Canadian funding is found"}],[["$","p","Start at the department and graduate faculty, not only the central scholarship page. Funding packages can combine teaching assistantships, research assistantships, entrance awards and supervisor support.",{"children":"Start at the department and graduate faculty, not only the central scholarship page. Funding packages can combine teaching assistantships, research assistantships, entrance awards and supervisor support."}],"$L16"],"$L17"]}],"$L18","$L19","$L1a","$L1b","$L1c"]]}],"$L1d","$L1e"]}],"$L1f"]}]
