1e:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can I apply for more than one opportunity?",{"children":[["$","summary",null,{"children":["Can I apply for more than one opportunity?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Usually yes, unless a programme's official rules restrict parallel applications. Keep a tracker for deadlines, references and programme-specific documents."}]]}],["$","details","Does AspireCompass accept applications?",{"children":[["$","summary",null,{"children":["Does AspireCompass accept applications?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. AspireCompass helps you discover and compare opportunities. Applications must be submitted on the official programme or institution website."}]]}],["$","details","Are Canadian scholarships automatically considered with admission?",{"children":[["$","summary",null,{"children":["Are Canadian scholarships automatically considered with admission?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Some are, but many are not. Major awards may require a separate form, early admission or school nomination. Read the official award page and the department's funding instructions."}]]}],["$","details","Does a funded PhD offer cover the full cost of living in Canada?",{"children":[["$","summary",null,{"children":["Does a funded PhD offer cover the full cost of living in Canada?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not necessarily. Compare the net amount after tuition and fees with housing, food, transport and insurance in the specific city, and check whether part of the package requires paid work."}]]}],["$","details","Does AspireCompass submit applications for students?",{"children":[["$","summary",null,{"children":["Does AspireCompass submit applications for students?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. AspireCompass is an independent research and guidance website. Apply only through the programme, university, government or employer portal linked as the official source."}]]}],["$","details","Can a deadline or eligibility rule change after this page is updated?",{"children":[["$","summary",null,{"children":["Can a deadline or eligibility rule change after this page is updated?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Programme owners can revise dates, benefits and rules. Reopen the official call before you act, check the intake year and save a copy of the instructions used for your application."}]]}]]}]]}]
