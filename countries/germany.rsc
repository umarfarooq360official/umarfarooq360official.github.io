1e:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can I apply for more than one opportunity?",{"children":[["$","summary",null,{"children":["Can I apply for more than one opportunity?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Usually yes, unless a programme's official rules restrict parallel applications. Keep a tracker for deadlines, references and programme-specific documents."}]]}],["$","details","Does AspireCompass accept applications?",{"children":[["$","summary",null,{"children":["Does AspireCompass accept applications?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. AspireCompass helps you discover and compare opportunities. Applications must be submitted on the official programme or institution website."}]]}],["$","details","Is studying in Germany free for every international student?",{"children":[["$","summary",null,{"children":["Is studying in Germany free for every international student?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Tuition and fees depend on the state, institution and programme, and living costs still apply. Confirm the current fee schedule for the exact course."}]]}],["$","details","Where do I apply for DAAD EPOS?",{"children":[["$","summary",null,{"children":["Where do I apply for DAAD EPOS?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Applications are normally submitted to the selected eligible postgraduate course according to its instructions, not through one universal DAAD application. Check the current DAAD listing and course deadline."}]]}],["$","details","Does AspireCompass submit applications for students?",{"children":[["$","summary",null,{"children":["Does AspireCompass submit applications for students?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. AspireCompass is an independent research and guidance website. Apply only through the programme, university, government or employer portal linked as the official source."}]]}],["$","details","Can a deadline or eligibility rule change after this page is updated?",{"children":[["$","summary",null,{"children":["Can a deadline or eligibility rule change after this page is updated?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Programme owners can revise dates, benefits and rules. Reopen the official call before you act, check the intake year and save a copy of the instructions used for your application."}]]}],["$","details","Is studying in Germany completely free for international students?",{"children":[["$","summary",null,{"children":["Is studying in Germany completely free for international students?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not always. Tuition policy varies by institution and programme, and students still need to plan semester contributions, insurance, housing, food, travel and other costs."}]]}],["$","details","Does every DAAD scholarship require work experience?",{"children":[["$","summary",null,{"children":["Does every DAAD scholarship require work experience?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Requirements differ by programme. DAAD EPOS generally targets development-related postgraduate courses and relevant professional experience, but other awards use different rules."}]]}]]}]]}]
