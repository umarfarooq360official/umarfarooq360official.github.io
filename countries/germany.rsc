15:["$","section","How AspireCompass verifies listings",{"id":"section-2","children":[["$","h2",null,{"children":"How AspireCompass verifies listings"}],[["$","p","We summarise eligibility, funding and timing from the programme owner whenever an official page is available. Every listing shows the source and the date it was last checked.",{"children":"We summarise eligibility, funding and timing from the programme owner whenever an official page is available. Every listing shows the source and the date it was last checked."}],["$","p","Scholarship and recruitment details can change without notice. Always read the official call, confirm the deadline in your time zone and apply through the programme owner's portal. AspireCompass does not award scholarships or charge an application fee.",{"children":"Scholarship and recruitment details can change without notice. Always read the official call, confirm the deadline in your time zone and apply through the programme owner's portal. AspireCompass does not award scholarships or charge an application fee."}]],"$undefined"]}]
