10:T546,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Does AspireCompass require an account?","acceptedAnswer":{"@type":"Answer","text":"No. Public pages and the opportunity matcher can be used without creating a reader account."}},{"@type":"Question","name":"Does AspireCompass collect scholarship applications?","acceptedAnswer":{"@type":"Answer","text":"No. Apply through the official programme portal. Do not email AspireCompass passports, transcripts, banking information or complete application files."}},{"@type":"Question","name":"Can Google use cookies for ads on this site?","acceptedAnswer":{"@type":"Answer","text":"When Google advertising is active and permitted by applicable consent choices, Google and its partners may use cookies or similar identifiers to serve and measure ads."}},{"@type":"Question","name":"How can I control personalised Google ads?","acceptedAnswer":{"@type":"Answer","text":"Use Google Ads Settings and the consent choices presented on the site where applicable. Browser and industry opt-out controls may also be available."}},{"@type":"Question","name":"Do external scholarship portals follow this policy?","acceptedAnswer":{"@type":"Answer","text":"No. Each external programme or institution has its own privacy policy and controls the data submitted to its portal."}}]}1:["$","main",null,{"id":"main-content","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"How AspireCompass handles data, cookies and advertising\",\"item\":\"https://aspirecompass.org/privacy-policy/\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$10"}}]],["$","section",null,{"className":"inner-hero inner-hero