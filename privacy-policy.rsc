12:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,false,false,false,false,false,false,["$","article",null,{"className":"article-body ","children":[false,[["$","section","Scope and data controller contact",{"id":"section-1","children":[["$","h2",null,{"children":"Scope and data controller contact"}],[["$","p","This policy applies to the public website at aspirecompass.org. AspireCompass is an independent information website and does not operate scholarship, university or employer application portals.",{"children":"This policy applies to the public website at aspirecompass.org. AspireCompass is an independent information website and does not operate scholarship, university or employer application portals."}],["$","p","Privacy questions can be sent to hello@aspirecompass.com. Do not include passports, transcripts, banking information, passwords or other sensitive application documents in an email to us.",{"children":"Privacy questions can be sent to hello@aspirecompass.com. Do not include passports, transcripts, banking information, passwords or other sensitive application documents in an email to us."}]],"$undefined"]}],["$","section","Information you choose to provide",{"id":"section-2","children":[["$","h2",null,{"children":"Information you choose to provide"}],[["$","p","The website does not require a reader account. If you email a correction, opportunity suggestion or question, we receive the information contained in the message, such as your email address, name if supplied, public URLs and the text of your request.",{"children":"The website does not require a reader account. If you email a correction, opportunity suggestion or question, we receive the information contained in the message, such as your email address, name if supplied, public URLs and the text of your request."}],["$","p","We use that information to understand and respond to the message, review a reported issue, protect the website and retain a reasonable record of editorial corrections. Please provide only what is necessary for that purpose.",{"children":"We use that information to understand and respond to the message, review a reported issue, protect the website and retain a reasonable record of editorial corrections. Please provide only what is necessary for that purpose."}]],"$undefined"]}],["$","section","Technical and usage information",{"id":"section-3","children":[["$","h2",null,{"children":"Technical and usage information"}],[["$","p","Hosting, security and measurement services may process basic technical information such as IP address, browser type, device information, requested pages, referral information, approximate location, timestamps and error or security events. This information may be recorded automatically in server logs or aggregated analytics.",{"children":"Hosting, security and measurement services may process basic technical information such as IP address, browser type, device information, requested pages, referral information, approximate location, timestamps and error or security events. This information may be recorded automatically in server logs or aggregated analytics."}],["$","p","It is used to deliver pages, detect abuse, diagnose failures, understand broad usage and improve navigation. Retention depends on operational and legal needs and on the settings of the service provider involved.",{"children":"It is used to deliver pages, detect abuse, diagnose failures, understand broad usage and improve navigation. Retention depends on operational and legal needs and on the settings of the service provider involved."}]],"$undefined"]}],"$L14","$L15","$L16","$L17","$L18"]]}],"$L19","$L1a"]}],"$L1b"]}]
13:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"eyebrow","children":"Continue exploring"}],["$","h2",null,{"children":"Related pages"}]]}],["$","div",null,{"className":"related-grid","children":[["$","$L2","terms",{"href":"/terms","children":[["$","span",null,{"children":"Terms of use"}],["$","h3",null,{"children":"Terms for using AspireCompass"}],["$","$L3",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L2","disclaimer",{"href":"/disclaimer","children":[["$","span",null,{"children":"Information disclaimer"}],["$","h3",null,{"children":"Important limits of AspireCompass information"}],["$","$L3",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L2","editorial-policy",{"href":"/editorial-policy","children":[["$","span",null,{"children":"Editorial standards"}],["$","h3",null,{"children":"How AspireCompass researches, writes and corrects information"}],["$","$L3",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L2","contact",{"href":"/contact","children":[["$","span",null,{"children":"Contact"}],["$","h3",null,{"children":"Help us keep opportunity information useful"}],["$","$L3",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
14:["$","section","Google advertising and cookies",{"id":"section-4","children":[["$","h2",null,{"children":"Google advertising and cookies"}],[["$","p","AspireCompass may use Google AdSense to display advertising. When Google advertising is active, Google and its partners may use cookies or similar identifiers to serve, personalise and measure ads, limit repeated ads, detect fraud and produce reporting. Depending on your region and consent choices, ads may be personalised or non-personalised.",{"children":"AspireCompass may use Google AdSense to display advertising. When Google advertising is active, Google and its partners may use cookies or similar identifiers to serve, personalise and measure ads, limit repeated ads, detect fraud and produce reporting. Depending on your region and consent choices, ads may be personalised or non-personalised."}],["$","p","Third-party vendors, including Google, may place or read cookies in a visitor's browser or use web beacons and similar technologies to collect information as a result of ad serving. Google advertising cookies can support ads based on previous visits to this or other websites. Users can manage personalised advertising through Google Ads Settings, and may learn about additional industry opt-out choices through AboutAds where available.",{"children":"Third-party vendors, including Google, may place or read cookies in a visitor's browser or use web beacons and similar technologies to collect information as a result of ad serving. Google advertising cookies can support ads based on previous visits to this or other websites. Users can manage personalised advertising through Google Ads Settings, and may learn about additional industry opt-out choices through AboutAds where available."}]],"$undefined"]}]
15:["$","section","Consent for visitors in the EEA, United Kingdom and Switzerland",{"id":"section-5","children":[["$","h2",null,{"children":"Consent for visitors in the EEA, United Kingdom and Switzerland"}],[["$","p","Where required, AspireCompass uses a Google-certified consent management platform to request and record choices before relevant advertising cookies or personal-data processing are enabled. The consent message may offer options to consent, decline or manage purposes and vendors.",{"children":"Where required, AspireCompass uses a Google-certified consent management platform to request and record choices before relevant advertising cookies or personal-data processing are enabled. The consent message may offer options to consent, decline or manage purposes and vendors."}],["$","p","You can revisit the consent control when available on the site. Withdrawing consent does not affect processing that occurred lawfully before withdrawal, and some strictly necessary storage may remain in use to provide security or remember privacy choices.",{"children":"You can revisit the consent control when available on the site. Withdrawing consent does not affect processing that occurred lawfully before withdrawal, and some strictly necessary storage may remain in use to provide security or remember privacy choices."}]],"$undefined"]}]
16:["$","section","External websites and application portals",{"id":"section-6","children":[["$","h2",null,{"children":"External websites and application portals"}],[["$","p","AspireCompass links to programme owners and other external websites. Those organisations control their own forms, cookies, accounts and privacy practices. Read their policies before submitting personal or academic records; this policy does not govern their processing.",{"children":"AspireCompass links to programme owners and other external websites. Those organisations control their own forms, cookies, accounts and privacy practices. Read their policies before submitting personal or academic records; this policy does not govern their processing."}]],"$undefined"]}]
17:["$","section","Sharing, retention and security",{"id":"section-7","children":[["$","h2",null,{"children":"Sharing, retention and security"}],[["$","p","Information may be processed by service providers that support hosting, security, email, analytics, consent or advertising, subject to their role and terms. It may also be disclosed when reasonably necessary to comply with law, protect rights or investigate abuse. AspireCompass does not sell application documents and does not ask users to upload them.",{"children":"Information may be processed by service providers that support hosting, security, email, analytics, consent or advertising, subject to their role and terms. It may also be disclosed when reasonably necessary to comply with law, protect rights or investigate abuse. AspireCompass does not sell application documents and does not ask users to upload them."}],["$","p","Reasonable technical and organisational safeguards are used, but no internet transmission or storage system is guaranteed completely secure. Contact correspondence is retained only as long as reasonably needed for its purpose, record keeping, security or legal obligations.",{"children":"Reasonable technical and organisational safeguards are used, but no internet transmission or storage system is guaranteed completely secure. Contact correspondence is retained only as long as reasonably needed for its purpose, record keeping, security or legal obligations."}]],"$undefined"]}]
18:["$","section","Your choices and policy changes",{"id":"section-8","children":[["$","h2",null,{"children":"Your choices and policy changes"}],[["$","p","Depending on where you live, applicable law may provide rights concerning access, correction, deletion, objection or restriction. Send a focused request to the contact address above; identity may need to be verified without collecting unnecessary information.",{"children":"Depending on where you live, applicable law may provide rights concerning access, correction, deletion, objection or restriction. Send a focused request to the contact address above; identity may need to be verified without collecting unnecessary information."}],["$","p","Browser controls can block or delete cookies, though this may affect features or saved consent choices. This policy may be updated when services or legal requirements change. The latest revision date will appear at the top of this page.",{"children":"Browser controls can block or delete cookies, though this may affect features or saved consent choices. This policy may be updated when services or legal requirements change. The latest revision date will appear at the top of this page."}]],"$undefined"]}]
19:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","span",null,{"className":"eyebrow","children":"Primary-source record"}],["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":["These sources were checked by the AspireCompass Editorial Team on ","13 Sep 2026",". Reopen the current official page before applying."]}],["$","div",null,{"className":"source-grid","children":[["$","$L2","https://policies.google.com/technologies/ads",{"href":"https://policies.google.com/technologies/ads","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Google advertising privacy and policies"}],["$","span",null,{"children":"How Google uses information for advertising"}]]}],["$","$L3",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L2","https://adssettings.google.com/",{"href":"https://adssettings.google.com/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Google Ads Settings"}],["$","span",null,{"children":"Manage personalised advertising"}]]}],["$","$L3",null,{"ref":"$undefined","iconNode":"$19:props:children:3:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L2","https://www.aboutads.info/choices/",{"href":"https://www.aboutads.info/choices/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"AboutAds consumer choices"}],["$","span",null,{"children":"Industry opt-out information"}]]}],["$","$L3",null,{"ref":"$undefined","iconNode":"$19:props:children:3:props:children:0:props:children:1:props:iconN