f:["$","article",null,{"className":"article-body ","children":[false,[["$","section","A clearer way to find the right opportunity",{"id":"section-1","children":[["$","h2",null,{"children":"A clearer way to find the right opportunity"}],[["$","p","Large opportunity websites often mix expired calls, sponsored listings and general articles. AspireCompass separates discovery from verification: first identify the right category, level and destination, then check the primary source before you invest time in an application.",{"children":"Large opportunity websites often mix expired calls, sponsored listings and general articles. AspireCompass separates discovery from verification: first identify the right category, level and destination, then check the primary source before you invest time in an application."}],["$","p","Use the filters to create a shortlist. Strong fit matters more than the number of applications you send.",{"children":"Use the filters to create a shortlist. Strong fit matters more than the number of applications you send."}]],["$","ul",null,{"children":[["$","li","Filter by opportunity type, degree level, destination and funding",{"children":"Filter by opportunity type, degree level, destination and funding"}],["$","li","See deadline status before opening a listing",{"children":"See deadline status before opening a listing"}],["$","li","Follow a direct official-source link",{"children":"Follow a direct official-source link"}],["$","li","Save programme-specific requirements in your own tracker",{"children":"Save programme-specific requirements in your own tracker"}]]}]]}],["$","section","How AspireCompass verifies listings",{"id":"section-2","children":[["$","h2",null,{"children":"How AspireCompass verifies listings"}],[["$","p","We summarise eligibility, funding and timing from the programme owner whenever an official page is available. Every listing shows the source and the date it was last checked.",{"children":"We summarise eligibility, funding and timing from the programme owner whenever an official page is available. Every listing shows the source and the date it was last checked."}],["$","p","Scholarship and recruitment details can change without notice. Always read the official call, confirm the deadline in your time zone and apply through the programme owner's portal. AspireCompass does not award scholarships or charge an application fee.",{"children":"Scholarship and recruitment details can change without notice. Always read the official call, confirm the deadline in your time zone and apply through the programme owner's portal. AspireCompass does not award scholarships or charge an application fee."}]],"$undefined"]}]]]}]
