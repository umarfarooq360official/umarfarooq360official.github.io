rable Commonwealth states.","tags":["Commonwealth","Research","PhD"],"source":"https://cscuk.fcdo.gov.uk/scholarships/commonwealth-phd-scholarships-for-least-developed-countries-and-vulnerable-states/","sourceLabel":"Commonwealth Scholarship Commission","checked":"29 August 2026"},{"id":"erasmus-mundus-2027","title":"Erasmus Mundus Joint Masters 2027","provider":"European Union","type":"Scholarship","level":"Master's","country":"Multiple European countries","region":"Europe","funding":"Fully funded","deadline":"Programme-specific; most open from autumn 2026","status":"Opening soon","summary":"Joint master's degrees delivered by international university consortia, with EU-funded scholarships available to top students worldwide.","tags":["Europe","Joint degree","Mobility"],"source":"https://erasmus-plus.ec.europa.eu/opportunities/individuals/students/erasmus-mundus-joint-masters","sourceLabel":"European Commission – Erasmus+","checked":"29 August 2026","featured":true},{"id":"daad-epos-2027","title":"DAAD EPOS Scholarships 2027–2028","provider":"DAAD","type":"Scholarship","level":"Graduate","country":"Germany","region":"Europe","funding":"Fully funded","deadline":"Varies by selected postgraduate course","status":"Open","summary":"Development-related postgraduate funding for graduates from eligible countries, generally requiring at least two years of professional experience.","tags":["Germany","Development","Professional experience"],"source":"https://www2.daad.de/deutschland/stipendium/datenbank/en/21148-scholarship-database/?detail=50076777","sourceLabel":"DAAD scholarship database","checked":"29 August 2026","featured":true},{"id":"kaust-2027","title":"KAUST Graduate Admission & Fellowship 2027","provider":"King Abdullah University of Science and Technology","type":"Graduate Program","level":"Graduate","country":"Saudi Arabia","region":"Middle East","funding":"Fully funded","deadline":"Spring PhD: 27 Sep 2026; Fall: 3 Jan 2027","deadlineDate":"2026-09-27","status":"Open","summary":"Funded science and engineering graduate study with tuition support, living allowance, housing and relocation support.","tags":["STEM","MS","PhD"],"source":"https://admissions.kaust.edu.sa/how-to-apply/admission-timelines","sourceLabel":"KAUST Admissions","checked":"29 August 2026","featured":true},{"id":"mext-2027","title":"Japanese Government MEXT Scholarships","provider":"Government of Japan","type":"Scholarship","level":"Any degree","country":"Japan","region":"Asia","funding":"Fully funded","deadline":"Varies by embassy or university route","status":"Check official site","summary":"Japanese government scholarships for international students selected through embassy, university or authority recommendation routes.","tags":["Japan","Embassy route","University route"],"source":"https://www.mext.go.jp/en/policy/education/highered/title02/detail02/sdetail02/1373897.htm","sourceLabel":"MEXT official website","checked":"29 August 2026","featured":true},{"id":"fulbright-foreign-student","title":"Fulbright Foreign Student Program","provider":"U.S. Department of State","type":"Scholarship","level":"Graduate","country":"United States","region":"North America","funding":"Funded","deadline":"Varies by home country","status":"Check official site","summary":"Approximately 4,000 annual grants for foreign graduate students, young professionals and artists; local rules vary by country.","tags":["USA","Master's","Research"],"source":"https://foreign.fulbrightonline.org/apply","sourceLabel":"Foreign Fulbright Program","checked":"29 August 2026"},{"id":"stipendium-hungaricum","title":"Stipendium Hungaricum Scholarship","provider":"Government of Hungary","type":"Scholarship","level":"Any degree","country":"Hungary","region":"Europe","funding":"Fully funded","deadline":"Next cycle to be announced","status":"Check official site","summary":"Degree and non-degree scholarships offered through participating sending partners and Hungarian institutions.","tags":["Hungary","Bac