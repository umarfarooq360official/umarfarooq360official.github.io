ccepted throughout the year","status":"Rolling","summary":"Policy-focused internships for students who remain enrolled in an accredited degree programme for the internship duration.","tags":["Policy","Hybrid","Remote possible"],"source":"https://www.oecd.org/en/about/careers/internships.html","sourceLabel":"OECD Careers","checked":"29 August 2026","featured":true},{"id":"un-internships","title":"United Nations Internships","provider":"United Nations","type":"Internship","level":"Student","country":"Multiple countries","region":"Global","funding":"Varies","deadline":"Vacancy-specific","status":"Rolling","summary":"Internship openings across UN duty stations and functions for students and recent graduates; conditions vary by vacancy.","tags":["United Nations","Global","Multiple fields"],"source":"https://careers.un.org/","sourceLabel":"UN Careers","checked":"29 August 2026"},{"id":"oecd-young-associates","title":"OECD Young Associates Programme","provider":"OECD","type":"Graduate Program","level":"Graduate","country":"France","region":"Europe","funding":"Paid","deadline":"Cohort-specific","status":"Check official site","summary":"A two-year early-career programme for recent undergraduates interested in policy making, research and analysis.","tags":["Early career","Policy","Two years"],"source":"https://www.oecd.org/en/about/careers/young-associates.html","sourceLabel":"OECD Careers","checked":"29 August 2026"},{"id":"humphrey-fellowship","title":"Hubert H. Humphrey Fellowship Program","provider":"U.S. Department of State","type":"Fellowship","level":"Graduate","country":"United States","region":"North America","funding":"Funded","deadline":"Varies by U.S. embassy or Fulbright commission","status":"Check official site","summary":"A ten-month non-degree professional enrichment programme for eligible mid-career leaders with a public-service commitment.","tags":["Mid-career","Professional development","Public service"],"source":"https://www.humphreyfellowship.org/how-to-a