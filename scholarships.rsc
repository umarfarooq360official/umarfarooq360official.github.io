2e:["$","p","Record the official owner, intake, application route, funding exclusions and decision schedule for every programme. Remove an opportunity when a mandatory rule fails; time spent improving a strong-fit application is more valuable than trying to argue around an eligibility condition.",{"children":"Record the official owner, intake, application route, funding exclusions and decision schedule for every programme. Remove an opportunity when a mandatory rule fails; time spent improving a strong-fit application is more valuable than trying to argue around an eligibility condition."}]
2f:["$","section","Choose a path by degree before opening a form",{"id":"section-4","children":[["$","h2",null,{"children":"Choose a path by degree before opening a form"}],[["$","p","Undergraduate applicants may need early school nomination, as with the Pearson award. Master's candidates should decide whether the scholarship and admission are separate, as with Chevening, or handled through a course consortium, as with Erasmus Mundus. Doctoral applicants should identify research fit and any supervisor or partner-nomination requirement before drafting a proposal.",{"children":"Undergraduate applicants may need early school nomination, as with the Pearson award. Master's candidates should decide whether the scholarship and admission are separate, as with Chevening, or handled through a course consortium, as with Erasmus Mundus. Doctoral applicants should identify research fit and any supervisor or partner-nomination requirement before drafting a proposal."}],["$","p","Choose your country, qualification and realistic budget first. Use the linked country guides for local eligibility details, then open the programme owner's current call before adding an award to your shortlist.",{"children":"Choose your country, qualification and realistic budget first. Use the linked country guides for local eligibility details, then open the programme owner's current call before adding an award to your shortlist."}]],["$","ul",null,{"children":[["$","li","Bachelor's: start with school records and nomination",{"children":"Bachelor's: start with school records and nomination"}],["$","li","Master's: map scholarship and university deadlines",{"children":"Master's: map scholarship and university deadlines"}],["$","li","PhD: confirm research and supervisor process",{"children":"PhD: confirm research and supervisor process"}],["$","li","All levels: verify funding exclusions and language proof",{"children":"All levels: verify funding exclusions and language proof"}]]}]]}]
30:["$","section","Research Italy through three funding owners",{"id":"section-5","children":[["$","h2",null,{"children":"Research Italy through three funding owners"}],[["$","p","For Italy, compare the MAECI government call, the competent regional DSU authority and university-specific merit or tuition support. Each can have its own portal, documents and deadline.",{"children":"For Italy, compare the MAECI government call, the competent regional DSU authority and university-specific merit or tuition support. Each can have its own portal, documents and deadline."}],["$","p","The dedicated Italy scholarship page labels closed 2026–2027 calls clearly and links to the official source, so applicants can plan for the next cycle without copying an expired date.",{"children":"The dedicated Italy scholarship page labels closed 2026–2027 calls clearly and links to the official source, so applicants can plan for the next cycle without copying an expired date."}]],"$undefined"]}]
