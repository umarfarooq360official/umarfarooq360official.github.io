11:["$","article",null,{"className":"article-body ","children":[false,[["$","section","Start with eligibility, not prestige",{"id":"section-1","children":[["$","h2",null,{"children":"Start with eligibility, not prestige"}],[["$","p","A famous scholarship is useful only when your citizenship, degree level, field, work experience and intended course satisfy the published rules. Build a shortlist in three tiers: strong fit, possible fit and aspirational.",{"children":"A famous scholarship is useful only when your citizenship, degree level, field, work experience and intended course satisfy the published rules. Build a shortlist in three tiers: strong fit, possible fit and aspirational."}],["$","p","For every shortlisted award, record its funding scope. Fully funded can still exclude dependants, visa charges, tests or some travel costs.",{"children":"For every shortlisted award, record its funding scope. Fully funded can still exclude dependants, visa charges, tests or some travel costs."}]],["$","ul",null,{"children":[["$","li","Confirm nationality and residency rules",{"children":"Confirm nationality and residency rules"}],["$","li","Check degree and graduation-date requirements",{"children":"Check degree and graduation-date requirements"}],["$","li","Identify required work or leadership experience",{"children":"Identify required work or leadership experience"}],["$","li","Verify whether university admission is separate",{"children":"Verify whether university admission is separate"}],["$","li","Calculate costs not covered by the award",{"children":"Calculate costs not covered by the award"}]]}]]}],["$","section","How AspireCompass verifies listings",{"id":"section-2","children":[["$","h2",null,{"children":"How AspireCompass verifies listings"}],[["$","p","We summarise eligibility, funding and timing from the programme owner whenever an official page is available. Every listing shows the source and the date it was last checked.",{"children":"We summarise eligibility, funding and timing from the programme owner whenever an official page is available. Every listing shows the source and the date it was last checked."}],["$","p","Scholarship and recruitment details can change without notice. Always read the official call, confirm the deadline in your time zone and apply through the programme owner's portal. AspireCompass does not award scholarships or charge an application fee.",{"children":"Scholarship and recruitment details can change without notice. Always read the official call, confirm the deadline in your time zone and apply through the programme owner's portal. AspireCompass does not award scholarships or charge an application fee."}]],"$undefined"]}]]]}]
