18:["$","section","Privacy and result limitations",{"id":"section-3","children":[["$","h2",null,{"children":"Privacy and result limitations"}],[["$","p","The calculators run in your browser. AspireCompass does not ask for account credentials or store the grades and bands you enter in these tools. Avoid sharing passports, transcripts, bank records or login details with unofficial scholarship services.",{"children":"The calculators run in your browser. AspireCompass does not ask for account credentials or store the grades and bands you enter in these tools. Avoid sharing passports, transcripts, bank records or login details with unofficial scholarship services."}],["$","p","Universities can use institution-specific grade conversions, and courses can require minimum IELTS component scores in addition to an overall band. Always preserve the original result and follow the receiving institution's stated method.",{"children":"Universities can use institution-specific grade conversions, and courses can require minimum IELTS component scores in addition to an overall band. Always preserve the original result and follow the receiving institution's stated method."}]],"$undefined"]}]
