11:T404,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Are the AspireCompass tools free?","acceptedAnswer":{"@type":"Answer","text":"Yes. The GPA and IELTS calculators and scholarship finder are free to use and do not require an account."}},{"@type":"Question","name":"Do the tools confirm scholarship eligibility?","acceptedAnswer":{"@type":"Answer","text":"No. They support planning and shortlisting. Only the programme owner can confirm eligibility under the current official rules."}},{"@type":"Question","name":"Does AspireCompass store grades or IELTS bands entered here?","acceptedAnswer":{"@type":"Answer","text":"No. The calculator inputs are processed in your browser and are not submitted as an application or official record."}},{"@type":"Question","name":"What should I do after using a calculator?","acceptedAnswer":{"@type":"Answer","text":"Open the relevant official university or programme source, verify the current requirement and record the source and date checked."}}]}1:["$","main",null,{"id":"main-content","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Free scholarship and study planning tools\",\"item\":\"https://aspirecompass.org/tools/\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$11"}}]],["$","section",null,{"className":"inner-hero inner-hero--utility inner-hero--visual","children":["$","div",null,{"className":"site-shell inner-hero__grid","children":[["$","div",null,{"className":"inner-hero__content","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","span","/",{"children":[["$","$L3",null,{"href":"/","children":"Home"}],["$","i",nul