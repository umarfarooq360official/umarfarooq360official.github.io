18:["$","article",null,{"className":"article-body ","children":[false,[["$","section","Quick answer: how to use the scholarship finder",{"id":"section-1","children":[["$","h2",null,{"children":"Quick answer: how to use the scholarship finder"}],[["$","p","Choose your degree level and preferred destination, then narrow results by funding and application status. Open promising matches in separate tabs and compare the official nationality, academic, experience, language and nomination rules.",{"children":"Choose your degree level and preferred destination, then narrow results by funding and application status. Open promising matches in separate tabs and compare the official nationality, academic, experience, language and nomination rules."}],["$","p","The finder uses structured listing fields, not a complete assessment of your personal documents. A result means the programme is worth checking; it does not mean that the programme owner has confirmed your eligibility.",{"children":"The finder uses structured listing fields, not a complete assessment of your personal documents. A result means the programme is worth checking; it does not mean that the programme owner has confirmed your eligibility."}]],["$","ul",null,{"children":[["$","li","Filter by degree and destination",{"children":"Filter by degree and destination"}],["$","li","Prioritise open or opening-soon calls",{"children":"Prioritise open or opening-soon calls"}],["$","li","Compare full and partial funding",{"children":"Compare full and partial funding"}],["$","li","Open the official source",{"children":"Open the official source"}],["$","li","Record any failed mandatory rule",{"children":"Record any failed mandatory rule"}]]}]]}],["$","section","What the preliminary match cannot decide",{"id":"section-2","children":[["$","h2",null,{"children":"What the preliminary match cannot decide"}],[["$","p","Many scholarships apply conditions that cannot be reduced to one public filter. These can include citizenship, residence, age, graduation date, subject background, work experience, leadership evidence, a university offer, employer permission or nomination by a school or government partner.",{"children":"Many scholarships apply conditions that cannot be reduced to one public filter. These can include citizenship, residence, age, graduation date, subject background, work experience, leadership evidence, a university offer, employer permission or nomination by a school or government partner."}],["$","p","Read the newest official call and course page before preparing documents. If a rule is unclear, ask the programme owner or university in writing rather than relying on an old blog or social-media post.",{"children":"Read the newest official call and course page before preparing documents. If a rule is unclear, ask the programme owner or university in writing rather than relying on an old blog or social-media post."}]],"$undefined"]}],["$","section","Build a balanced scholarship shortlist",{"id":"section-3","children":[["$","h2",null,{"children":"Build a balanced scholarship shortlist"}],[["$","p","Create three groups: strong fit, possible fit and aspirational. A strong-fit award should satisfy every known mandatory rule. A possible fit needs one clarification. An aspirational choice can be highly competitive but should still meet the basic eligibility conditions.",{"children":"Create three groups: strong fit, possible fit and aspirational. A strong-fit award should satisfy every known mandatory rule. A possible fit needs one clarification. An aspirational choice can be highly competitive but should still meet the basic eligibility conditions."}],"$L1b"],"$undefined"]}]]]}]
19:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is the scholarship finder free?",{"children":[["$","summary",null,{"children":["Is the scholarship finder free?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. It does not require an account or payment. Applications must be submitted on the official programme or university portal."}]]}],["$","details","Does a match mean I am eligible?",{"children":[["$","summary",null,{"children":["Does a match mean I am eligible?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It is a preliminary shortlist based on structured listing fields. Verify citizenship, academics, experience, language, admission and nomination rules on the official source."}]]}],["$","details","Can I find fully funded scholarships only?",{"children":[["$","summary",null,{"children":["Can I find fully funded scholarships only?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Use the funding filter to display fully funded listings, then read what each award actually covers and which costs remain your responsibility."}]]}],["$","details","Why does a scholarship not appear?",{"children":[["$","summary",null,{"children":["Why does a scholarship not appear?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"AspireCompass adds opportunities only after an official source can be checked. A programme may also be excluded because its current cycle is unclear, closed or not yet researched."}]]}],["$","details","Can I apply for more than one opportunity?",{"children":[["$","summary",null,{"children":["Can I apply for more than one opportunity?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Usually yes, unless a programme's official rules restrict parallel applications. Keep a tracker for deadlines, references and programme-specific documents."}]]}],["$","details","Does AspireCompass accept applications?",{"children":[["$","summary",null,{"children":["Does AspireCompass accept applications?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. AspireCompass helps you discover and compare opportunities. Applications must be submitted on the official programme or institution website."}]]}]]}]]}]
