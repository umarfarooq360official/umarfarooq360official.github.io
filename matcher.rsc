11:T68c,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Is the scholarship finder free?","acceptedAnswer":{"@type":"Answer","text":"Yes. It does not require an account or payment. Applications must be submitted on the official programme or university portal."}},{"@type":"Question","name":"Does a match mean I am eligible?","acceptedAnswer":{"@type":"Answer","text":"No. It is a preliminary shortlist based on structured listing fields. Verify citizenship, academics, experience, language, admission and nomination rules on the official source."}},{"@type":"Question","name":"Can I find fully funded scholarships only?","acceptedAnswer":{"@type":"Answer","text":"Yes. Use the funding filter to display fully funded listings, then read what each award actually covers and which costs remain your responsibility."}},{"@type":"Question","name":"Why does a scholarship not appear?","acceptedAnswer":{"@type":"Answer","text":"AspireCompass adds opportunities only after an official source can be checked. A programme may also be excluded because its current cycle is unclear, closed or not yet researched."}},{"@type":"Question","name":"Can I apply for more than one opportunity?","acceptedAnswer":{"@type":"Answer","text":"Usually yes, unless a programme's official rules restrict parallel applications. Keep a tracker for deadlines, references and programme-specific documents."}},{"@type":"Question","name":"Does AspireCompass accept applications?","acceptedAnswer":{"@type":"Answer","text":"No. AspireCompass helps you discover and compare opportunities. Applications must be submitted on the official programme or institution website."}}]}1:["$","main",null,{"id":"main-content","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.o