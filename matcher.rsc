N Careers","checked":"13 September 2026","featured":true},{"id":"cern-origin","title":"CERN Origin Programme for University Graduates","provider":"CERN","type":"Graduate Program","level":"Graduate","country":"Switzerland","region":"Europe","funding":"Paid","deadline":"Position-specific","status":"Rolling","summary":"Entry-level scientific, technical and administrative roles for recent graduates. Current nationality ceilings apply to some countries, including Pakistan.","tags":["Early graduate","STEM","Administration"],"source":"https://careers.cern/programmes/entry-level-university-graduates/","sourceLabel":"CERN Careers","checked":"13 September 2026","featured":true}]}],false,false,false,false,false,false,"$L12",null,"$L13"]}],"$L14"]}],"$L15"]}]
