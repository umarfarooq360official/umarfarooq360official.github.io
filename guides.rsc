1a:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Which AspireCompass guide should I read first?",{"children":[["$","summary",null,{"children":["Which AspireCompass guide should I read first?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Start with the complete scholarship application guide unless you have already verified eligibility and process. Then choose the document-specific guide that matches your next task."}]]}],["$","details","Are the guides written for one country?",{"children":[["$","summary",null,{"children":["Are the guides written for one country?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Most principles are global, but programme and country rules vary. Destination pages and official sources provide context that a general guide cannot replace."}]]}],["$","details","Do the guides guarantee a scholarship?",{"children":[["$","summary",null,{"children":["Do the guides guarantee a scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. They help you make a clearer, safer application. Selection belongs entirely to the programme owner and depends on eligibility, competition and its published criteria."}]]}],["$","details","Can I use AI to write my application?",{"children":[["$","summary",null,{"children":["Can I use AI to write my application?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Check the programme's policy. Where assistance is permitted, protect private data, verify every fact and ensure the final work is genuinely yours. Never fabricate evidence or conceal prohibited assistance."}]]}],["$","details","Does AspireCompass submit applications for students?",{"children":[["$","summary",null,{"children":["Does AspireCompass submit applications for students?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. AspireCompass is an independent research and guidance website. Apply only through the programme, university, government or employer portal linked as the official source."}]]}],["$","details","Can a deadline or eligibility rule change after this page is updated?",{"children":[["$","summary",null,{"children":["Can a deadline or eligibility rule change after this page is updated?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Programme owners can revise dates, benefits and rules. Reopen the official call before you act, check the intake year and save a copy of the instructions used for your application."}]]}]]}]]}]
