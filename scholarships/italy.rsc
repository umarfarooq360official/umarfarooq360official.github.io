20:["$","section","University merit scholarships and fee waivers",{"id":"section-4","children":[["$","h2",null,{"children":"University merit scholarships and fee waivers"}],[["$","p","The University of Padua's 2026–2027 International Excellence award advertised €8,000 gross per academic year plus a tuition-fee exemption for selected English-taught bachelor's and master's students, with the regional fee and revenue stamp still payable. The award was normally considered through the degree application when the published conditions were met.",{"children":"The University of Padua's 2026–2027 International Excellence award advertised €8,000 gross per academic year plus a tuition-fee exemption for selected English-taught bachelor's and master's students, with the regional fee and revenue stamp still payable. The award was normally considered through the degree application when the published conditions were met."}],["$","p","Politecnico di Milano's 2026–2027 international merit route offered full tuition waivers and, for some awards, a gross allowance up to €10,000 a year. Its published conditions tied eligibility to the early admission period and a separate scholarship form. These facts explain the route; a later intake needs its own call.",{"children":"Politecnico di Milano's 2026–2027 international merit route offered full tuition waivers and, for some awards, a gross allowance up to €10,000 a year. Its published conditions tied eligibility to the early admission period and a separate scholarship form. These facts explain the route; a later intake needs its own call."}]],"$undefined"]}]
21:["$","section","Compare funding using the same fields",{"id":"section-5","children":[["$","h2",null,{"children":"Compare funding using the same fields"}],[["$","p","Write down tuition coverage, mandatory charges, cash stipend, accommodation, meals, travel, insurance, duration, payment schedule and renewal conditions. A fee waiver and a living-cost scholarship solve different parts of the budget.",{"children":"Write down tuition coverage, mandatory charges, cash stipend, accommodation, meals, travel, insurance, duration, payment schedule and renewal conditions. A fee waiver and a living-cost scholarship solve different parts of the budget."}],["$","p","Calculate how much cash you need before arrival and before the first payment. Housing deposits, visa-related costs and initial travel can be due earlier than scholarship disbursement.",{"children":"Calculate how much cash you need before arrival and before the first payment. Housing deposits, visa-related costs and initial travel can be due earlier than scholarship disbursement."}]],["$","ul",null,{"children":[["$","li","Academic year and current status",{"children":"Academic year and current status"}],["$","li","Eligible nationality and degree level",{"children":"Eligible nationality and degree level"}],["$","li","Separate admission required",{"children":"Separate admission required"}],["$","li","Income or merit assessment",{"children":"Income or merit assessment"}],["$","li","Covered and excluded costs",{"children":"Covered and excluded costs"}],["$","li","Renewal and credit requirements",{"children":"Renewal and credit requirements"}]]}]]}]
22:["$","section","Build a safe application sequence",{"id":"section-6","children":[["$","h2",null,{"children":"Build a safe application sequence"}],[["$","p","Open the official call, confirm eligibility and save the dated document. Apply through the named government, regional or university portal. Record every dependent action, including admission, financial documentation, language evidence and pre-enrolment.",{"children":"Open the official call, confirm eligibility and save the dated document. Apply through the named government, regional or university portal. Record every dependent action, including admission, financial documentation, language evidence and pre-enrolment."}],["$","p","Avoid anyone promising a guaranteed DSU, MAECI or university award. Never send passwords or pay a private account to secure selection. Use the contacts published on the official domain when a rule is unclear.",{"children":"Avoid anyone promising a guaranteed DSU, MAECI or university award. Never send passwords or pay a private account to secure selection. Use the contacts published on the official domain when a rule is unclear."}]],"$undefined"]}]
