1e:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is the Italy DSU scholarship fully funded?",{"children":[["$","summary",null,{"children":["Is the Italy DSU scholarship fully funded?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Benefits can include money and services such as accommodation or meals, but the package and amount depend on the regional call, student status and assessment. Read the exact current call before using the label fully funded."}]]}],["$","details","Can I apply for MAECI and a university scholarship together?",{"children":[["$","summary",null,{"children":["Can I apply for MAECI and a university scholarship together?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Check both calls for incompatibility rules. Some awards cannot be combined, and admission may remain a separate requirement."}]]}],["$","details","Does admission automatically apply me for every university scholarship?",{"children":[["$","summary",null,{"children":["Does admission automatically apply me for every university scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Some merit awards use automatic consideration, while others require a separate form or financial documents. Follow the named award's procedure."}]]}],["$","details","Can Pakistani students apply for scholarships in Italy?",{"children":[["$","summary",null,{"children":["Can Pakistani students apply for scholarships in Italy?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"They can apply to routes whose current nationality, degree, academic, financial and language conditions they meet. Confirm Pakistan on any eligible-country list and read the current call."}]]}]]}]]}]
