12:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","div",null,{"className":"article-note","children":[["$","$L3",null,{"ref":"$undefined","iconNode":[["path",{"d":"M10.5 22H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.706.706l3.588 3.588A2.4 2.4 0 0 1 20 8v6","key":"g5mvt7"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"m14 20 2 2 4-4","key":"15kota"}]],"className":"lucide-file-check-corner","aria-hidden":"true"}],["$","div",null,{"children":[["$","strong",null,{"children":"Use this guide with the official instructions."}],["$","p",null,{"children":"Programme prompts, limits and document rules always take priority over general advice."}]]}]]}],[["$","section","Start with the current eligible-course list",{"id":"section-1","children":[["$","h2",null,{"children":"Start with the current eligible-course list"}],[["$","p","EPOS is not one general degree application. DAAD publishes or links a current list of eligible development-related postgraduate courses, and each course has its own subject profile, intake and deadline.",{"children":"EPOS is not one general degree application. DAAD publishes or links a current list of eligible development-related postgraduate courses, and each course has its own subject profile, intake and deadline."}],["$","p","Choose a course that fits your prior degree, professional responsibilities and development direction. Applying to an unrelated course simply because it is funded weakens both eligibility and motivation.",{"children":"Choose a course that fits your prior degree, professional responsibilities and development direction. Applying to an unrelated course simply because it is funded weakens both eligibility and motivation."}]],"$undefined"]}],["$","section","Check country and experience requirements",{"id":"section-2","children":[["$","h2",null,{"children":"Check country and experience requirements"}],[["$","p","The programme is intended for applicants from eligible developing and newly industrialised countries. DAAD normally expects at least two years of relevant professional experience, along with an appropriate academic degree and motivation connected to development practice. Use the current database and course instructions for precise rules.",{"children":"The programme is intended for applicants from eligible developing and newly industrialised countries. DAAD normally expects at least two years of relevant professional experience, along with an appropriate academic degree and motivation connected to development practice. Use the current database and course instructions for precise rules."}]],"$undefined"]}],["$","section","Deadlines are course-specific",{"id":"section-3","children":[["$","h2",null,{"children":"Deadlines are course-specific"}],[["$","p","The 2027–2028 calendar differs across eligible postgraduate courses. Record the deadline stated for your course, the time zone and the receiving institution. An old DAAD table or a date from another course is not a valid substitute.",{"children":"The 2027–2028 calendar differs across eligible postgraduate courses. Record the deadline stated for your course, the time zone and the receiving institution. An old DAAD table or a date from another course is not a valid substitute."}]],"$undefined"]}],["$","section","Where the application is submitted",{"id":"section-4","children":[["$","h2",null,{"children":"Where the application is submitted"}],[["$","p","Candidates generally apply to the selected postgraduate course according to its instructions rather than sending one universal application directly to DAAD. Some candidates apply to more than one eligible course, but ordering, form and document rules must follow the current EPOS guidance.",{"children":"Candidates generally apply to the selected postgraduate course according to its instructions rather than sending one universal application directly to DAAD. Some candidates apply to more than one eligible course, but ordering, form and document rules must follow the current EPOS guidance."}]],"$undefined"]}],"$L15","$L16","$L17"]]}],"$L18","$L19"]}],"$L1a"]}]
13:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"eyebrow","children":"Continue exploring"}],["$","h2",null,{"children":"Related pages"}]]}],["$","div",null,{"className":"related-grid","children":[["$","$L2","countries/germany",{"href":"/countries/germany","children":[["$","span",null,{"children":"Destination guide"}],["$","h3",null,{"children":"Scholarships in Germany for international students"}],["$","$L3",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L2","scholarships/masters",{"href":"/scholarships/masters","children":[["$","span",null,{"children":"Postgraduate funding"}],["$","h3",null,{"children":"Master's scholarships for international students"}],["$","$L3",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L2","guides/motivation-letter",{"href":"/guides/motivation-letter","children":[["$","span",null,{"children":"Writing guide · 8 min read"}],["$","h3",null,{"children":"How to write a scholarship motivation letter"}],["$","$L3",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L2","guides/scholarships-for-pakistani-students",{"href":"/guides/scholarships-for-pakistani-students","children":[["$","span",null,{"children":"Pakistan applicant guide · 12 min read"}],["$","h3",null,{"children":"Fully funded scholarships for Pakistani students in 2027"}],["$","$L3",null,{"ref":"$undefined","iconNode":"$d:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
15:["$","section","Funding and costs to verify",{"id":"section-5","children":[["$","h2",null,{"children":"Funding and costs to verify"}],[["$","p","The official programme describes scholarship payments and applicable support such as insurance, travel or study-related assistance under its terms. Duration depends on the selected course. Verify pre-arrival costs, housing deposits, visa evidence and any amount not covered before accepting.",{"children":"The official programme describes scholarship payments and applicable support such as insurance, travel or study-related assistance under its terms. Duration depends on the selected course. Verify pre-arrival costs, housing deposits, visa evidence and any amount not covered before accepting."}]],"$undefined"]}]
16:["$","section","Connect professional experience to development impact",{"id":"section-6","children":[["$","h2",null,{"children":"Connect professional experience to development impact"}],[["$","p","Describe the problem you worked on, the responsibility you personally held, the result and the capability still missing. Then explain how the selected German course addresses that gap and how you can apply the learning in a realistic institutional or sector role.",{"children":"Describe the problem you worked on, the responsibility you personally held, the result and the capability still missing. Then explain how the selected German course addresses that gap and how you can apply the learning in a realistic institutional or sector role."}],["$","p","An employment certificate proves dates and duties, while the motivation letter explains judgement and impact. Make sure the two documents agree without duplicating each other line by line.",{"children":"An employment certificate proves dates and duties, while the motivation letter explains judgement and impact. Make sure the two documents agree without duplicating each other line by line."}]],"$undefined"]}]
17:["$","section","DAAD EPOS application checklist",{"id":"section-7","children":[["$","h2",null,{"children":"DAAD EPOS application checklist"}],[["$","p","Build the final checklist from the current course and DAAD instructions. Requirements may include a DAAD form, CV, motivation, academic records, employment evidence, language proof and references.",{"children":"Build the final checklist from the current course and DAAD instructions. Requirements may include a DAAD form, CV, motivation, academic records, employment evidence, language proof and references."}]],["$","ul",null,{"children":[["$","li","Eligible country confirmed",{"children":"Eligible country confirmed"}],["$","li","Relevant degree and course prerequisites met",{"children":"Relevant degree and course prerequisites met"}],["$","li","Required professional experience documented",{"children":"Required professional experience documented"}],["$","li","Correct 2027–2028 course deadline recorded",{"children":"Correct 2027–2028 course deadline recorded"}],["$","li","Application sent to the stated recipient",{"children":"Application sent to the stated recipient"}],["$","li","Documents use the requested format",{"children":"Documents use the requested format"}],["$","li","Development plan is specific and credible",{"children":"Development plan is specific and credible"}]]}]]}]
