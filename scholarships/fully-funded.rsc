26:["$","article",null,{"className":"article-body ","children":[false,[["$","section","What fully funded should mean",{"id":"section-1","children":[["$","h2",null,{"children":"What fully funded should mean"}],[["$","p","The phrase normally indicates full tuition plus a living allowance, but benefits differ. Some awards add airfare, visa costs, health insurance, books or research support; others do not.",{"children":"The phrase normally indicates full tuition plus a living allowance, but benefits differ. Some awards add airfare, visa costs, health insurance, books or research support; others do not."}],["$","p","Read the current award conditions and estimate a realistic monthly budget for the destination before accepting an offer.",{"children":"Read the current award conditions and estimate a realistic monthly budget for the destination before accepting an offer."}]],["$","ul",null,{"children":[["$","li","Tuition and mandatory university fees",{"children":"Tuition and mandatory university fees"}],["$","li","Living or maintenance stipend",{"children":"Living or maintenance stipend"}],["$","li","Travel and relocation support",{"children":"Travel and relocation support"}],["$","li","Health insurance",{"children":"Health insurance"}],["$","li","Research, thesis or study allowance",{"children":"Research, thesis or study allowance"}]]}]]}],["$","section","How AspireCompass verifies listings",{"id":"section-2","children":[["$","h2",null,{"children":"How AspireCompass verifies listings"}],[["$","p","We summarise eligibility, funding and timing from the programme owner whenever an official page is available. Every listing shows the source and the date it was last checked.",{"children":"We summarise eligibility, funding and timing from the programme owner whenever an official page is available. Every listing shows the source and the date it was last checked."}],["$","p","Scholarship and recruitment details can change without notice. Always read the official call, confirm the deadline in your time zone and apply through the programme owner's portal. AspireCompass does not award scholarships or charge an application fee.",{"children":"Scholarship and recruitment details can change without notice. Always read the official call, confirm the deadline in your time zone and apply through the programme owner's portal. AspireCompass does not award scholarships or charge an application fee."}]],"$undefined"]}],["$","section","Compare coverage with a personal budget",{"id":"section-3","children":[["$","h2",null,{"children":"Compare coverage with a personal budget"}],[["$","p","For each award, copy the current benefit list into a budget and add every likely cost before the first payment. Mark tuition, stipend, travel, insurance, visa, tests, deposits, dependants and research support as covered, capped, conditional or self-funded.",{"children":"For each award, copy the current benefit list into a budget and add every likely cost before the first payment. Mark tuition, stipend, travel, insurance, visa, tests, deposits, dependants and research support as covered, capped, conditional or self-funded."}]],"$undefined"]}],["$","section","Find the right award for your degree level",{"id":"section-4","children":[["$","h2",null,{"children":"Find the right award for your degree level"}],[["$","p","For bachelor's applicants, the University of Toronto Pearson award requires high-school nomination before its separate university and scholarship submissions. At master's level, Chevening, Erasmus Mundus and eligible DAAD EPOS courses use different course-selection and application systems. At doctoral level, Commonwealth and research-based university funding have their own nomination or supervisor requirements.",{"children":"For bachelor's applicants, the University of Toronto Pearson award requires high-school nomination before its separate university and scholarship submissions. At master's level, Chevening, Erasmus Mundus and eligible DAAD EPOS courses use different course-selection and application systems. At doctoral level, Commonwealth and research-based university funding have their own nomination or supervisor requirements."}],"$L29"],"$L2a"]}],"$L2b"]]}]
27:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can I apply for more than one opportunity?",{"children":[["$","summary",null,{"children":["Can I apply for more than one opportunity?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Usually yes, unless a programme's official rules restrict parallel applications. Keep a tracker for deadlines, references and programme-specific documents."}]]}],["$","details","Does AspireCompass accept applications?",{"children":[["$","summary",null,{"children":["Does AspireCompass accept applications?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. AspireCompass helps you discover and compare opportunities. Applications must be submitted on the official programme or institution website."}]]}],["$","details","Does AspireCompass submit applications for students?",{"children":[["$","summary",null,{"children":["Does AspireCompass submit applications for students?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. AspireCompass is an independent research and guidance website. Apply only through the programme, university, government or employer portal linked as the official source."}]]}],["$","details","Can a deadline or eligibility rule change after this page is updated?",{"children":[["$","summary",null,{"children":["Can a deadline or eligibility rule change after this page is updated?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Programme owners can revise dates, benefits and rules. Reopen the official call before you act, check the intake year and save a copy of the instructions used for your application."}]]}]]}]]}]
