24:["$","article",null,{"className":"article-body ","children":[false,[["$","section","What fully funded should mean",{"id":"section-1","children":[["$","h2",null,{"children":"What fully funded should mean"}],[["$","p","The phrase normally indicates full tuition plus a living allowance, but benefits differ. Some awards add airfare, visa costs, health insurance, books or research support; others do not.",{"children":"The phrase normally indicates full tuition plus a living allowance, but benefits differ. Some awards add airfare, visa costs, health insurance, books or research support; others do not."}],["$","p","Read the current award conditions and estimate a realistic monthly budget for the destination before accepting an offer.",{"children":"Read the current award conditions and estimate a realistic monthly budget for the destination before accepting an offer."}]],["$","ul",null,{"children":[["$","li","Tuition and mandatory university fees",{"children":"Tuition and mandatory university fees"}],["$","li","Living or maintenance stipend",{"children":"Living or maintenance stipend"}],["$","li","Travel and relocation support",{"children":"Travel and relocation support"}],["$","li","Health insurance",{"children":"Health insurance"}],["$","li","Research, thesis or study allowance",{"children":"Research, thesis or study allowance"}]]}]]}],["$","section","How AspireCompass verifies listings",{"id":"section-2","children":[["$","h2",null,{"children":"How AspireCompass verifies listings"}],[["$","p","We summarise eligibility, funding and timing from the programme owner whenever an official page is available. Every listing shows the source and the date it was last checked.",{"children":"We summarise eligibility, funding and timing from the programme owner whenever an official page is available. Every listing shows the source and the date it was last checked."}],["$","p","Scholarship and recruitment details can change without notice. Always read the official call, confirm the deadline in your time zone and apply through the programme owner's portal. AspireCompass does not award scholarships or charge an application fee.",{"children":"Scholarship and recruitment details can change without notice. Always read the official call, confirm the deadline in your time zone and apply through the programme owner's portal. AspireCompass does not award scholarships or charge an application fee."}]],"$undefined"]}],["$","section","Compare coverage with a personal budget",{"id":"section-3","children":[["$","h2",null,{"children":"Compare coverage with a personal budget"}],[["$","p","For each award, copy the current benefit list into a budget and add every likely cost before the first payment. Mark tuition, stipend, travel, insurance, visa, tests, deposits, dependants and research support as covered, capped, conditional or self-funded.",{"children":"For each award, copy the current benefit list into a budget and add every likely cost before the first payment. Mark tuition, stipend, travel, insurance, visa, tests, deposits, dependants and research support as covered, capped, conditional or self-funded."}]],"$undefined"]}],["$","section","Find the right award for your degree level",{"id":"section-4","children":[["$","h2",null,{"children":"Find the right award for your degree level"}],[["$","p","For bachelor's applicants, the University of Toronto Pearson award requires high-school nomination before its separate university and scholarship submissions. At master's level, Chevening, Erasmus Mundus and eligible DAAD EPOS courses use different course-selection and application systems. At doctoral level, Commonwealth and research-based university funding have their own nomination or supervisor requirements.",{"children":"For bachelor's applicants, the University of Toronto Pearson award requires high-school nomination before its separate university and scholarship submissions. At master's level, Chevening, Erasmus Mundus and eligible DAAD EPOS courses use different course-selection and application systems. At doctoral level, Commonwealth and research-based university funding have their own nomination or supervisor requirements."}],"$L27"],"$L28"]}],"$L29","$L2a"]]}]
25:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Does fully funded always mean I will pay nothing?",{"children":[["$","summary",null,{"children":["Does fully funded always mean I will pay nothing?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. An award can cover tuition and a stipend while excluding dependants, deposits, tests, visa costs or part of travel. Build a personal budget from the current official benefit list."}]]}],["$","details","How should I compare two fully funded scholarships?",{"children":[["$","summary",null,{"children":["How should I compare two fully funded scholarships?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Compare eligibility, degree fit, tuition, stipend, housing, insurance, travel, renewal conditions and costs that remain yours. Also compare the application route and decision timeline."}]]}],["$","details","Can the scholarship and university have separate applications?",{"children":[["$","summary",null,{"children":["Can the scholarship and university have separate applications?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Some awards have a separate scholarship portal or nomination stage, while others are tied directly to university admission. Follow the exact sequence stated by the programme owner."}]]}]]}]]}]
