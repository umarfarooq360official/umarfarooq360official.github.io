1:["$","main",null,{"id":"main-content","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Scholarships for international students in 2026–2027\",\"item\":\"https://aspirecompass.org/scholarships/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Fully funded scholarships for international students\",\"item\":\"https://aspirecompass.org/scholarships/fully-funded/\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Does fully funded always mean I will pay nothing?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. An award can cover tuition and a stipend while excluding dependants, deposits, tests, visa costs or part of travel. Build a personal budget from the current official benefit list.\"}},{\"@type\":\"Question\",\"name\":\"How should I compare two fully funded scholarships?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Compare eligibility, degree fit, tuition, stipend, housing, insurance, travel, renewal conditions and costs that remain yours. Also compare the application route and decision timeline.\"}},{\"@type\":\"Question\",\"name\":\"Can the scholarship and university have separate applications?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Some awards have a separate scholarship portal or nomination stage, while others are tied directly to university admission. Follow the exact sequence stated by the programme owner.\"}}]}"}}]],["$","section",null,{"className":"inner-hero inner-hero--listing","children":["$","div",null,{"className":"site-shell inner-hero__grid","children":[["$","div",null,{"classNam