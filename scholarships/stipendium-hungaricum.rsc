16:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","div",null,{"className":"article-note","children":[["$","$L4",null,{"ref":"$undefined","iconNode":[["path",{"d":"M10.5 22H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.706.706l3.588 3.588A2.4 2.4 0 0 1 20 8v6","key":"g5mvt7"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"m14 20 2 2 4-4","key":"15kota"}]],"className":"lucide-file-check-corner","aria-hidden":"true"}],["$","div",null,{"children":[["$","strong",null,{"children":"Use this guide with the official instructions."}],["$","p",null,{"children":"Programme prompts, limits and document rules always take priority over general advice."}]]}]]}],[["$","section","Check the correct intake and call",{"id":"section-1","children":[["$","h2",null,{"children":"Check the correct intake and call"}],[["$","p","The official apply page available at this review still describes the 2026/27 application timeline, including a January 2026 deadline. That date belongs to a past cycle and must not be used as the next application deadline. Monitor the official call and your country's sending partner for the next confirmed intake.",{"children":"The official apply page available at this review still describes the 2026/27 application timeline, including a January 2026 deadline. That date belongs to a past cycle and must not be used as the next application deadline. Monitor the official call and your country's sending partner for the next confirmed intake."}],["$","p","Before preparing essays or paying for documents, check degree level, nationality, age if relevant, eligible study fields and language rules in the current call. Save the official application guide that applies to your intake.",{"children":"Before preparing essays or paying for documents, check degree level, nationality, age if relevant, eligible study fields and language rules in the current call. Save the official application guide that applies to your intake."}]],"$undefined"]}],["$","section","Step 1: check your sending partner",{"id":"section-2","children":[["$","h2",null,{"children":"Step 1: check your sending partner"}],[["$","p","Partner agreements determine which countries and fields are eligible. The sending partner may be a ministry, scholarship council, embassy or another appointed authority. Find the partner for your citizenship on the programme's official list and read its local nomination notice.",{"children":"Partner agreements determine which countries and fields are eligible. The sending partner may be a ministry, scholarship council, embassy or another appointed authority. Find the partner for your citizenship on the programme's official list and read its local nomination notice."}],["$","p","A partner can ask for a separate local form, documents or test and can close before the Hungarian portal. Keep both deadlines in your own calendar. Pakistani applicants should verify the current HEC notice as well as the Hungarian call; requirements can change by intake.",{"children":"A partner can ask for a separate local form, documents or test and can close before the Hungarian portal. Keep both deadlines in your own calendar. Pakistani applicants should verify the current HEC notice as well as the Hungarian call; requirements can change by intake."}]],["$","ul",null,{"children":[["$","li","Country and eligible study areas",{"children":"Country and eligible study areas"}],["$","li","Local nomination form and tests",{"children":"Local nomination form and tests"}],"$L19","$L1a","$L1b"]}]]}],"$L1c","$L1d","$L1e","$L1f"]]}],"$L20","$L21"]}],"$L22"]}]
