21:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","What is the next Stipendium Hungaricum deadline?",{"children":[["$","summary",null,{"children":["What is the next Stipendium Hungaricum deadline?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"At this review the official apply page shows a previous 2026/27 timeline. Wait for the new call and check both its deadline and your sending partner's local deadline."}]]}],["$","details","Can I apply without sending-partner nomination?",{"children":[["$","summary",null,{"children":["Can I apply without sending-partner nomination?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The programme uses sending-partner nomination as part of its application process. Check the exact partner and call rules for your country before applying."}]]}],["$","details","Is it fully funded for living costs?",{"children":[["$","summary",null,{"children":["Is it fully funded for living costs?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Tuition and several forms of support are provided, but the official programme states the allowances do not necessarily cover all living expenses."}]]}]]}]]}]
