1d:["$","article",null,{"className":"article-body ","children":[false,[["$","section","Build a strong undergraduate funding plan",{"id":"section-1","children":[["$","h2",null,{"children":"Build a strong undergraduate funding plan"}],[["$","p","Unlike many postgraduate awards, undergraduate scholarships may be automatically considered with admission or require a separate institutional form. Government programmes can also require nomination by an embassy or national sending partner.",{"children":"Unlike many postgraduate awards, undergraduate scholarships may be automatically considered with admission or require a separate institutional form. Government programmes can also require nomination by an embassy or national sending partner."}]],["$","ul",null,{"children":[["$","li","Prepare certified school transcripts",{"children":"Prepare certified school transcripts"}],["$","li","Check subject prerequisites",{"children":"Check subject prerequisites"}],["$","li","Plan language or standardised tests",{"children":"Plan language or standardised tests"}],["$","li","Compare automatic and separate scholarship applications",{"children":"Compare automatic and separate scholarship applications"}],["$","li","Keep a family financial evidence folder if need-based aid is offered",{"children":"Keep a family financial evidence folder if need-based aid is offered"}]]}]]}],["$","section","How AspireCompass verifies listings",{"id":"section-2","children":[["$","h2",null,{"children":"How AspireCompass verifies listings"}],[["$","p","We summarise eligibility, funding and timing from the programme owner whenever an official page is available. Every listing shows the source and the date it was last checked.",{"children":"We summarise eligibility, funding and timing from the programme owner whenever an official page is available. Every listing shows the source and the date it was last checked."}],["$","p","Scholarship and recruitment details can change without notice. Always read the official call, confirm the deadline in your time zone and apply through the programme owner's portal. AspireCompass does not award scholarships or charge an application fee.",{"children":"Scholarship and recruitment details can change without notice. Always read the official call, confirm the deadline in your time zone and apply through the programme owner's portal. AspireCompass does not award scholarships or charge an application fee."}]],"$undefined"]}],["$","section","Plan admission and funding as one timeline",{"id":"section-3","children":[["$","h2",null,{"children":"Plan admission and funding as one timeline"}],[["$","p","Undergraduate applicants may need school nomination, predicted grades, standardised tests or financial-aid forms before the normal admission deadline. Create a calendar that includes each dependency and ask the school counsellor early about documents that cannot be produced instantly.",{"children":"Undergraduate applicants may need school nomination, predicted grades, standardised tests or financial-aid forms before the normal admission deadline. Create a calendar that includes each dependency and ask the school counsellor early about documents that cannot be produced instantly."}],["$","p","Compare renewable funding across the full degree. A large first-year award can still leave a serious gap later if renewal depends on grades, credit load or residence conditions.",{"children":"Compare renewable funding across the full degree. A large first-year award can still leave a serious gap later if renewal depends on grades, credit load or residence conditions."}]],"$undefined"]}],"$L20"]]}]
1e:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can I apply for more than one opportunity?",{"children":[["$","summary",null,{"children":["Can I apply for more than one opportunity?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Usually yes, unless a programme's official rules restrict parallel applications. Keep a tracker for deadlines, references and programme-specific documents."}]]}],["$","details","Does AspireCompass accept applications?",{"children":[["$","summary",null,{"children":["Does AspireCompass accept applications?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. AspireCompass helps you discover and compare opportunities. Applications must be submitted on the official programme or institution website."}]]}],["$","details","Does AspireCompass submit applications for students?",{"children":[["$","summary",null,{"children":["Does AspireCompass submit applications for students?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. AspireCompass is an independent research and guidance website. Apply only through the programme, university, government or employer portal linked as the official source."}]]}],["$","details","Can a deadline or eligibility rule change after this page is updated?",{"children":[["$","summary",null,{"children":["Can a deadline or eligibility rule change after this page is updated?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Programme owners can revise dates, benefits and rules. Reopen the official call before you act, check the intake year and save a copy of the instructions used for your application."}]]}]]}]]}]
