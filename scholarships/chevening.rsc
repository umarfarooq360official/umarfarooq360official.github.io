17:["$","p",null,{"children":"Programme prompts, limits and document rules always take priority over general advice."}]
18:["$","section","Current 2027–2028 application status",{"id":"section-1","children":[["$","h2",null,{"children":"Current 2027–2028 application status"}],[["$","p","The official timeline states that applications opened on 4 August 2026 and close on 6 October 2026 at 11:00 UTC. Convert that time carefully and submit earlier; the central deadline does not move because a candidate has a connection or upload problem.",{"children":"The official timeline states that applications opened on 4 August 2026 and close on 6 October 2026 at 11:00 UTC. Convert that time carefully and submit earlier; the central deadline does not move because a candidate has a connection or upload problem."}],["$","p","Use the official application system reached from Chevening. Save your application number, final files and submission confirmation, and continue monitoring the email address used in the form.",{"children":"Use the official application system reached from Chevening. Save your application number, final files and submission confirmation, and continue monitoring the email address used in the form."}]],"$undefined","$undefined","$undefined"]}]
19:["$","section","Check eligibility before writing essays",{"id":"section-2","children":[["$","h2",null,{"children":"Check eligibility before writing essays"}],[["$","p","Read the complete current eligibility page and terms. Confirm citizenship, degree completion, work-experience rules, previous UK-government funding restrictions, return-home commitment and any other mandatory condition. AspireCompass cannot make an official eligibility decision.",{"children":"Read the complete current eligibility page and terms. Confirm citizenship, degree completion, work-experience rules, previous UK-government funding restrictions, return-home commitment and any other mandatory condition. AspireCompass cannot make an official eligibility decision."}]],"$undefined","$undefined","$undefined"]}]
1a:["$","section","Choose three eligible courses strategically",{"id":"section-3","children":[["$","h2",null,{"children":"Choose three eligible courses strategically"}],[["$","p","Course choices should form one coherent development plan rather than three unrelated attempts. Check that each course meets Chevening's current criteria, then verify the university admission deadline and application process separately.",{"children":"Course choices should form one coherent development plan rather than three unrelated attempts. Check that each course meets Chevening's current criteria, then verify the university admission deadline and application process separately."}],["$","p","Compare modules, teaching approach, practical projects, networks and the skill gap each option addresses. Your scholarship application and university applications are connected, but they are not the same submission.",{"children":"Compare modules, teaching approach, practical projects, networks and the skill gap each option addresses. Your scholarship application and university applications are connected, but they are not the same submission."}]],"$undefined","$undefined","$undefined"]}]
1b:["$","section","Build evidence for leadership and influence",{"id":"section-4","children":[["$","h2",null,{"children":"Build evidence for leadership and influence"}],[["$","p","Use specific situations in which you identified a problem, made a decision, involved other people and produced an observable result. Explain your personal contribution and reflection. A job title or organisation name does not prove leadership by itself.",{"children":"Use specific situations in which you identified a problem, made a decision, involved other people and produced an observable result. Explain your personal contribution and reflection. A job title or organisation name does not prove leadership by itself."}]],"$undefined",["$","ul",null,{"children":[["$","li","Situation and people affected",{"children":"Situation and people affected"}],["$","li","Decision or initiative you owned",{"children":"Decision or initiative you owned"}],["$","li","How you persuaded or coordinated others",{"children":"How you persuaded or coordinated others"}],["$","li","Result supported by a measure or concrete change",{"children":"Result supported by a measure or concrete change"}],["$","li","What you learned and later applied",{"children":"What you learned and later applied"}]]}],"$undefined"]}]
1c:["$","section","Make networking evidence substantive",{"id":"section-5","children":[["$","h2",null,{"children":"Make networking evidence substantive"}],[["$","p","Networking is not collecting contacts. Show how you built a professional relationship, exchanged value, maintained trust and achieved or learned something relevant. Explain how you would contribute to a Chevening cohort as well as benefit from it.",{"children":"Networking is not collecting contacts. Show how you built a professional relationship, exchanged value, maintained trust and achieved or learned something relevant. Explain how you would contribute to a Chevening cohort as well as benefit from it."}]],"$undefined","$undefined","$undefined"]}]
1d:["$","section","Connect the UK course to a realistic career plan",{"id":"section-6","children":[["$","h2",null,{"children":"Connect the UK course to a realistic career plan"}],[["$","p","Define the problem or sector you want to work on, the capability missing from your present profile and the role or sequence you can realistically pursue after study. Avoid claims that one master's degree will solve a national problem instantly.",{"children":"Define the problem or sector you want to work on, the capability missing from your present profile and the role or sequence you can realistically pursue after study. Avoid claims that one master's degree will solve a national problem instantly."}]],"$undefined","$undefined","$undefined"]}]
1e:["$","section","Final pre-submission checks",{"id":"section-7","children":[["$","h2",null,{"children":"Final pre-submission checks"}],[["$","p","Reopen the official guidance, answer every current prompt, verify employment dates and course information, and ensure that examples across the form are consistent. Do not buy essays or submit fabricated evidence. Prepare to defend every claim in an interview.",{"children":"Reopen the official guidance, answer every current prompt, verify employment dates and course information, and ensure that examples across the form are consistent. Do not buy essays or submit fabricated evidence. Prepare to defend every claim in an interview."}]],"$undefined",["$","ul",null,{"children":[["$","li","All eligibility answers are accurate",{"children":"All eligibility answers are accurate"}],["$","li","Dates match the CV and evidence",{"children":"Dates match the CV and evidence"}],["$","li","Three courses are currently eligible",{"children":"Three courses are currently eligible"}],["$","li","Each response answers its full prompt",{"children":"Each response answers its full prompt"}],["$","li","Examples show action, result and reflection",{"children":"Examples show action, result and reflection"}],["$","li","Deadline converted from UTC",{"children":"Deadline converted from UTC"}],["$","li","Submission receipt saved",{"children":"Submission receipt saved"}]]}],"$undefined"]}]
1f:["$","section","Separate the scholarship deadline from the offer deadline",{"id":"section-8","children":[["$","h2",null,{"children":"Separate the scholarship deadline from the offer deadline"}],[["$","p","Chevening's official timeline closes the scholarship application at 11:00 UTC on 6 October 2026. Applicants who later succeed at interview must submit at least one unconditional eligible UK university offer by 17:00 BST on 8 July 2027. This later requirement does not extend the October scholarship deadline.",{"children":"Chevening's official timeline closes the scholarship application at 11:00 UTC on 6 October 2026. Applicants who later succeed at interview must submit at least one unconditional eligible UK university offer by 17:00 BST on 8 July 2027. This later requirement does not extend the October scholarship deadline."}],["$","p","For each of your planned UK courses, record its own admission opening date, application deadline, English-language rule and time needed to obtain an unconditional offer. Store these beside, not instead of, the Chevening timeline.",{"children":"For each of your planned UK courses, record its own admission opening date, application deadline, English-language rule and time needed to obtain an unconditional offer. Store these beside, not instead of, the Chevening timeline."}]],"$undefined",["$","ul",null,{"children":[["$","li","Scholarship form and submission confirmation",{"children":"Scholarship form and submission confirmation"}],["$","li","Course admission for each university",{"children":"Course admission for each university"}],["$","li","Interview documents where shortlisted",{"children":"Interview documents where shortlisted"}],["$","li","Official unconditional-offer deadline",{"children":"Official unconditional-offer deadline"}]]}],"$undefined"]}]
20:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","span",null,{"className":"eyebrow","children":"Primary-source record"}],["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Official programme links used for this guide. Requirements can change; reopen the current call before applying."}],["$","div",null,{"className":"source-grid","children":[["$","$L3","https://www.chevening.org/scholarships/",{"href":"https://www.chevening.org/scholarships/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Chevening Scholarships"}],["$","span",null,{"children":"Official programme overview and application route"}]]}],["$","$L4",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L3","https://www.chevening.org/scholarships/application-timeline/",{"href":"https://www.chevening.org/scholarships/application-timeline/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"Chevening application timeline"}],["$","span",null,{"children":"Official 2027–2028 dates"}]]}],["$","$L4",null,{"ref":"$undefined","iconNode":"$20:props:children:3:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
21:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","When is the Chevening 2027–2028 deadline?",{"children":[["$","summary",null,{"children":["When is the Chevening 2027–2028 deadline?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The official timeline gives 6 October 2026 at 11:00 UTC. Check the Chevening website again before submission and convert the time zone correctly."}]]}],["$","details","Is Chevening fully funded?",{"children":[["$","summary",null,{"children":["Is Chevening fully funded?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Chevening describes a funded package for eligible study and related support, but candidates should read the current terms for exact benefits, limits and personal costs."}]]}],["$","details","Do I need a university offer before applying to Chevening?",{"children":[["$","summary",null,{"children":["Do I need a university offer before applying to Chevening?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Follow the current Chevening timeline and course guidance. Scholarship and university admission stages are separate, with later offer requirements in the process."}]]}],["$","details","Can Pakistani students apply for Chevening?",{"children":[["$","summary",null,{"children":["Can Pakistani students apply for Chevening?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes, when they meet all current eligibility and course rules. Use the official country and application guidance rather than relying on a third-party eligibility decision."}]]}],["$","details","Can I use one example in every Chevening answer?",{"children":[["$","summary",null,{"children":["Can I use one example in every Chevening answer?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"A strong application normally uses complementary evidence. Repeating one story can leave other criteria unsupported and make the profile seem narrow."}]]}],["$","details","Is the Chevening scholarship application the same as applying to a UK university?",{"children":[["$","summary",null,{"children":["Is the Chevening scholarship application the same as applying to a UK university?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Chevening and university admissions are connected but separate processes. Applicants must manage the scholarship timeline and their eligible course applications independently."}]]}],["$","details","Does Chevening itself require IELTS?",{"children":[["$","summary",null,{"children":["Does Chevening itself require IELTS?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Chevening removed its own English-language requirement, but applicants still need to meet the admission conditions of their selected UK universities."}]]}],["$","details","Why should I track the university-offer stage separately?",{"children":[["$","summary",null,{"children":["Why should I track the university-offer stage separately?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The scholarship submission deadline and the later requirement for an eligible unconditional university offer are different milestones. Missing either can affect the application."}]]}]]}]]}]
