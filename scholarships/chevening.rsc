13:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","div",null,{"className":"article-note","children":[["$","$L4",null,{"ref":"$undefined","iconNode":[["path",{"d":"M10.5 22H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.706.706l3.588 3.588A2.4 2.4 0 0 1 20 8v6","key":"g5mvt7"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"m14 20 2 2 4-4","key":"15kota"}]],"className":"lucide-file-check-corner","aria-hidden":"true"}],["$","div",null,{"children":[["$","strong",null,{"children":"Use this guide with the official instructions."}],["$","p",null,{"children":"Programme prompts, limits and document rules always take priority over general advice."}]]}]]}],[["$","section","Current 2027–2028 application status",{"id":"section-1","children":[["$","h2",null,{"children":"Current 2027–2028 application status"}],[["$","p","The official timeline states that applications opened on 4 August 2026 and close on 6 October 2026 at 11:00 UTC. Convert that time carefully and submit earlier; the central deadline does not move because a candidate has a connection or upload problem.",{"children":"The official timeline states that applications opened on 4 August 2026 and close on 6 October 2026 at 11:00 UTC. Convert that time carefully and submit earlier; the central deadline does not move because a candidate has a connection or upload problem."}],["$","p","Use the official application system reached from Chevening. Save your application number, final files and submission confirmation, and continue monitoring the email address used in the form.",{"children":"Use the official application system reached from Chevening. Save your application number, final files and submission confirmation, and continue monitoring the email address used in the form."}]],"$undefined"]}],["$","section","Check eligibility before writing essays",{"id":"section-2","children":[["$","h2",null,{"children":"Check eligibility before writing essays"}],[["$","p","Read the complete current eligibility page and terms. Confirm citizenship, degree completion, work-experience rules, previous UK-government funding restrictions, return-home commitment and any other mandatory condition. AspireCompass cannot make an official eligibility decision.",{"children":"Read the complete current eligibility page and terms. Confirm citizenship, degree completion, work-experience rules, previous UK-government funding restrictions, return-home commitment and any other mandatory condition. AspireCompass cannot make an official eligibility decision."}]],"$undefined"]}],["$","section","Choose three eligible courses strategically",{"id":"section-3","children":[["$","h2",null,{"children":"Choose three eligible courses strategically"}],[["$","p","Course choices should form one coherent development plan rather than three unrelated attempts. Check that each course meets Chevening's current criteria, then verify the university admission deadline and application process separately.",{"children":"Course choices should form one coherent development plan rather than three unrelated attempts. Check that each course meets Chevening's current criteria, then verify the university admission deadline and application process separately."}],["$","p","Compare modules, teaching approach, practical projects, networks and the skill gap each option addresses. Your scholarship application and university applications are connected, but they are not the same submission.",{"children":"Compare modules, teaching approach, practical projects, networks and the skill gap each option addresses. Your scholarship application and university applications are connected, but they are not the same submission."}]],"$undefined"]}],"$L16","$L17","$L18","$L19","$L1a"]]}],"$L1b","$L1c"]}],"$L1d"]}]
14:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"eyebrow","children":"Continue exploring"}],["$","h2",null,{"children":"Related pages"}]]}],["$","div",null,{"className":"related-grid","children":[["$","$L3","countries/united-kingdom",{"href":"/countries/united-kingdom","children":[["$","span",null,{"children":"Destination guide"}],["$","h3",null,{"children":"UK scholarships for international students"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","scholarships/masters",{"href":"/scholarships/masters","children":[["$","span",null,{"children":"Postgraduate funding"}],["$","h3",null,{"children":"Master's scholarships for international students"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","guides/scholarships-without-ielts",{"href":"/guides/scholarships-without-ielts","children":[["$","span",null,{"children":"Eligibility guide · 10 min read"}],["$","h3",null,{"children":"Scholarships without IELTS for international students in 2027"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","deadline-calendar",{"href":"/deadline-calendar","children":[["$","span",null,{"children":"Application planning"}],["$","h3",null,{"children":"Scholarship and opportunity deadline calendar"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
16:["$","section","Build evidence for leadership and influence",{"id":"section-4","children":[["$","h2",null,{"children":"Build evidence for leadership and influence"}],[["$","p","Use specific situations in which you identified a problem, made a decision, involved other people and produced an observable result. Explain your personal contribution and reflection. A job title or organisation name does not prove leadership by itself.",{"children":"Use specific situations in which you identified a problem, made a decision, involved other people and produced an observable result. Explain your personal contribution and reflection. A job title or organisation name does not prove leadership by itself."}]],["$","ul",null,{"children":[["$","li","Situation and people affected",{"children":"Situation and people affected"}],["$","li","Decision or initiative you owned",{"children":"Decision or initiative you owned"}],["$","li","How you persuaded or coordinated others",{"children":"How you persuaded or coordinated others"}],["$","li","Result supported by a measure or concrete change",{"children":"Result supported by a measure or concrete change"}],["$","li","What you learned and later applied",{"children":"What you learned and later applied"}]]}]]}]
17:["$","section","Make networking evidence substantive",{"id":"section-5","children":[["$","h2",null,{"children":"Make networking evidence substantive"}],[["$","p","Networking is not collecting contacts. Show how you built a professional relationship, exchanged value, maintained trust and achieved or learned something relevant. Explain how you would contribute to a Chevening cohort as well as benefit from it.",{"children":"Networking is not collecting contacts. Show how you built a professional relationship, exchanged value, maintained trust and achieved or learned something relevant. Explain how you would contribute to a Chevening cohort as well as benefit from it."}]],"$undefined"]}]
18:["$","section","Connect the UK course to a realistic career plan",{"id":"section-6","children":[["$","h2",null,{"children":"Connect the UK course to a realistic career plan"}],[["$","p","Define the problem or sector you want to work on, the capability missing from your present profile and the role or sequence you can realistically pursue after study. Avoid claims that one master's degree will solve a national problem instantly.",{"children":"Define the problem or sector you want to work on, the capability missing from your present profile and the role or sequence you can realistically pursue after study. Avoid claims that one master's degree will solve a national problem instantly."}]],"$undefined"]}]
19:["$","section","Final pre-submission checks",{"id":"section-7","children":[["$","h2",null,{"children":"Final pre-submission checks"}],[["$","p","Reopen the official guidance, answer every current prompt, verify employment dates and course information, and ensure that examples across the form are consistent. Do not buy essays or submit fabricated evidence. Prepare to defend every claim in an interview.",{"children":"Reopen the official guidance, answer every current prompt, verify employment dates and course information, and ensure that examples across the form are consistent. Do not buy essays or submit fabricated evidence. Prepare to defend every claim in an interview."}]],["$","ul",null,{"children":[["$","li","All eligibility answers are accurate",{"children":"All eligibility answers are accurate"}],["$","li","Dates match the CV and evidence",{"children":"Dates match the CV and evidence"}],["$","li","Three courses are currently eligible",{"children":"Three courses are currently eligible"}],["$","li","Each response answers its full prompt",{"children":"Each response answers its full prompt"}],["$","li","Examples show action, result and reflection",{"children":"Examples show action, result and reflection"}],["$","li","Deadline converted from UTC",{"children":"Deadline converted from UTC"}],["$","li","Submission receipt saved",{"children":"Submission receipt saved"}]]}]]}]
1a:["$","section","Separate the scholarship deadline from the offer deadline",{"id":"section-8","children":[["$","h2",null,{"children":"Separate the scholarship deadline from the offer deadline"}],[["$","p","Chevening's official timeline closes the scholarship application at 11:00 UTC on 6 October 2026. Applicants who later succeed at interview must submit at least one unconditional eligible UK university offer by 17:00 BST on 8 July 2027. This later requirement does not extend the October scholarship deadline.",{"children":"Chevening's official timeline closes the scholarship application at 11:00 UTC on 6 October 2026. Applicants who later succeed at interview must submit at least one unconditional eligible UK university offer by 17:00 BST on 8 July 2027. This later requirement does not extend the October scholarship deadline."}],["$","p","For each of your planned UK courses, record its own admission opening date, application deadline, English-language rule and time needed to obtain an unconditional offer. Store these beside, not instead of, the Chevening timeline.",{"children":"For each of your planned UK courses, record its own admission opening date, application deadline, English-language rule and time needed to obtain an unconditional offer. Store these beside, not instead of, the Chevening timeline."}]],["$","ul",null,{"children":[["$","li","Scholarship form and submission confirmation",{"children":"Scholarship form and submission confirmation"}],["$","li","Course admission for each university",{"children":"Course admission for each university"}],["$","li","Interview documents where shortlisted",{"children":"Interview documents where shortlisted"}],["$","li","Official unconditional-offer deadline",{"children":"Official unconditional-offer deadline"}]]}]]}]
