12:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","div",null,{"className":"article-note","children":[["$","$L3",null,{"ref":"$undefined","iconNode":[["path",{"d":"M10.5 22H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.706.706l3.588 3.588A2.4 2.4 0 0 1 20 8v6","key":"g5mvt7"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"m14 20 2 2 4-4","key":"15kota"}]],"className":"lucide-file-check-corner","aria-hidden":"true"}],["$","div",null,{"children":[["$","strong",null,{"children":"Use this guide with the official instructions."}],["$","p",null,{"children":"Programme prompts, limits and document rules always take priority over general advice."}]]}]]}],[["$","section","Choose the correct 2027 intake",{"id":"section-1","children":[["$","h2",null,{"children":"Choose the correct 2027 intake"}],[["$","p","The official admissions timeline lists Spring 2027 for PhD applicants, with a 27 September 2026 deadline. It lists Fall 2027 applications for MS, MS/PhD and PhD applicants opening on 28 September 2026 and closing on 3 January 2027.",{"children":"The official admissions timeline lists Spring 2027 for PhD applicants, with a 27 September 2026 deadline. It lists Fall 2027 applications for MS, MS/PhD and PhD applicants opening on 28 September 2026 and closing on 3 January 2027."}],["$","p","KAUST marks dates as tentative, so reopen the official timeline before submitting. Do not apply to an intake or degree route that does not match the programme availability shown in the portal.",{"children":"KAUST marks dates as tentative, so reopen the official timeline before submitting. Do not apply to an intake or degree route that does not match the programme availability shown in the portal."}]],"$undefined"]}],["$","section","Understand admission and fellowship support",{"id":"section-2","children":[["$","h2",null,{"children":"Understand admission and fellowship support"}],[["$","p","KAUST describes fellowship support for admitted graduate students, including tuition, living support, on-campus housing, medical and dental coverage and relocation assistance under current terms. Verify the exact award conditions, payment timing and personal costs for your offer.",{"children":"KAUST describes fellowship support for admitted graduate students, including tuition, living support, on-campus housing, medical and dental coverage and relocation assistance under current terms. Verify the exact award conditions, payment timing and personal costs for your offer."}]],"$undefined"]}],["$","section","Build research and programme fit",{"id":"section-3","children":[["$","h2",null,{"children":"Build research and programme fit"}],[["$","p","Start with the KAUST academic programmes and research areas. Identify the scientific or engineering problem you want to investigate, the methods you have already used and the laboratories, faculty expertise or facilities relevant to the next step.",{"children":"Start with the KAUST academic programmes and research areas. Identify the scientific or engineering problem you want to investigate, the methods you have already used and the laboratories, faculty expertise or facilities relevant to the next step."}],["$","p","A strong statement does not simply praise KAUST's reputation. It shows that the applicant understands the research environment and can connect prior preparation to a specific, realistic direction.",{"children":"A strong statement does not simply praise KAUST's reputation. It shows that the applicant understands the research environment and can connect prior preparation to a specific, realistic direction."}]],"$undefined"]}],"$L15","$L16","$L17","$L18"]]}],"$L19","$L1a"]}],"$L1b"]}]
