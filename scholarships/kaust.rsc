1a:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","When is the KAUST Spring 2027 PhD deadline?",{"children":[["$","summary",null,{"children":["When is the KAUST Spring 2027 PhD deadline?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"KAUST's official timeline lists 27 September 2026. The university labels timelines as tentative, so confirm again before submission."}]]}],["$","details","When does the KAUST Fall 2027 application open?",{"children":[["$","summary",null,{"children":["When does the KAUST Fall 2027 application open?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The official timeline lists 28 September 2026 as the opening date and 3 January 2027 as the deadline for Fall 2027 MS, MS/PhD and PhD applications."}]]}],["$","details","Is KAUST fully funded?",{"children":[["$","summary",null,{"children":["Is KAUST fully funded?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"KAUST describes fellowship support for admitted graduate students, including tuition and major living and study support. Read the current offer terms for exact coverage."}]]}],["$","details","Can Pakistani students apply to KAUST?",{"children":[["$","summary",null,{"children":["Can Pakistani students apply to KAUST?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Qualified international applicants, including Pakistanis, can apply when they meet the selected programme, degree, document and language requirements."}]]}],["$","details","Do I need a supervisor before applying?",{"children":[["$","summary",null,{"children":["Do I need a supervisor before applying?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Follow the current programme and admissions instructions. Researching faculty fit is important, but any required or optional contact depends on the selected route."}]]}],["$","details","Does AspireCompass submit applications for students?",{"children":[["$","summary",null,{"children":["Does AspireCompass submit applications for students?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. AspireCompass is an independent research and guidance website. Apply only through the programme, university, government or employer portal linked as the official source."}]]}],["$","details","Can a deadline or eligibility rule change after this page is updated?",{"children":[["$","summary",null,{"children":["Can a deadline or eligibility rule change after this page is updated?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Programme owners can revise dates, benefits and rules. Reopen the official call before you act, check the intake year and save a copy of the instructions used for your application."}]]}]]}]]}]
