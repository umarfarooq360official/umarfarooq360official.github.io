15:["$","section","Prepare academic evidence",{"id":"section-4","children":[["$","h2",null,{"children":"Prepare academic evidence"}],[["$","p","Follow the live application checklist for transcripts, degree evidence, English-language requirements, references, CV and statements. Use accurate grading information and explain your individual contribution to research, thesis or technical projects.",{"children":"Follow the live application checklist for transcripts, degree evidence, English-language requirements, references, CV and statements. Use accurate grading information and explain your individual contribution to research, thesis or technical projects."}]],["$","ul",null,{"children":[["$","li","Degree and transcript records",{"children":"Degree and transcript records"}],["$","li","Official grading-scale context",{"children":"Official grading-scale context"}],["$","li","Research or technical CV",{"children":"Research or technical CV"}],["$","li","Statement aligned to the selected programme",{"children":"Statement aligned to the selected programme"}],["$","li","Referees able to assess research readiness",{"children":"Referees able to assess research readiness"}],["$","li","Accepted language evidence",{"children":"Accepted language evidence"}],["$","li","Valid identity documents",{"children":"Valid identity documents"}]]}]]}]
16:["$","section","Contact faculty with purpose",{"id":"section-5","children":[["$","h2",null,{"children":"Contact faculty with purpose"}],[["$","p","If programme guidance encourages contact, write a short, specific message showing genuine research overlap. Mention one relevant project or method and ask a focused question. Mass emails with generic praise are unlikely to help and can damage credibility.",{"children":"If programme guidance encourages contact, write a short, specific message showing genuine research overlap. Mention one relevant project or method and ask a focused question. Mass emails with generic praise are unlikely to help and can damage credibility."}]],"$undefined"]}]
17:["$","section","Advice for international and Pakistani applicants",{"id":"section-6","children":[["$","h2",null,{"children":"Advice for international and Pakistani applicants"}],[["$","p","International applicants, including qualified students from Pakistan, should verify degree equivalency, English requirements, document formats and visa steps through the official KAUST process. Funding does not remove the need to meet academic and immigration conditions.",{"children":"International applicants, including qualified students from Pakistan, should verify degree equivalency, English requirements, document formats and visa steps through the official KAUST process. Funding does not remove the need to meet academic and immigration conditions."}]],"$undefined"]}]
18:["$","section","Final deadline and fraud checks",{"id":"section-7","children":[["$","h2",null,{"children":"Final deadline and fraud checks"}],[["$","p","Apply through the KAUST admissions domain, confirm the correct intake and save the submission receipt. Do not pay a private person for guaranteed admission or fellowship selection. If a message conflicts with the official portal, verify it with KAUST directly.",{"children":"Apply through the KAUST admissions domain, confirm the correct intake and save the submission receipt. Do not pay a private person for guaranteed admission or fellowship selection. If a message conflicts with the official portal, verify it with KAUST directly."}]],"$undefined"]}]
