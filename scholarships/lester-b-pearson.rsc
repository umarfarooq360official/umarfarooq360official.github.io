15:["$","div",null,{"className":"inner-hero__visual","children":[["$","$L18",null,{"src":"/images/scholarships-editorial.webp","alt":"Prospective undergraduate applicant planning official university and scholarship deadlines","fill":true,"unoptimized":true,"sizes":"(max-width: 900px) 100vw, 38vw"}],["$","div",null,{"children":[["$","$L4",null,{"ref":"$undefined","iconNode":"$9:1:props:children:props:children:props:fallback:props:children:props:children:0:props:children:props:iconNode","className":"lucide-compass","aria-hidden":"true"}],["$","span",null,{"children":"Clear next steps"}],["$","strong",null,{"children":"Official sources first"}]]}]]}]
16:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","div",null,{"className":"article-note","children":[["$","$L4",null,{"ref":"$undefined","iconNode":[["path",{"d":"M10.5 22H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.706.706l3.588 3.588A2.4 2.4 0 0 1 20 8v6","key":"g5mvt7"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"m14 20 2 2 4-4","key":"15kota"}]],"className":"lucide-file-check-corner","aria-hidden":"true"}],["$","div",null,{"children":[["$","strong",null,{"children":"Use this guide with the official instructions."}],["$","p",null,{"children":"Programme prompts, limits and document rules always take priority over general advice."}]]}]]}],[["$","section","Three different dates for September 2027 entry",{"id":"section-1","children":[["$","h2",null,{"children":"Three different dates for September 2027 entry"}],[["$","p","The University of Toronto lists 9 October 2026 for school nomination, 16 October 2026 for the student's undergraduate admission application, and 6 November 2026 for the Pearson scholarship application and documents. Missing the first deadline cannot be fixed simply by completing the later form.",{"children":"The University of Toronto lists 9 October 2026 for school nomination, 16 October 2026 for the student's undergraduate admission application, and 6 November 2026 for the Pearson scholarship application and documents. Missing the first deadline cannot be fixed simply by completing the later form."}],["$","p","Have your school's counsellor or head confirm its participation early. Read the university's current scholarship page again immediately before acting, since universities can change application instructions.",{"children":"Have your school's counsellor or head confirm its participation early. Read the university's current scholarship page again immediately before acting, since universities can change application instructions."}]],["$","ul",null,{"children":[["$","li","9 October 2026: school nomination",{"children":"9 October 2026: school nomination"}],["$","li","16 October 2026: University of Toronto admission application",{"children":"16 October 2026: University of Toronto admission application"}],["$","li","6 November 2026: scholarship form and required documentation",{"children":"6 November 2026: scholarship form and required documentation"}]]}]]}],["$","section","Who is eligible for consideration?",{"id":"section-2","children":[["$","h2",null,{"children":"Who is eligible for consideration?"}],[["$","p","The official 2027 entry guidance targets international students who need a Canadian study permit and are in their final year of secondary school in 2026/27 or graduated no earlier than June 2026. Students already in post-secondary education and those beginning post-secondary education in January 2027 are not eligible under the current guidance.",{"children":"The official 2027 entry guidance targets international students who need a Canadian study permit and are in their final year of secondary school in 2026/27 or graduated no earlier than June 2026. Students already in post-secondary education and those beginning post-secondary education in January 2027 are not eligible under the current guidance."}],["$","p","Nomination is competitive: a high school can nominate one student each year. Strong academics alone are not the whole selection story; the university describes creativity, leadership and contribution to the school or community as important qualities.",{"children":"Nomination is competitive: a high school can nominate one student each year. Strong academics alone are not the whole selection story; the university describes creativity, leadership and contribution to the school or community as important qualities."}]],"$undefined"]}],"$L19","$L1a","$L1b","$L1c"]]}],"$L1d","$L1e"]}],"$L1f"]}]
17:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"eyebrow","children":"Continue exploring"}],["$","h2",null,{"children":"Related pages"}]]}],["$","div",null,{"className":"related-grid","children":[["$","$L3","countries/canada",{"href":"/countries/canada","children":[["$","span",null,{"children":"Destination guide"}],["$","h3",null,{"children":"Scholarships in Canada for international students"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$f:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","scholarships/bachelors",{"href":"/scholarships/bachelors","children":[["$","span",null,{"children":"Undergraduate funding"}],["$","h3",null,{"children":"Bachelor's scholarships for international students"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$f:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","guides/scholarship-application",{"href":"/guides/scholarship-application","children":[["$","span",null,{"children":"Application guide · 13 min read"}],["$","h3",null,{"children":"How to apply for international scholarships step by step"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$f:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","deadline-calendar",{"href":"/deadline-calendar","children":[["$","span",null,{"children":"Application planning"}],["$","h3",null,{"children":"Scholarship and opportunity deadline calendar"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$f:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
19:["$","section","How the school nomination works",{"id":"section-3","children":[["$","h2",null,{"children":"How the school nomination works"}],[["$","p","Ask a guidance counsellor, principal or school head whether your school is authorised to nominate. A school not already participating must take the official registration route; individual students cannot replace the school's nomination with an agent or a private message.",{"children":"Ask a guidance counsellor, principal or school head whether your school is authorised to nominate. A school not already participating must take the official registration route; individual students cannot replace the school's nomination with an agent or a private message."}],["$","p","Provide your school with a short evidence file: academic record, substantive projects, leadership contributions and a clear explanation of why University of Toronto study fits your goals. The school makes its own nomination decision.",{"children":"Provide your school with a short evidence file: academic record, substantive projects, leadership contributions and a clear explanation of why University of Toronto study fits your goals. The school makes its own nomination decision."}]],"$undefined"]}]
1a:["$","section","Apply to the right University of Toronto programme",{"id":"section-4","children":[["$","h2",null,{"children":"Apply to the right University of Toronto programme"}],[["$","p","After nomination, apply to at least one eligible undergraduate programme through the university's stated admission route before its Pearson consideration deadline. The university says an eventual scholarship would be tied to the student's top choice of programme at the time of the award decision.",{"children":"After nomination, apply to at least one eligible undergraduate programme through the university's stated admission route before its Pearson consideration deadline. The university says an eventual scholarship would be tied to the student's top choice of programme at the time of the award decision."}],["$","p","Check admission prerequisites and English-language evidence for that exact programme separately. Scholarship nomination does not guarantee admission, a study permit or an award.",{"children":"Check admission prerequisites and English-language evidence for that exact programme separately. Scholarship nomination does not guarantee admission, a study permit or an award."}]],"$undefined"]}]
1b:["$","section","Complete the scholarship form yourself",{"id":"section-5","children":[["$","h2",null,{"children":"Complete the scholarship form yourself"}],[["$","p","The university sends nominated students a private scholarship application link after nomination. Complete the form using your own genuine experiences and the university's current rules. The university explicitly prohibits generative AI tools from creating content for its undergraduate award application; applicants should follow that rule.",{"children":"The university sends nominated students a private scholarship application link after nomination. Complete the form using your own genuine experiences and the university's current rules. The university explicitly prohibits generative AI tools from creating content for its undergraduate award application; applicants should follow that rule."}],["$","p","A scholarship website can explain the process, but it must not draft a nominee's restricted responses. Treat offers from agents claiming a guaranteed nomination or scholarship as suspicious; the university warns that the Pearson programme does not recruit through educational agents.",{"children":"A scholarship website can explain the process, but it must not draft a nominee's restricted responses. Treat offers from agents claiming a guaranteed nomination or scholarship as suspicious; the university warns that the Pearson programme does not recruit through educational agents."}]],"$undefined"]}]
1c:["$","section","Check the real funding package",{"id":"section-6","children":[["$","h2",null,{"children":"Check the real funding package"}],[["$","p","The official page lists tuition, books, incidental fees and full residence support for four years. Ask the university about anything the published award description does not specify, such as travel, visa, personal expenses or how later-year support is maintained.",{"children":"The official page lists tuition, books, incidental fees and full residence support for four years. Ask the university about anything the published award description does not specify, such as travel, visa, personal expenses or how later-year support is maintained."}],["$","p","Keep a realistic budget and an alternative funding shortlist. Even a strong nominee should not treat admission or an award as certain before receiving the university's official decision.",{"children":"Keep a realistic budget and an alternative funding shortlist. Even a strong nominee should not treat admission or an award as certain before receiving the university's official decision."}]],"$undefined"]}]
1d:["$","section",null,{"className":"source-section","aria-labelledby":"official-sources","children":[["$","span",null,{"className":"eyebrow","children":"Primary-source record"}],["$","h2",null,{"id":"official-sources","children":"Official sources and verification"}],["$","p",null,{"children":"Official programme links used for this guide. Requirements can change; reopen the current call before applying."}],["$","div",null,{"className":"source-grid","children":[["$","$L3","https://future.utoronto.ca/pearson-scholarships",{"href":"https://future.utoronto.ca/pearson-scholarships","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"University of Toronto Pearson Scholarships"}],["$","span",null,{"children":"Current 2027 entry eligibility, deadlines, funding and application rules"}]]}],["$","$L4",null,{"ref":"$undefined","iconNode":[["path",{"d":"M15 3h6v6","key":"1q9fwt"}],["path",{"d":"M10 14 21 3","key":"gplh6r"}],["path",{"d":"M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6","key":"a6xqqp"}]],"className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
1e:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can I apply without a school nomination?",{"children":[["$","summary",null,{"children":["Can I apply without a school nomination?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The University of Toronto requires a nomination from the student's high school before the individual scholarship application is provided."}]]}],["$","details","Can my school nominate more than one student?",{"children":[["$","summary",null,{"children":["Can my school nominate more than one student?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The university's current guidance says one student per school per year."}]]}],["$","details","Does the award pay for all travel and visa costs?",{"children":[["$","summary",null,{"children":["Does the award pay for all travel and visa costs?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"The official scholarship page lists tuition, books, incidental fees and full residence support. Confirm any other expenses directly with the programme office."}]]}]]}]]}]
