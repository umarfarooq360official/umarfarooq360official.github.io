21:["$","article",null,{"className":"article-body ","children":[false,[["$","section","Work backwards from submission",{"id":"section-1","children":[["$","h2",null,{"children":"Work backwards from submission"}],[["$","p","A deadline is the final moment, not the target submission date. Allow extra time for referees, certified documents, test scores, portal errors and time-zone differences.",{"children":"A deadline is the final moment, not the target submission date. Allow extra time for referees, certified documents, test scores, portal errors and time-zone differences."}]],"$undefined",["$","ul",null,{"children":[["$","li","Six to eight weeks: shortlist and request references",{"children":"Six to eight weeks: shortlist and request references"}],["$","li","Four weeks: complete first essays and document checks",{"children":"Four weeks: complete first essays and document checks"}],["$","li","Two weeks: finalise programme-specific answers",{"children":"Two weeks: finalise programme-specific answers"}],["$","li","Three days: submit and save confirmation",{"children":"Three days: submit and save confirmation"}]]}],"$undefined"]}],["$","section","Understand every status label",{"id":"section-2","children":[["$","h2",null,{"children":"Understand every status label"}],[["$","p","Open means an official current cycle is accepting applications; opening soon means the owner has announced a future window; rolling means vacancies or reviews continue without one universal date; check official site means the date varies or a new cycle is not confirmed; closed means the listed cycle has passed.",{"children":"Open means an official current cycle is accepting applications; opening soon means the owner has announced a future window; rolling means vacancies or reviews continue without one universal date; check official site means the date varies or a new cycle is not confirmed; closed means the listed cycle has passed."}],["$","p","A date can be correct while a local submission time is different. Convert the stated time zone, check whether a nominating body has an earlier deadline and aim to submit at least several days early.",{"children":"A date can be correct while a local submission time is different. Convert the stated time zone, check whether a nominating body has an earlier deadline and aim to submit at least several days early."}]],"$undefined","$undefined","$undefined"]}],["$","section","What to do when a deadline is unconfirmed",{"id":"section-3","children":[["$","h2",null,{"children":"What to do when a deadline is unconfirmed"}],[["$","p","Use the previous cycle only to estimate preparation time, never as a current deadline. Subscribe to the programme owner's updates if available, prepare reusable documents and wait for the official call before finalising programme-specific answers.",{"children":"Use the previous cycle only to estimate preparation time, never as a current deadline. Subscribe to the programme owner's updates if available, prepare reusable documents and wait for the official call before finalising programme-specific answers."}]],"$undefined","$undefined","$undefined"]}],["$","section","A weekly deadline routine",{"id":"section-4","children":[["$","h2",null,{"children":"A weekly deadline routine"}],[["$","p","Review your shortlist once a week. Reopen each official page, record changes, follow up with referees and move your internal submission date earlier when a portal or nomination step is complicated.",{"children":"Review your shortlist once a week. Reopen each official page, record changes, follow up with referees and move your internal submission date earlier when a portal or nomination step is complicated."}]],"$undefined","$L24","$undefined"]}],"$L25"]]}]
