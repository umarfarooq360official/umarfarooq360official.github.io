1:["$","main",null,{"id":"main-content","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Scholarship and international opportunity guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"ISEE parificato for international students: documents and steps\",\"item\":\"https://aspirecompass.org/guides/isee-parificato-international-students/\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"ISEE parificato for international students: documents and steps\",\"description\":\"Prepare ISEE parificato and foreign-income evidence for Italy. Compare Padua and ER.GO routes, organise household documents and avoid deadline mistakes.\",\"datePublished\":\"2026-10-05\",\"dateModified\":\"2026-10-05\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/guides/isee-parificato-international-students/\"}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"FAQPage\",\"mainEntity\":[{\"@type\":\"Question\",\"name\":\"Is ISEE parificato a scholarship?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. It assesses the household's financial position. You still need to apply for the specific benefit and meet its other conditions.\"}},{\"@type\":\"Question\",\"name\":\"Can I use the same certificate at every university?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Do not assume so. The authorised assessor, document years and accepted submission routes can differ.\"}},{\"@type\":\"Question\",\"name\":\"Can I estimate my ISEE with a GPA or study-cost calculator?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"No. These calculators do not assess household income and assets under Italian financial-aid rules.\"}}]}"}}]],["$","section",null,{"className":"inner-hero inner-hero--guide inner-hero--visual","children":["$","div",null,{"className":"site-shell inner-hero__grid","children":[["$","div",null,{"className":"inner-hero__content","children":[["$","nav",null,{"className":"breadcrumbs","aria-label":"Breadcrumb","children":[["$","span","/",{"children":[["$","$L3",null,{"href":"/","children":"Home"}],["$","i",null,{"children":"/"}]]}],["$","span","/guides",{"children":[["$","$L3",null,{"href":"/guides","children":"Scholarship and international opportunity guides"}],["$","i",null,{"children":"/"}]]}],["$","span","/guides/isee-parificato-international-students",{"children":[["$","span",null,{"aria-current":"page","children":"ISEE parificato for international students: documents and steps"}],false]}]]}],["$","span",null,{"data-slot":"badge","data-variant":"outline","className":"inline-flex w-fit shrink-0 items-center justify-center gap-1 overflow-hidden rounded-full border px-2 py-0.5 text-xs font-medium whitespace-nowrap transition-[color,box-shadow] focus-visible:border-ring focus-visible:ring-[3px] focus-visible:ring-ring/50 aria-invalid:border-destructive aria-invalid:ring-destructive/20 dark:aria-invalid:ring-destructive/40 [&>svg]:pointer-events-none [&>svg]:size-3 border-border text-foreground [a&]:hover:bg-accent [a&]:hover:text-accent-foreground inner-eyebrow","children":"Foreign-income documents · Practical guide"}],"$L11","$L12","$L13"]}],"$L14"]}]}],"$L15","$L16"]}]
