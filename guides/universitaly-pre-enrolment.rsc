1d:[["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Preparation checklist: requirements depend on your institution","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Preparation checklist: requirements depend on your institution"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th","Item",{"scope":"col","children":"Item"}],["$","th","Check before entering it",{"scope":"col","children":"Check before entering it"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[["$","th","0",{"scope":"row","children":"Identity"}],["$","td","1",{"children":"Passport spelling, date of birth and document validity"}]]}],["$","tr","1",{"children":[["$","th","0",{"scope":"row","children":"University/course"}],["$","td","1",{"children":"Correct institution, campus, degree and academic year"}]]}],["$","tr","2",{"children":[["$","th","0",{"scope":"row","children":"Qualification"}],["$","td","1",{"children":"Documents and translation format requested by the university"}]]}],["$","tr","3",{"children":[["$","th","0",{"scope":"row","children":"Admission evidence"}],["$","td","1",{"children":"Offer and any unresolved conditions"}]]}],["$","tr","4",{"children":[["$","th","0",{"scope":"row","children":"Visa jurisdiction"}],["$","td","1",{"children":"Mission responsible for your place of residence"}]]}],["$","tr","5",{"children":[["$","th","0",{"scope":"row","children":"Contact details"}],["$","td","1",{"children":"An inbox you check and can continue to access"}]]}]]}]]}]}],"$undefined"]
1e:["$","section","Step 3: create your account and complete the request",{"id":"section-4","children":[["$","h2",null,{"children":"Step 3: create your account and complete the request"}],[["$","p","Start from Universitaly's official website and follow its registration/login link. Record your credentials securely. Do not share a login with anyone claiming they can guarantee validation.",{"children":"Start from Universitaly's official website and follow its registration/login link. Record your credentials securely. Do not share a login with anyone claiming they can guarantee validation."}],["$","p","Choose the pre-enrolment route and follow the current form. Compare course names carefully when similar names appear. Upload the documents agreed with your institution and review the completed request before submission. Portal labels can change; use university help when the screen differs from an old tutorial.",{"children":"Choose the pre-enrolment route and follow the current form. Compare course names carefully when similar names appear. Upload the documents agreed with your institution and review the completed request before submission. Portal labels can change; use university help when the screen differs from an old tutorial."}]],"$undefined","$undefined","$undefined"]}]
1f:["$","section","Step 4: save proof and monitor corrections",{"id":"section-5","children":[["$","h2",null,{"children":"Step 4: save proof and monitor corrections"}],[["$","p","After submitting, retain the application reference and any downloadable receipt. Check the portal and university email for requests to correct or supplement documents.",{"children":"After submitting, retain the application reference and any downloadable receipt. Check the portal and university email for requests to correct or supplement documents."}],["$","p","A request for correction is a task to resolve, not a reason to create several conflicting applications. Describe the precise issue to the institution: application reference, course, field or document affected and the message displayed. Never include your password in a support email.",{"children":"A request for correction is a task to resolve, not a reason to create several conflicting applications. Describe the precise issue to the institution: application reference, course, field or document affected and the message displayed. Never include your password in a support email."}]],"$undefined","$undefined","$undefined"]}]
20:["$","section","Step 5: understand validation and the visa handoff",{"id":"section-6","children":[["$","h2",null,{"children":"Step 5: understand validation and the visa handoff"}],[["$","p","Universitaly explains that the institution validates a positively assessed request for the relevant diplomatic mission. This does not give the applicant a right to a visa. Use the mission's current requirements for the next stage.",{"children":"Universitaly explains that the institution validates a positively assessed request for the relevant diplomatic mission. This does not give the applicant a right to a visa. Use the mission's current requirements for the next stage."}],["$","p","Do not make non-refundable travel commitments solely because a portal status changed. Also check whether enrolment requires original qualifications or further verification after arrival. There is no universal guaranteed validation duration; request an update from the institution if a stated deadline is approaching.",{"children":"Do not make non-refundable travel commitments solely because a portal status changed. Also check whether enrolment requires original qualifications or further verification after arrival. There is no universal guaranteed validation duration; request an update from the institution if a stated deadline is approaching."}]],"$undefined","$undefined","$undefined"]}]
21:["$","section","Your final consistency check",{"id":"section-7","children":[["$","h2",null,{"children":"Your final consistency check"}],[["$","p","Compare the university offer, submitted pre-enrolment request and visa file side by side. Correct material differences using the authorised route before relying on the documents.",{"children":"Compare the university offer, submitted pre-enrolment request and visa file side by side. Correct material differences using the authorised route before relying on the documents."}]],"$undefined",["$","ul",null,{"children":[["$","li","Same passport identity.",{"children":"Same passport identity."}],["$","li","Same programme, institution and intake.",{"children":"Same programme, institution and intake."}],["$","li","Required conditions completed or clearly recorded.",{"children":"Required conditions completed or clearly recorded."}],["$","li","Latest receipt and university messages saved.",{"children":"Latest receipt and university messages saved."}],["$","li","Visa checklist taken from the competent mission.",{"children":"Visa checklist taken from the competent mission."}],["$","li","University arrival/enrolment tasks recorded separately.",{"children":"University arrival/enrolment tasks recorded separately."}]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Your final consistency check","children":[["$","$L3","/guides/italy-student-visa-pakistan/",{"href":"/guides/italy-student-visa-pakistan/","children":["Visa planning for Pakistan",["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","/guides/cimea-vs-declaration-of-value-italy/",{"href":"/guides/cimea-vs-declaration-of-value-italy/","children":["CIMEA vs Declaration of Value",["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
