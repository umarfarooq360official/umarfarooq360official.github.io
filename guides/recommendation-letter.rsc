11:T6f5,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can I apply for more than one opportunity?","acceptedAnswer":{"@type":"Answer","text":"Usually yes, unless a programme's official rules restrict parallel applications. Keep a tracker for deadlines, references and programme-specific documents."}},{"@type":"Question","name":"Does AspireCompass accept applications?","acceptedAnswer":{"@type":"Answer","text":"No. AspireCompass helps you discover and compare opportunities. Applications must be submitted on the official programme or institution website."}},{"@type":"Question","name":"Can a family member write my recommendation?","acceptedAnswer":{"@type":"Answer","text":"Normally no. Choose an academic or professional referee who can provide independent evidence, unless the programme explicitly permits another relationship."}},{"@type":"Question","name":"What if my referee misses the deadline?","acceptedAnswer":{"@type":"Answer","text":"Contact the programme through its official channel and explain briefly. Do not submit a letter yourself if the rules require direct confidential submission."}},{"@type":"Question","name":"Does AspireCompass submit applications for students?","acceptedAnswer":{"@type":"Answer","text":"No. AspireCompass is an independent research and guidance website. Apply only through the programme, university, government or employer portal linked as the official source."}},{"@type":"Question","name":"Can a deadline or eligibility rule change after this page is updated?","acceptedAnswer":{"@type":"Answer","text":"Yes. Programme owners can revise dates, benefits and rules. Reopen the official call before you act, check the intake year and save a copy of the instructions used for your application."}}]}1:["$","main",null,{"id":"main-content","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemL