17:["$","section","Create a one-page referee brief",{"id":"section-6","children":[["$","h2",null,{"children":"Create a one-page referee brief"}],[["$","p","Provide the programme, selection criteria, deadline, submission method and a short evidence table of work completed with that referee. Mark facts that need confirmation and never write confidential praise on the referee's behalf.",{"children":"Provide the programme, selection criteria, deadline, submission method and a short evidence table of work completed with that referee. Mark facts that need confirmation and never write confidential praise on the referee's behalf."}]],"$undefined"]}]
18:["$","section","Handle confidential references correctly",{"id":"section-7","children":[["$","h2",null,{"children":"Handle confidential references correctly"}],[["$","p","Use institutional or professional email addresses when requested, waive access only when you understand the form and never create an account pretending to be your referee. If a letter must be sealed or uploaded directly, respect that process.",{"children":"Use institutional or professional email addresses when requested, waive access only when you understand the form and never create an account pretending to be your referee. If a letter must be sealed or uploaded directly, respect that process."}]],"$undefined"]}]
19:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can I apply for more than one opportunity?",{"children":[["$","summary",null,{"children":["Can I apply for more than one opportunity?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Usually yes, unless a programme's official rules restrict parallel applications. Keep a tracker for deadlines, references and programme-specific documents."}]]}],["$","details","Does AspireCompass accept applications?",{"children":[["$","summary",null,{"children":["Does AspireCompass accept applications?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. AspireCompass helps you discover and compare opportunities. Applications must be submitted on the official programme or institution website."}]]}],["$","details","Can a family member write my recommendation?",{"children":[["$","summary",null,{"children":["Can a family member write my recommendation?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Normally no. Choose an academic or professional referee who can provide independent evidence, unless the programme explicitly permits another relationship."}]]}],["$","details","What if my referee misses the deadline?",{"children":[["$","summary",null,{"children":["What if my referee misses the deadline?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Contact the programme through its official channel and explain briefly. Do not submit a letter yourself if the rules require direct confidential submission."}]]}],["$","details","Does AspireCompass submit applications for students?",{"children":[["$","summary",null,{"children":["Does AspireCompass submit applications for students?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. AspireCompass is an independent research and gui