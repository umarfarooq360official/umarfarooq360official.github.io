1f:props:children:3:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}],["$","$L2","https://careers.cern/programmes/short-term-internship/",{"href":"https://careers.cern/programmes/short-term-internship/","target":"_blank","rel":"noreferrer","children":[["$","div",null,{"children":[["$","strong",null,{"children":"CERN Short-Term Internship"}],["$","span",null,{"children":"Current nationality condition"}]]}],["$","$L3",null,{"ref":"$undefined","iconNode":"$1f:props:children:3:props:children:0:props:children:1:props:iconNode","className":"lucide-external-link","aria-hidden":"true"}]]}]]}]]}]
20:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Which fully funded scholarships are open for Pakistani students in September 2026?",{"children":[["$","summary",null,{"children":["Which fully funded scholarships are open for Pakistani students in September 2026?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Official pages currently show Chevening and eligible Commonwealth 2027–2028 routes as open. KAUST lists a Spring 2027 PhD deadline of 27 September 2026. Eligibility and nomination rules still need individual verification."}]]}],["$","details","Can Pakistani students apply for Chevening 2027–2028?",{"children":[["$","summary",null,{"children":["Can Pakistani students apply for Chevening 2027–2028?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Pakistani applicants can use the Chevening route when they meet the current eligibility and course requirements. Applications close 6 October 2026 at 11:00 UTC according to the official timeline."}]]}],["$","details","Is Pakistan eligible for Commonwealth Master's Scholarships?",{"children":[["$","summary",null,{"children":["Is Pakistan eligible for Commonwealth Master's Scholarships?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Pakistan is listed among eligible countries on the current official Master's page. Applicants must also meet all criteria and use an approved nominator route; the central deadline is not the only process step."}]]}],["$","details","Can Pakistani nationals apply for CERN internships now?",{"children":[["$","summary",null,{"children":["Can Pakistani nationals apply for CERN internships now?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"CERN's current Short-Term Internship and Origin pages state that Pakistani nationals cannot currently be considered because a nationality ceiling has been reached. Recheck the official page for future changes."}]]}],["$","details","Can I get a scholarship abroad without IELTS from Pakistan?",{"children":[["$","summary",null,{"children":["Can I get a scholarship abroad without IELTS from Pakistan?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Sometimes, if the scholarship and chosen institution accept another test, Medium of Instruction evidence or a waiver. Admission, scholarship and visa rules must be checked separately in writing."}]]}],["$","details","Does HEC nominate applicants for every scholarship?",{"children":[["$","summary",null,{"children":["Does HEC nominate applicants for every scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Some routes involve HEC or another national body, while others use an embassy, university, consortium or direct programme portal. Follow the exact current process for each award."}]]}],["$","details","Does AspireCompass submit applications for students?",{"children":[["$","summary",null,{"children":["Does AspireCompass submit applications for students?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. AspireCompass is an independent research and guidance website. Apply only through the programme, university, government or employer portal linked as the official source."}]]}],["$","details","Can a deadline or eligibility rule change after this page is updated?",{"children":[["$","summary",null,{"children":["Can a deadline or eligibility rule change after this page is updated?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Programme owners can revise dates, benefits and rules. Reopen the official call before you act, check the intake year and save a copy of the instructions used for your application."}]]}]]}]]}]
