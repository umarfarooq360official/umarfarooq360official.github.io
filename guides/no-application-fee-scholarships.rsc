16:["$","ul",null,{"children":[["$","li","Confirm the organisation and exact intake",{"children":"Confirm the organisation and exact intake"}],["$","li","List scholarship and admission portals separately",{"children":"List scholarship and admission portals separately"}],["$","li","Check official fee and waiver pages",{"children":"Check official fee and waiver pages"}],["$","li","Keep written confirmation of any waiver",{"children":"Keep written confirmation of any waiver"}]]}]
17:["$","section","How fee waivers work",{"id":"section-4","children":[["$","h2",null,{"children":"How fee waivers work"}],[["$","p","Some universities offer need-based, country-based, event-based or programme-specific waivers. A waiver code from an unofficial forum may be invalid or misused. Follow the institution's published request process and never claim financial circumstances that are untrue.",{"children":"Some universities offer need-based, country-based, event-based or programme-specific waivers. A waiver code from an unofficial forum may be invalid or misused. Follow the institution's published request process and never claim financial circumstances that are untrue."}]],"$undefined"]}]
18:["$","section","Build a zero-surprise application budget",{"id":"section-5","children":[["$","h2",null,{"children":"Build a zero-surprise application budget"}],[["$","p","For every programme, record the scholarship form fee, university fee, test costs, document costs, passport, visa, health requirements, deposit, travel and the timing of the first stipend. Mark each item covered, waived, refundable or self-funded.",{"children":"For every programme, record the scholarship form fee, university fee, test costs, document costs, passport, visa, health requirements, deposit, travel and the timing of the first stipend. Mark each item covered, waived, refundable or self-funded."}]],"$undefined"]}]
19:["$","section","Recognise a scholarship payment scam",{"id":"section-6","children":[["$","h2",null,{"children":"Recognise a scholarship payment scam"}],[["$","p","Warning signs include guaranteed selection, urgency to pay a private person, requests for cryptocurrency or gift cards, a look-alike domain, interviews conducted only through informal chat and demands for passwords or one-time codes.",{"children":"Warning signs include guaranteed selection, urgency to pay a private person, requests for cryptocurrency or gift cards, a look-alike domain, interviews conducted only through informal chat and demands for passwords or one-time codes."}],["$","p","A legitimate fee should appear in the official process and use a traceable institutional payment system. Even then, confirm what the fee covers and whether it is refundable before paying.",{"children":"A legitimate fee should appear in the official process and use a traceable institutional payment system. Even then, confirm what the fee covers and whether it is refundable before paying."}]],"$undefined"]}]
1a:["$","section","No-fee strategy for applicants with limited budgets",{"id":"section-7","children":[["$","h2",null,{"children":"No-fee strategy for applicants with limited budgets"}],[["$","p","Prioritise strong-fit programmes with confirmed affordable processes, request official waivers early and avoid unnecessary repeated tests. A smaller, verified shortlist is safer than applying to dozens of unclear opportunities because a social post calls them free.",{"children":"Prioritise strong-fit programmes with confirmed affordable processes, request official waivers early and avoid unnecessary repeated tests. A smaller, verified shortlist is safer than applying to dozens of unclear opportunities because a social post calls them free."}]],"$undefined"]}]
