1c:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Are fully funded scholarships always free to apply for?",{"children":[["$","summary",null,{"children":["Are fully funded scholarships always free to apply for?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The scholarship form may be free while university admission or preparation costs remain. Verify each required portal and cost separately."}]]}],["$","details","Does Chevening charge an application fee?",{"children":[["$","summary",null,{"children":["Does Chevening charge an application fee?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Use Chevening's official application instructions for the current answer and separately check whether your selected universities charge admission fees."}]]}],["$","details","Can I ask a university for an application-fee waiver?",{"children":[["$","summary",null,{"children":["Can I ask a university for an application-fee waiver?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes, when it publishes a waiver route or contact process. Apply honestly and obtain confirmation before assuming the fee is removed."}]]}],["$","details","Is a paid scholarship application automatically a scam?",{"children":[["$","summary",null,{"children":["Is a paid scholarship application automatically a scam?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not automatically; a connected university or legitimate service may charge a disclosed fee. The warning is an unverified payment, especially one linked to a guarantee or private account."}]]}],["$","details","Should I pay an agent to secure a scholarship?",{"children":[["$","summary",null,{"children":["Should I pay an agent to secure a scholarship?",["$","span",null,{"children":"+"}]]}],["$","p",nu