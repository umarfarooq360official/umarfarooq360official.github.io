13:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","div",null,{"className":"article-note","children":[["$","$L3",null,{"ref":"$undefined","iconNode":[["path",{"d":"M10.5 22H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.706.706l3.588 3.588A2.4 2.4 0 0 1 20 8v6","key":"g5mvt7"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"m14 20 2 2 4-4","key":"15kota"}]],"className":"lucide-file-check-corner","aria-hidden":"true"}],["$","div",null,{"children":[["$","strong",null,{"children":"Use this guide with the official instructions."}],["$","p",null,{"children":"Programme prompts, limits and document rules always take priority over general advice."}]]}]]}],[["$","section","Separate the scholarship fee from the university fee",{"id":"section-1","children":[["$","h2",null,{"children":"Separate the scholarship fee from the university fee"}],[["$","p","A scholarship portal can be free while the university admission route charges a separate application fee. The opposite can also happen when scholarship consideration is automatic with admission. Map every required portal and write the owner and payment beside it.",{"children":"A scholarship portal can be free while the university admission route charges a separate application fee. The opposite can also happen when scholarship consideration is automatic with admission. Map every required portal and write the owner and payment beside it."}],["$","p","Also separate application charges from normal preparation costs: language tests, transcripts, certification, translations, passports, visa fees, medical checks, deposits and travel may occur even when scholarship submission is free.",{"children":"Also separate application charges from normal preparation costs: language tests, transcripts, certification, translations, passports, visa fees, medical checks, deposits and travel may occur even when scholarship submission is free."}]],"$undefined"]}],["$","section","Use official programmes as your starting point",{"id":"section-2","children":[["$","h2",null,{"children":"Use official programmes as your starting point"}],[["$","p","Government and consortium programmes such as Chevening, Commonwealth, Erasmus Mundus and DAAD publish their application routes openly. KAUST publishes its graduate admissions process and fellowship information. Check each current portal for fee wording and then check the connected university or course separately.",{"children":"Government and consortium programmes such as Chevening, Commonwealth, Erasmus Mundus and DAAD publish their application routes openly. KAUST publishes its graduate admissions process and fellowship information. Check each current portal for fee wording and then check the connected university or course separately."}],["$","p","AspireCompass does not label an application permanently fee-free because fees and routes can change. The official page at the time of submission is the only reliable confirmation.",{"children":"AspireCompass does not label an application permanently fee-free because fees and routes can change. The official page at the time of submission is the only reliable confirmation."}]],"$undefined"]}],["$","section","A four-step payment verification",{"id":"section-3","children":[["$","h2",null,{"children":"A four-step payment verification"}],[["$","p","Never begin with a payment link sent by private message. Reach the programme through its official domain, open the current application instructions, identify every required portal and search each official fee page. If the wording is unclear, ask the institution through a published contact channel.",{"children":"Never begin with a payment link sent by private message. Reach the programme through its official domain, open the current application instructions, identify every required portal and search each official fee page. If the wording is unclear, ask the institution through a published contact channel."}]],"$L16"]}],"$L17","$L18","$L19","$L1a"]]}],"$L1b","$L1c"]}],"$L1d"]}]
