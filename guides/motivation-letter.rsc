18:["$","section","Final motivation-letter checklist",{"id":"section-7","children":[["$","h2",null,{"children":"Final motivation-letter checklist"}],[["$","p","Confirm the correct programme name, answer the full prompt, remove generic praise and check that every major claim could be supported in an interview. Submit the requested file type within the stated limit.",{"children":"Confirm the correct programme name, answer the full prompt, remove generic praise and check that every major claim could be supported in an interview. Submit the requested file type within the stated limit."}]],"$undefined"]}]
19:["$","section","Quick answer: connect evidence, programme and future use",{"id":"section-8","children":[["$","h2",null,{"children":"Quick answer: connect evidence, programme and future use"}],[["$","p","A motivation letter should explain why this specific opportunity fits your preparation and what you intend to do with it. Use evidence from study, work, research or service, then connect that evidence to the programme's actual features.",{"children":"A motivation letter should explain why this specific opportunity fits your preparation and what you intend to do with it. Use evidence from study, work, research or service, then connect that evidence to the programme's actual features."}],["$","p","Avoid beginning with a life story that never reaches the selection criteria. Give each paragraph one job: direction, evidence, programme fit or future contribution.",{"children":"Avoid beginning with a life story that never reaches the selection criteria. Give each paragraph one job: direction, evidence, programme fit or future contribution."}]],["$","ul",null,{"children":[["$","li","Opening with a specific direction",{"children":"Opening with a specific direction"}],["$","li","Evidence of preparation",{"children":"Evidence of preparation"}],["$","li","Why this programme",{"children":"Why this programme"}],["$","li","Why this timing",{"children":"Why this timing"}],["$","li","Realistic future contribution",{"children":"Realistic future contribution"}]]}]]}]
1a:["$","section","A practical paragraph test",{"id":"section-9","children":[["$","h2",null,{"children":"A practical paragraph test"}],[["$","p","Underline every claim and ask what evidence supports it. Circle every programme reference and confirm that it comes from an official course or scholarship page. Remove any paragraph that could be sent unchanged to ten institutions.",{"children":"Underline every claim and ask what evidence supports it. Circle every programme reference and confirm that it comes from an official course or scholarship page. Remove any paragraph that could be sent unchanged to ten institutions."}],["$","p","Keep the tone professional and personal. Strong writing is specific and credible; it does not depend on dramatic adjectives or copied quotations.",{"children":"Keep the tone professional and personal. Strong writing is specific and credible; it does not depend on dramatic adjectives or copied quotations."}]],"$undefined"]}]
1b:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can I apply for more than one opportunity?",{"children":[["$","summary",null,{"children":["Can I apply for more than one opportunity?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Usually yes, unless a programme's official rules restrict parallel applications. Keep a tracker for deadlines, references and programme-specific documents."}]]}],["$","details","Does AspireCompass accept applications?",{"children":[["$","summary",null,{"children":["Does AspireCompass accept applications?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. AspireCompass helps you discover and compare opportunities. Applications must be submitted on the official programme or institution website."}]]}],["$","details","How long should a scholarship motivation letter be?",{"children":[["$","summary",null,{"children":["How long should a scholarship motivation letter be?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Use the programme's limit. When no limit is stated, ask the programme if possible and keep the letter focused; a longer letter is not automatically stronger."}]]}],["$","details","Is a motivation letter the same as an SOP?",{"children":[["$","summary",null,{"children":["Is a motivation letter the same as an SOP?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not always. An SOP often focuses on academic preparation and programme fit, while a motivation letter may give more weight to the funder's purpose and future contribution. Follow the actual prompt."}]]}],["$","details","Does AspireCompass submit applications for students?",{"children":[["$","summary",null,{"children":["Does AspireCompass submit applications for students?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. AspireCompass is an independent research and guidance website. Apply only through the programme, university, government or employer portal linked as the official source."}]]}],["$","details","Can a deadline or eligibility rule change after this page is updated?",{"children":[["$","summary",null,{"children":["Can a deadline or eligibility rule change after this page is updated?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes. Programme owners can revise dates, benefits and rules. Reopen the official call before you act, check the intake year and save a copy of the instructions used for your application."}]]}],["$","details","How long should a motivation letter be?",{"children":[["$","summary",null,{"children":["How long should a motivation letter be?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Follow the programme's word or page limit. When none is provided, use enough space to answer the purpose clearly without repeating the CV."}]]}],["$","details","Can I reuse a motivation letter?",{"children":[["$","summary",null,{"children":["Can I reuse a motivation letter?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Reuse your verified evidence, but rewrite programme fit, priorities and future contribution for each opportunity."}]]}]]}]]}]
