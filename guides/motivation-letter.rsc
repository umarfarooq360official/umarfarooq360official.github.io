11:T906,{"@context":"https://schema.org","@type":"FAQPage","mainEntity":[{"@type":"Question","name":"Can I apply for more than one opportunity?","acceptedAnswer":{"@type":"Answer","text":"Usually yes, unless a programme's official rules restrict parallel applications. Keep a tracker for deadlines, references and programme-specific documents."}},{"@type":"Question","name":"Does AspireCompass accept applications?","acceptedAnswer":{"@type":"Answer","text":"No. AspireCompass helps you discover and compare opportunities. Applications must be submitted on the official programme or institution website."}},{"@type":"Question","name":"How long should a scholarship motivation letter be?","acceptedAnswer":{"@type":"Answer","text":"Use the programme's limit. When no limit is stated, ask the programme if possible and keep the letter focused; a longer letter is not automatically stronger."}},{"@type":"Question","name":"Is a motivation letter the same as an SOP?","acceptedAnswer":{"@type":"Answer","text":"Not always. An SOP often focuses on academic preparation and programme fit, while a motivation letter may give more weight to the funder's purpose and future contribution. Follow the actual prompt."}},{"@type":"Question","name":"Does AspireCompass submit applications for students?","acceptedAnswer":{"@type":"Answer","text":"No. AspireCompass is an independent research and guidance website. Apply only through the programme, university, government or employer portal linked as the official source."}},{"@type":"Question","name":"Can a deadline or eligibility rule change after this page is updated?","acceptedAnswer":{"@type":"Answer","text":"Yes. Programme owners can revise dates, benefits and rules. Reopen the official call before you act, check the intake year and save a copy of the instructions used for your application."}},{"@type":"Question","name":"How long should a motivation letter be?","acceptedAnswer":{"@type":"Answer","text":"Follow the programme's word or page limit. When none is provided, use enough space to answer the purpose clearly without repeating the CV."}},{"@type":"Question","name":"Can I reuse a motivation letter?","acceptedAnswer":{"@type":"Answer","text":"Reuse your verified evidence, but rewrite programme fit, priorities and future contribution for each opportunity."}}]}1:["$","main",null,{"id":"main-content","children":[[["$","script","0",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"BreadcrumbList\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://aspirecompass.org/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Scholarship and international opportunity guides\",\"item\":\"https://aspirecompass.org/guides/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"How to write a scholarship motivation letter\",\"item\":\"https://aspirecompass.org/guides/motivation-letter/\"}]}"}}],["$","script","1",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"{\"@context\":\"https://schema.org\",\"@type\":\"Article\",\"headline\":\"How to write a scholarship motivation letter\",\"description\":\"Learn how to structure a scholarship motivation letter with evidence, programme fit, a clear future plan and a practical editing checklist.\",\"datePublished\":\"2026-08-31\",\"dateModified\":\"2026-09-21\",\"author\":{\"@type\":\"Organization\",\"name\":\"AspireCompass Editorial Team\",\"url\":\"https://aspirecompass.org/editorial-policy/\"},\"publisher\":{\"@type\":\"Organization\",\"name\":\"AspireCompass\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://aspirecompass.org/logo.svg\"}},\"mainEntityOfPage\":\"https://aspirecompass.org/guides/motivation-letter/\"}"}}],["$","script","2",{"type":"application/ld+json","dangerouslySetInnerHTML":{"__html":"$11"}}]],"$L12","$L13","$L14"]}]
