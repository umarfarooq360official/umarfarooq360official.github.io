20:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Which Italian university is cheapest for international students?",{"children":[["$","summary",null,{"children":["Which Italian university is cheapest for international students?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"There is no reliable answer without the programme and applicant profile. Compare the amount applicable to your category after economic assessment, then include mandatory charges and city living costs."}]]}],["$","details","Will I pay the minimum fee if my family income is low?",{"children":[["$","summary",null,{"children":["Will I pay the minimum fee if my family income is low?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Only if you meet the university's conditions and submit accepted economic documents by its deadline. Foreign income and assets may require a specific equivalent assessment."}]]}],["$","details","Does a full tuition waiver cover living costs?",{"children":[["$","summary",null,{"children":["Does a full tuition waiver cover living costs?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. A tuition waiver removes eligible tuition but normally does not pay housing, food, travel or every mandatory charge unless the award explicitly says so."}]]}],["$","details","Are application fees included in annual tuition?",{"children":[["$","summary",null,{"children":["Are application fees included in annual tuition?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Often they are separate and may be non-refundable. Check the admission page as well as the tuition page."}]]}]]}]]}]
