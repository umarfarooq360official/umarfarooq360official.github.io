className":"lucide-shield-check","aria-hidden":"true"}],["$","div",null,{"children":[["$","strong",null,{"children":"6 primary sources linked on this page"}],["$","span",null,{"children":"Details are reviewed against official programme, university, government or employer information where available. Always reopen the current official call before applying."}]]}]]}],false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","div",null,{"className":"article-note","children":[["$","$L4",null,{"ref":"$undefined","iconNode":[["path",{"d":"M10.5 22H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.706.706l3.588 3.588A2.4 2.4 0 0 1 20 8v6","key":"g5mvt7"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"m14 20 2 2 4-4","key":"15kota"}]],"className":"lucide-file-check-corner","aria-hidden":"true"}],["$","div",null,{"children":[["$","strong",null,{"children":"Use this guide with the official instructions."}],["$","p",null,{"children":"Programme prompts, limits and document rules always take priority over general advice."}]]}]]}],[["$","section","How to read an Italian tuition figure",{"id":"section-1","children":[["$","h2",null,{"children":"How to read an Italian tuition figure"}],[["$","p","A single number rarely describes every student. The payable amount can depend on the programme, ECTS load, family economic indicator, foreign-income documentation, citizenship or residence category and any exemption. Application fees, regional tax, stamp duty and insurance can sit outside an advertised tuition waiver.",{"children":"A single number rarely describes every student. The payable amount can depend on the programme, ECTS load, family economic indicator, foreign-income documentation, citizenship or residence category and any exemption. Application fees, regional tax, stamp duty and insurance can sit outside an advertised tuition waiver."}],["$","p","The figures below come from official pages for 2026–2027 and provide a comparison method. Confirm the exact programme and your assessed amount before accepting an offer.",{"children":"The figures below come from official pages for 2026–2027 and provide a comparison method. Confirm the exact programme and your assessed amount before accepting an offer."}]],"$undefined"]}],"$L19","$L1a","$L1b","$L1c","$L1d","$L1e"]]}],"$L1f","$L20"]}],"$L21"]}]
17:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"eyebrow","children":"Continue exploring"}],["$","h2",null,{"children":"Related pages"}]]}],["$","div",null,{"className":"related-grid","children":[["$","$L3","countries/italy",{"href":"/countries/italy","children":[["$","span",null,{"children":"Italy destination guide · 14 min read"}],["$","h3",null,{"children":"Scholarships and study routes in Italy for international students"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","scholarships/italy",{"href":"/scholarships/italy","children":[["$","span",null,{"children":"Italy funding guide · 13 min read"}],["$","h3",null,{"children":"Scholarships in Italy for international students"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","guides/italy-dsu-scholarships",{"href":"/guides/italy-dsu-scholarships","children":[["$","span",null,{"children":"Regional funding guide · 12 min read"}],["$","h3",null,{"children":"Italy DSU scholarships: regional benefits and document planning"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","guides/cost-of-living-in-italy-for-students",{"href":"/guides/cost-of-living-in-italy-for-students","children":[["$","span",null,{"children":"Student budget guide · 15 min read"}],["$","h3",null,{"children":"Cost of living in Italy for international students"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","tools/italy-study-cost-calculator",{"href":"/tools/italy-study-cost-