19:["$","section","University of Padua",{"id":"section-2","children":[["$","h2",null,{"children":"University of Padua"}],[["$","p","Padua states that enrolling in its degree programmes costs from zero to approximately €3,000 per year. It also publishes a no-tax area, concessions and full or partial fee waivers for eligible students. The final result depends on the 2026–2027 fee and exemption notice and the student's circumstances.",{"children":"Padua states that enrolling in its degree programmes costs from zero to approximately €3,000 per year. It also publishes a no-tax area, concessions and full or partial fee waivers for eligible students. The final result depends on the 2026–2027 fee and exemption notice and the student's circumstances."}],["$","p","International funding routes include the Padua International Excellence Scholarship, 100 tuition fee waivers for students in eligible English-taught programmes under the published scheme, departmental awards and regional support. Check whether consideration is automatic with admission or requires another action for the intake you select.",{"children":"International funding routes include the Padua International Excellence Scholarship, 100 tuition fee waivers for students in eligible English-taught programmes under the published scheme, departmental awards and regional support. Check whether consideration is automatic with admission or requires another action for the intake you select."}]],["$","ul",null,{"children":[["$","li","Published general range: €0 to about €3,000 per year",{"children":"Published general range: €0 to about €3,000 per year"}],["$","li","Check regional fee and revenue stamp",{"children":"Check regional fee and revenue stamp"}],["$","li","Request concessions by the stated deadline",{"children":"Request concessions by the stated deadline"}],["$","li","Match the scholarship to an English-taught degree and current intake",{"children":"Match the scholarship to an English-taught degree and current intake"}]]}]]}]
1a:["$","section","Politecnico di Milano",{"id":"section-3","children":[["$","h2",null,{"children":"Politecnico di Milano"}],[["$","p","For a standard 46–74 ECTS study plan, Polimi publishes an annual amount from €157.04 up to €3,943.04 according to economic and study-plan conditions. Its 2026–2027 page states a first enrolment instalment of €880.04, with possible reduction through the stated ISEE process, and a later second instalment based on the relevant assessment.",{"children":"For a standard 46–74 ECTS study plan, Polimi publishes an annual amount from €157.04 up to €3,943.04 according to economic and study-plan conditions. Its 2026–2027 page states a first enrolment instalment of €880.04, with possible reduction through the stated ISEE process, and a later second instalment based on the relevant assessment."}],["$","p","Reserved non-EU master's students admitted with a foreign first degree who do not receive a qualifying scholarship are charged the maximum according to the study-plan percentage under the published rule. Merit scholarships can provide a full tuition waiver and some include an allowance, while DSU follows a separate economic and merit process.",{"children":"Reserved non-EU master's students admitted with a foreign first degree who do not receive a qualifying scholarship are charged the maximum according to the study-plan percentage under the published rule. Merit scholarships can provide a full tuition waiver and some include an allowance, while DSU follows a separate economic and merit process."}]],["$","ul",null,{"children":[["$","li","Published standard annual range: €157.04 to €3,943.04",{"children":"Published standard annual range: €157.04 to €3,943.04"}],["$","li","2026–2027 first instalment stated as €880.04 before an applicable reduction",{"children":"2026–2027 first instalment stated as €880.04 before an applicable reduction"}],["$","li","Foreign-income students may need Equalised ISEEU",{"children":"Foreign-income students may need Equalised ISEEU"}],["$","li","Check merit and DSU applications separately",{"children":"Check merit and DSU applications separately"}]]}]]}]
1b:["$","section","University of Bologna",{"id":"section-4","children":[["$","h2",null,{"children":"University of Bologna"}],[["$","p","Bologna describes its fee as a fixed €157.04 instalment plus a variable contribution based on the degree programme and the family's economic situation. The maximum varies by programme. Applicants who do not submit the required ISEE or foreign-income documents can be charged the full programme amount.",{"children":"Bologna describes its fee as a fixed €157.04 instalment plus a variable contribution based on the degree programme and the family's economic situation. The maximum varies by programme. Applicants who do not submit the required ISEE or foreign-income documents can be charged the full programme amount."}],["$","p","For 2026–2027, the university listed the first instalment by 24 September 2026, followed by possible instalments on 18 December 2026 and 15 March 2027. A degree can set a different first deadline. ER.GO scholarship and accommodation applications use their own calendar.",{"children":"For 2026–2027, the university listed the first instalment by 24 September 2026, followed by possible instalments on 18 December 2026 and 15 March 2027. A degree can set a different first deadline. ER.GO scholarship and accommodation applications use their own calendar."}]],["$","ul",null,{"children":[["$","li","Fixed component: €157.04",{"children":"Fixed component: €157.04"}],["$","li","Variable amount: programme and economic assessment",{"children":"Variable amount: programme and economic assessment"}],["$","li","Foreign-income documents affect reductions",{"children":"Foreign-income documents affect reductions"}],["$","li","ER.GO and university fee deadlines must both be tracked",{"children":"ER.GO and university fee deadlines must both be tracked"}]]}]]}]
1c:["$","section","Compare the net annual cost",{"id":"section-5","children":[["$","h2",null,{"children":"Compare the net annual cost"}],[["$","p","For each university, start with the maximum amount applicable to your category. Subtract only a confirmed waiver or award, then add mandatory charges, housing, food, transport, insurance, residence-permit costs, travel and study materials. Keep the first-year arrival budget separate from the later annual budget.",{"children":"For each university, start with the maximum amount applicable to your category. Subtract only a confirmed waiver or award, then add mandatory charges, housing, food, transport, insurance, residence-permit costs, travel and study materials. Keep the first-year arrival budget separate from the later annual budget."}],["$","p","A lower tuition figure can be outweighed by a higher housing cost, while a large scholarship can arrive after deposits are due. Compare the timing of cash as well as the annual total.",{"children":"A lower tuition figure can be outweighed by a higher housing cost, while a large scholarship can arrive after deposits are due. Compare the timing of cash as well as the annual total."}]],"$undefined"]}]
1d:["$","section","A university comparison worksheet",{"id":"section-6","children":[["$","h2",null,{"children":"A university comparison worksheet"}],[["$","p","Record one answer and one official URL for every field. A blank answer is a research task, not permission to assume zero.",{"children":"Record one answer and one official URL for every field. A blank answer is a research task, not permission to assume zero."}]],["$","ul",null,{"children":[["$","li","Degree and teaching language",{"children":"Degree and teaching language"}],["$","li","Admission and application fee",{"children":"Admission and application fee"}],["$","li","Maximum tuition for your category",{"children":"Maximum tuition for your category"}],["$","li","Economic-document deadline",{"children":"Economic-document deadline"}],["$","li","Mandatory regional and administrative charges",{"children":"Mandatory regional and administrative charges"}],["$","li","Merit scholarship",{"children":"Merit scholarship"}],["$","li","Regional DSU route",{"children":"Regional DSU route"}],["$","li","Estimated monthly housing",{"children":"Estimated monthly housing"}],["$","li","First payment date and scholarship payment date",{"children":"First payment date and scholarship payment date"}]]}]]}]
1e:["$","section","Avoid misleading fee comparisons",{"id":"section-7","children":[["$","h2",null,{"children":"Avoid misleading fee comparisons"}],[["$","p","Do not compare one university's minimum subsidised figure with another university's maximum standard fee. Use the same applicant profile and study load. Distinguish a tuition waiver from a cash scholarship and label every figure with its academic year.",{"children":"Do not compare one university's minimum subsidised figure with another university's maximum standard fee. Use the same applicant profile and study load. Distinguish a tuition waiver from a cash scholarship and label every figure with its academic year."}],["$","p","Before paying, reopen the official fee notice from the university account or degree page. A third-party article cannot calculate your final bill.",{"children":"Before paying, reopen the official fee notice from the university account or degree page. A third-party article cannot calculate your final bill."}]],"$undefined"]}]
