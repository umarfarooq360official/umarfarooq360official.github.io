.51 3.81 17 5 19 5a1 1 0 0 1 1 1z","key":"oel41y"}],["path",{"d":"m9 12 2 2 4-4","key":"dzmm74"}]],"className":"lucide-shield-check","aria-hidden":"true"}]," Updated ","20 Sept 2026"]}],["$","span",null,{"children":[["$","$L4",null,{"ref":"$undefined","iconNode":[["path",{"d":"M21.54 15H17a2 2 0 0 0-2 2v4.54","key":"1djwo0"}],["path",{"d":"M7 3.34V5a3 3 0 0 0 3 3a2 2 0 0 1 2 2c0 1.1.9 2 2 2a2 2 0 0 0 2-2c0-1.1.9-2 2-2h3.17","key":"1tzkfa"}],["path",{"d":"M11 21.95V18a2 2 0 0 0-2-2a2 2 0 0 1-2-2v-1a2 2 0 0 0-2-2H2.05","key":"14pb5j"}],["circle",{"cx":"12","cy":"12","r":"10","key":"1mglay"}]],"className":"lucide-earth","aria-hidden":"true"}]," Global English"]}],["$","span",null,{"children":[["$","$L4",null,{"ref":"$undefined","iconNode":[["path",{"d":"M12 5v16","key":"1f6ucr"}],["path",{"d":"M16 13h2","key":"weia3s"}],["path",{"d":"M16 9h2","key":"1n7gjm"}],["path",{"d":"M20.001 19A2 2 0 0022 17V5a2 2 0 00-1.999-2L16 3.002A5 5 0 0012 5a5 5 0 00-4-2H4a2 2 0 00-2 2v12a2 2 0 001.999 2H8a5 5 0 014 2 5 5 0 014-2z","key":"1fyvmf"}],["path",{"d":"M6 13h2","key":"1cckiz"}],["path",{"d":"M6 9h2","key":"1k7j9f"}]],"className":"lucide-book-open-text","aria-hidden":"true"}]," Editorial guide"]}]]}]]}],["$","div",null,{"className":"inner-hero__visual","children":[["$","$L15",null,{"src":"/images/scholarships-editorial.webp","alt":"A student preparing an international scholarship application","fill":true,"unoptimized":true,"sizes":"(max-width: 900px) 100vw, 38vw"}],["$","div",null,{"children":[["$","$L4",null,{"ref":"$undefined","iconNode":"$9:1:props:children:props:children:props:fallback:props:children:props:children:0:props:children:props:iconNode","className":"lucide-compass","aria-hidden":"true"}],["$","span",null,{"children":"Clear next steps"}],["$","strong",null,{"children":"Official sources first"}]]}]]}]]}]}]
13:["$","div",null,{"className":"site-shell content-layout","children":[["$","div",null,{"className":"content-main","children":[false,false,false,false,false,false,false,false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","div",null,{"className":"article-note","children":[["$","$L4",null,{"ref":"$undefined","iconNode":[["path",{"d":"M10.5 22H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.706.706l3.588 3.588A2.4 2.4 0 0 1 20 8v6","key":"g5mvt7"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"m14 20 2 2 4-4","key":"15kota"}]],"className":"lucide-file-check-corner","aria-hidden":"true"}],["$","div",null,{"children":[["$","strong",null,{"children":"Use this guide with the official instructions."}],["$","p",null,{"children":"Programme prompts, limits and document rules always take priority over general advice."}]]}]]}],[["$","section","Quick answer: can you get a scholarship without IELTS?",{"id":"section-1","children":[["$","h2",null,{"children":"Quick answer: can you get a scholarship without IELTS?"}],[["$","p","Yes, some applicants can apply without an IELTS score. The route may involve another approved test, an official Medium of Instruction certificate, a previous qualification taught in English, an interview, a preparatory language year or a programme taught in another language. The accepted route depends on the scholarship and the degree programme.",{"children":"Yes, some applicants can apply without an IELTS score. The route may involve another approved test, an official Medium of Instruction certificate, a previous qualification taught in English, an interview, a preparatory language year or a programme taught in another language. The accepted route depends on the scholarship and the degree programme."}],["$","p","Do not interpret 'IELTS not required by the scholarship' as 'no English evidence required anywhere.' A scholarship application may omit IELTS while the admitting university still asks for proof of English. A university waiver may also be separate from the evidence required for a student visa.",{"children":"Do not interpret 'IELTS not required by the scholarship' as 'no English evidence required anywhere.' A scholarship application may omit IELTS while the admitting university still asks for proof of English. A university waiver may also be separate from the evidence required for a student visa."}]],"$undefined"]}],["$","section","Check three separate rulebooks",{"id":"section-2","children":[["$","h2",null,{"children":"Check three separate rulebooks"}],[["$","p","Before adding an opportunity to your shortlist, check the scholarship owner, the university or consortium delivering the degree and the immigration authority for the study destination. The strictest applicable rule determines what you will ultimately need.",{"children":"Before adding an opportunity to your shortlist, check the scholarship owner, the university or consortium delivering the degree and the immigration authority for the study destination. The strictest applicable rule determines what you will ultimately need."}]],["$","ul",null,{"children":[["$","li","Scholarship rule: what must be submitted for funding consideration?",{"children":"Scholarship rule: what must be submitted for funding consideration?"}],["$","li","Admission rule: what does the exact university and programme accept?",{"children":"Admission rule: what does the exact university and programme accept?"}],["$","li","Visa rule: what English evidence can the immigration process require?",{"children":"Visa rule: what English evidence can the immigration process require?"}],["$","li","Timing rule: must the evidence be ready at application, offer or visa stage?",{"children":"Timing rule: must the evidence be ready at application, offer or visa stage?"}]]}]]}],"$L16","$L17","$L18","$L19","$L1a","$L1b","$L1c","$L1d","$L1e","$L1f","$L20","$L21"]]}],null,"$L22"]}],"$L23"]}]
14:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"eyebrow","children":"Continue exploring"}],["$","h2",null,{"children":"Related pages"}]]}],["$","div",null,{"className":"related-grid","children":[["$","$L3","scholarships/stipendium-hungaricum",{"href":"/scholarships/stipendium-hungaricum","children":[["$","span",null,{"children":"Hungarian government scholarship · 11 min read"}],["$","h3",null,{"children":"How to apply for Stipendium Hungaricum"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","guides/mext-application-routes",{"href":"/guides/mext-application-routes","children":[["$","span",null,{"children":"Japan government scholarship guide · 10 min read"}],["$","h3",null,{"children":"MEXT scholarship: embassy vs university recommendation"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","scholarships/chevening",{"href":"/scholarships/chevening","children":[["$","span",null,{"children":"Official-source scholarship guide · 10 min read"}],["$","h3",null,{"children":"Chevening Scholarships 2027–2028 application guide"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","guides/scholarships-for-pakistani-students",{"href":"/guides/scholarships-for-pakistani-students","children":[["$","span",null,{"children":"Pakistan applicant guide · 12 min read"}],["$","h3",null,{"children":"Fully funded scholarships for Pakistani students in 2027"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
16:["$","section","Five common alternatives to IELTS",{"id":"section-3","children":[["$","h2",null,{"children":"Five common alternatives to IELTS"}],[["$","p","An IELTS waiver does not create one universal replacement. Universities choose their own accepted evidence and can change it between programmes or intakes. Confirm the required score, test version, validity period and whether online or at-home tests are accepted.",{"children":"An IELTS waiver does not create one universal replacement. Universities choose their own accepted evidence and can change it between programmes or intakes. Confirm the required score, test version, validity period and whether online or at-home tests are accepted."}]],["$","ul",null,{"children":[["$","li","Alternative test: TOEFL, PTE Academic, Cambridge English or Duolingo where explicitly accepted",{"children":"Alternative test: TOEFL, PTE Academic, Cambridge English or Duolingo where explicitly accepted"}],["$","li","Medium of Instruction: an official letter confirming that a previous qualification was taught and assessed in English",{"children":"Medium of Instruction: an official letter confirming that a previous qualification was taught and assessed in English"}],["$","li","Previous English-medium qualification: transcripts or certificates from an accepted institution or country",{"children":"Previous English-medium qualification: transcripts or certificates from an accepted institution or country"}],["$","li","Internal assessment: a university interview, written test or language placement process",{"children":"Internal assessment: a university interview, written test or language placement process"}],["$","li","Language pathway: a conditional offer or funded preparatory year before the main degree",{"children":"Language pathway: a conditional offer or funded preparatory year before the main degree"}]]}]]}]
17:["$","section","Scholarship routes to research for 2027",{"id":"section-4","children":[["$","h2",null,{"children":"Scholarship routes to research for 2027"}],[["$","p","The programmes below illustrate different meanings of 'without IELTS.' They are not a promise that every applicant or course receives a waiver. Open the current official call and the chosen university's programme page before applying.",{"children":"The programmes below illustrate different meanings of 'without IELTS.' They are not a promise that every applicant or course receives a waiver. Open the current official call and the chosen university's programme page before applying."}]],["$","ul",null,{"children":[["$","li","Chevening Scholarships: Chevening removed its own English-language test requirement in 2020, but applicants must still meet the requirements of their chosen UK universities and secure an unconditional offer by the relevant deadline.",{"children":"Chevening Scholarships: Chevening removed its own English-language test requirement in 2020, but applicants must still meet the requirements of their chosen UK universities and secure an unconditional offer by the relevant deadline."}],["$","li","Türkiye Scholarships: language-test results are requested when the selected university or programme requires them. Applicants choosing an English-medium programme may still need an internationally accepted certificate, while many awardees also complete Turkish-language preparation.",{"children":"Türkiye Scholarships: language-test results are requested when the selected university or programme requires them. Applicants choosing an English-medium programme may still need an internationally accepted certificate, while many awardees also complete Turkish-language preparation."}],["$","li","MEXT Scholarship, Japan: IELTS is not presented as one universal Embassy Recommendation application document. Applicants must follow the current country-specific embassy process, official guidelines and required language examinations or interviews for their category.",{"children":"MEXT Scholarship, Japan: IELTS is not presented as one universal Embassy Recommendation application document. Applicants must follow the current country-specific embassy process, official guidelines and required language examinations or interviews for their category."}],["$","li","Stipendium Hungaricum: the host institution sets the required language level. Some programmes accept proof that previous study was completed in the programme language, while others specify IELTS, TOEFL or another certificate.",{"children":"Stipendium Hungaricum: the host institution sets the required language level. Some programmes accept proof that previous study was completed in the programme language, while others specify IELTS, TOEFL or another certificate."}],["$","li","Erasmus Mundus Joint Masters: each consortium publishes its own admission and language requirements. Full scholarships may be available, but an IELTS waiver for one course cannot be assumed for another course.",{"children":"Erasmus Mundus Joint Masters: each consortium publishes its own admission and language requirements. Full scholarships may be available, but an IELTS waiver for one course cannot be assumed for another course."}]]}]]}]
18:["$","section","What an MOI certificate should contain",{"id":"section-5","children":[["$","h2",null,{"children":"What an MOI certificate should contain"}],[["$","p","A Medium of Instruction certificate is normally issued by the registrar, controller of examinations or another authorised office at your previous institution. It confirms the language used to teach and assess your completed qualification. A casual letter from a lecturer may not be sufficient.",{"children":"A Medium of Instruction certificate is normally issued by the registrar, controller of examinations or another authorised office at your previous institution. It confirms the language used to teach and assess your completed qualification. A casual letter from a lecturer may not be sufficient."}],["$","p","Ask the target university whether it accepts MOI for your nationality, previous institution, qualification level and chosen programme. Some universities accept it only when the entire qualification was taught and examined in English, and some may request an interview or additional evidence.",{"children":"Ask the target university whether it accepts MOI for your nationality, previous institution, qualification level and chosen programme. Some universities accept it only when the entire qualification was taught and examined in English, and some may request an interview or additional evidence."}]],["$","ul",null,{"children":[["$","li","Your full name and degree title",{"children":"Your full name and degree title"}],["$","li","Institution name and study dates",{"children":"Institution name and study dates"}],["$","li","A clear statement that teaching and assessment were conducted in English",{"children":"A clear statement that teaching and assessment were conducted in English"}],["$","li","Official letterhead, issue date, signature and institutional stamp where used",{"children":"Official letterhead, issue date, signature and institutional stamp where used"}],["$","li","Contact details that allow the university to verify the document",{"children":"Contact details that allow the university to verify the document"}]]}]]}]
19:["$","section","Important guidance for Pakistani students",{"id":"section-6","children":[["$","h2",null,{"children":"Important guidance for Pakistani students"}],[["$","p","Many Pakistani applicants can obtain an English-proficiency or Medium of Instruction letter from their university, but acceptance is not automatic. The receiving institution decides whether the document meets its policy. Ask for confirmation that names your exact programme and intake rather than relying on a general social-media answer.",{"children":"Many Pakistani applicants can obtain an English-proficiency or Medium of Instruction letter from their university, but acceptance is not automatic. The receiving institution decides whether the document meets its policy. Ask for confirmation that names your exact programme and intake rather than relying on a general social-media answer."}],["$","p","For scholarship routes involving HEC Pakistan, check both the HEC call and the international scholarship portal. For example, current HEC guidance for Stipendium Hungaricum notes that some Hungarian universities require IELTS or TOEFL, while many institutions accept an English-proficiency certificate. HEC nomination tests and document rules remain separate from the host university's language requirement.",{"children":"For scholarship routes involving HEC Pakistan, check both the HEC call and the international scholarship portal. For example, current HEC guidance for Stipendium Hungaricum notes that some Hungarian universities require IELTS or TOEFL, while many institutions accept an English-proficiency certificate. HEC nomination tests and document rules remain separate from the host university's language requirement."}]],["$","ul",null,{"children":[["$","li","Request the MOI or English-proficiency certificate early from the authorised university office",{"children":"Request the MOI or English-proficiency certificate early from the authorised university office"}],["$","li","Use the same spelling of your name shown on your passport and academic records",{"children":"Use the same spelling of your name shown on your passport and academic records"}],["$","li","Check whether HEC nomination, attestation or testing is also required",{"children":"Check whether HEC nomination, attestation or testing is also required"}],["$","li","Keep written confirmation from the host university",{"children":"Keep written confirmation from the host university"}],["$","li","Do not pay an agent for a guaranteed waiver, admission or scholarship",{"children":"Do not pay an agent for a guaranteed waiver, admission or scholarship"}]]}]]}]
1a:["$","section","Scholarship requirement and university requirement are different",{"id":"section-7","children":[["$","h2",null,{"children":"Scholarship requirement and university requirement are different"}],[["$","p","Government and external scholarships often fund study at several universities. The scholarship owner can remove its own test condition without controlling every university's admission policy. Chevening is a useful example: its own English requirement was removed, but the applicant must still satisfy the selected university and obtain an unconditional offer.",{"children":"Government and external scholarships often fund study at several universities. The scholarship owner can remove its own test condition without controlling every university's admission policy. Chevening is a useful example: its own English requirement was removed, but the applicant must still satisfy the selected university and obtain an unconditional offer."}],["$","p","The reverse can also occur. A university may accept MOI for admission while an external scholarship, professional regulator or specific course requires a standardised test. Verify the exact course rather than only the university homepage.",{"children":"The reverse can also occur. A university may accept MOI for admission while an external scholarship, professional regulator or specific course requires a standardised test. Verify the exact course rather than only the university homepage."}]],"$undefined"]}]
1b:["$","section","Do not forget the student visa stage",{"id":"section-8","children":[["$","h2",null,{"children":"Do not forget the student visa stage"}],[["$","p","Admission and visa decisions are separate. A university waiver confirms what the institution accepted; it does not automatically prove that every immigration route will accept the same evidence. Visa rules can depend on the country, institution, course level and how the university recorded the language assessment.",{"children":"Admission and visa decisions are separate. A university waiver confirms what the institution accepted; it does not automatically prove that every immigration route will accept the same evidence. Visa rules can depend on the country, institution, course level and how the university recorded the language assessment."}],["$","p","Use the destination government's current immigration website and the university's international office for guidance. Avoid relying on an old screenshot or a consultant's general statement, because visa and evidence rules can change between intakes.",{"children":"Use the destination government's current immigration website and the university's international office for guidance. Avoid relying on an old screenshot or a consultant's general statement, because visa and evidence rules can change between intakes."}]],"$undefined"]}]
1c:["$","section","A safe application process without IELTS",{"id":"section-9","children":[["$","h2",null,{"children":"A safe application process without IELTS"}],[["$","p","Treat language evidence as part of eligibility research, not as a question to solve after selection. Complete the steps below for every programme in your shortlist and save the evidence with your application records.",{"children":"Treat language evidence as part of eligibility research, not as a question to solve after selection. Complete the steps below for every programme in your shortlist and save the evidence with your application records."}]],["$","ul",null,{"children":[["$","li","1. Open the current scholarship call on the programme owner's official domain",{"children":"1. Open the current scholarship call on the programme owner's official domain"}],["$","li","2. Find the exact degree on the university or consortium website",{"children":"2. Find the exact degree on the university or consortium website"}],["$","li","3. Read the English-language section for your applicant category",{"children":"3. Read the English-language section for your applicant category"}],["$","li","4. Confirm whether MOI or another test is accepted and at what stage",{"children":"4. Confirm whether MOI or another test is accepted and at what stage"}],["$","li","5. Check student-visa evidence on the destination government's website",{"children":"5. Check student-visa evidence on the destination government's website"}],["$","li","6. Email admissions if the published policy does not answer your case",{"children":"6. Email admissions if the published policy does not answer your case"}],["$","li","7. Save the reply, policy URL and date checked",{"children":"7. Save the reply, policy URL and date checked"}],["$","li","8. Keep a test-based backup for programmes that do not confirm a waiver",{"children":"8. Keep a test-based backup for programmes that do not confirm a waiver"}]]}]]}]
1d:["$","section","Warning signs in no-IELTS scholarship lists",{"id":"section-10","children":[["$","h2",null,{"children":"Warning signs in no-IELTS scholarship lists"}],[["$","p","A page can use a real scholarship name and still give unsafe language advice. Verify every claim when a list does not distinguish the scholarship from university admission, fails to name an intake or uses phrases such as 'guaranteed without IELTS.'",{"children":"A page can use a real scholarship name and still give unsafe language advice. Verify every claim when a list does not distinguish the scholarship from university admission, fails to name an intake or uses phrases such as 'guaranteed without IELTS.'"}]],["$","ul",null,{"children":[["$","li","No link or reference to the current official call",{"children":"No link or reference to the current official call"}],["$","li","One rule is claimed for every university in a country",{"children":"One rule is claimed for every university in a country"}],["$","li","The page confuses no IELTS with no language evidence",{"children":"The page confuses no IELTS with no language evidence"}],["$","li","Closed deadlines are presented as currently open",{"children":"Closed deadlines are presented as currently open"}],["$","li","A programme-specific waiver is described as a scholarship-wide rule",{"children":"A programme-specific waiver is described as a scholarship-wide rule"}],["$","li","An agent asks for payment to guarantee a waiver or award",{"children":"An agent asks for payment to guarantee a waiver or award"}]]}]]}]
1e:["$","section","When taking IELTS may still be the better option",{"id":"section-11","children":[["$","h2",null,{"children":"When taking IELTS may still be the better option"}],[["$","p","A waiver can reduce cost or help when a deadline is close, but a recognised test score can expand the number of universities available to you. It may also make your evidence easier to compare across several countries and reduce uncertainty where programme or visa rules are strict.",{"children":"A waiver can reduce cost or help when a deadline is close, but a recognised test score can expand the number of universities available to you. It may also make your evidence easier to compare across several countries and reduce uncertainty where programme or visa rules are strict."}],["$","p","Base the decision on your complete shortlist. If most of your preferred programmes require a standardised test, preparing once may be more efficient than building a narrow shortlist around exceptions. If several strong-fit programmes confirm MOI or another alternative in writing, a waiver route may be reasonable.",{"children":"Base the decision on your complete shortlist. If most of your preferred programmes require a standardised test, preparing once may be more efficient than building a narrow shortlist around exceptions. If several strong-fit programmes confirm MOI or another alternative in writing, a waiver route may be reasonable."}]],"$undefined"]}]
1f:["$","section","How AspireCompass verifies no-IELTS claims",{"id":"section-12","children":[["$","h2",null,{"children":"How AspireCompass verifies no-IELTS claims"}],[["$","p","AspireCompass treats 'without IELTS' as a verification question, not a guarantee. We separate funding, admission and visa rules, prefer current programme-owner and university sources and make programme-specific uncertainty visible.",{"children":"AspireCompass treats 'without IELTS' as a verification question, not a guarantee. We separate funding, admission and visa rules, prefer current programme-owner and university sources and make programme-specific uncertainty visible."}],["$","p","Requirements can change after publication. Before submitting an application, reopen the official call, confirm the exact programme and intake, and retain written evidence of any waiver. AspireCompass does not award scholarships, issue waivers or accept applications.",{"children":"Requirements can change after publication. Before submitting an application, reopen the official call, confirm the exact programme and intake, and retain written evidence of any waiver. AspireCompass does not award scholarships, issue waivers or accept applications."}]],"$undefined"]}]
20:["$","section","Compare the route, not the 'IELTS-free' headline",{"id":"section-13","children":[["$","h2",null,{"children":"Compare the route, not the 'IELTS-free' headline"}],[["$","p","Chevening removed its own English test condition, yet each selected UK university still sets admission requirements. The Japanese MEXT route depends on scholarship category and embassy or university instructions. A Stipendium Hungaricum applicant must satisfy the selected host institution's course language rule. These are three different checks, not three blanket exemptions.",{"children":"Chevening removed its own English test condition, yet each selected UK university still sets admission requirements. The Japanese MEXT route depends on scholarship category and embassy or university instructions. A Stipendium Hungaricum applicant must satisfy the selected host institution's course language rule. These are three different checks, not three blanket exemptions."}],["$","p","For every course, save the institution's actual accepted evidence and the rule's date. A Medium of Instruction letter is a request for an institution-specific decision, not a guarantee of acceptance.",{"children":"For every course, save the institution's actual accepted evidence and the rule's date. A Medium of Instruction letter is a request for an institution-specific decision, not a guarantee of acceptance."}]],["$","ul",null,{"children":[["$","li","Programme: does the award itself demand an IELTS result?",{"children":"Programme: does the award itself demand an IELTS result?"}],["$","li","Course: what evidence does the exact university accept?",{"children":"Course: what evidence does the exact university accept?"}],["$","li","Immigration: what proof does the destination require?",{"children":"Immigration: what proof does the destination require?"}],["$","li","Timing: at which stage must each item be ready?",{"children":"Timing: at which stage must each item be ready?"}]]}]]}]
21:["$","section","An email that resolves a real language-rule uncertainty",{"id":"section-14","children":[["$","h2",null,{"children":"An email that resolves a real language-rule uncertainty"}],[["$","p","Send admissions your intended degree and intake, citizenship, prior university and degree, and the wording your institution can provide on its official Medium of Instruction letter. Ask whether this document satisfies their published English condition for that particular programme. Keep the written answer with your application file.",{"children":"Send admissions your intended degree and intake, citizenship, prior university and degree, and the wording your institution can provide on its official Medium of Instruction letter. Ask whether this document satisfies their published English condition for that particular programme. Keep the written answer with your application file."}],["$","p","If the answer is no, compare other officially accepted tests rather than relying on a third-party list. Policies can differ even between two degrees at the same university.",{"children":"If the answer is no, compare other officially accepted tests rather than relying on a third-party list. Policies can differ even between two degrees at the same university."}]],"$undefined"]}]
22:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Can I get a fully funded scholarship without IELTS?",{"children":[["$","summary",null,{"children":["Can I get a fully funded scholarship without IELTS?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Possibly. Some scholarship routes do not impose a universal IELTS condition, but the selected university may still require IELTS, another test, MOI or an internal assessment. Verify the scholarship, admission and visa rules separately."}]]}],["$","details","Is an MOI certificate accepted instead of IELTS?",{"children":[["$","summary",null,{"children":["Is an MOI certificate accepted instead of IELTS?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Some institutions accept an official Medium of Instruction certificate, while others do not. Acceptance can depend on your previous qualification, institution, nationality, programme and intake. Obtain written confirmation from the admitting university."}]]}],["$","details","Can Pakistani students apply for scholarships without IELTS?",{"children":[["$","summary",null,{"children":["Can Pakistani students apply for scholarships without IELTS?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Yes, when the scholarship and selected institution accept an alternative such as MOI, another test or an interview. Pakistani applicants must also check any HEC nomination, testing and document requirements that apply to the scholarship route."}]]}],["$","details","Does an IELTS waiver also cover the student visa?",{"children":[["$","summary",null,{"children":["Does an IELTS waiver also cover the student visa?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not automatically. University admission and immigration are separate processes. Check the destination government's current student-visa rules and ask the university how your English ability will be recorded for visa purposes."}]]}],["$","details","Which English tests may be accepted instead of IELTS?",{"children":[["$","summary",null,{"children":["Which English tests may be accepted instead of IELTS?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Depending on the programme, alternatives can include TOEFL, PTE Academic, Cambridge English or the Duolingo English Test. Accepted versions, scores and validity periods vary, so use the exact programme page rather than a general list."}]]}],["$","details","Should I take IELTS even if a waiver is available?",{"children":[["$","summary",null,{"children":["Should I take IELTS even if a waiver is available?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Consider your whole shortlist. A test score may open more universities and reduce uncertainty, while a confirmed waiver may save time and cost. Choose the route that keeps the strongest-fit programmes available to you."}]]}]]}]]}]
