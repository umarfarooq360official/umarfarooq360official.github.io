23:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Is there one DSU application for all Italian universities?",{"children":[["$","summary",null,{"children":["Is there one DSU application for all Italian universities?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The responsible regional body or institution depends on where you study. Use the selected university's current funding page to find the correct authority."}]]}],["$","details","Can I apply for DSU before university enrolment?",{"children":[["$","summary",null,{"children":["Can I apply for DSU before university enrolment?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Some calls permit an application while admission or enrolment is pending, followed by a later completion deadline. Follow the exact current call."}]]}],["$","details","What is ISEE parificato or equivalent economic documentation?",{"children":[["$","summary",null,{"children":["What is ISEE parificato or equivalent economic documentation?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"It is a process used to assess a household whose income or assets cannot be captured through the standard Italian ISEE. The institution or authorised service specifies the required foreign documents and calculation route."}]]}],["$","details","Does DSU cover accommodation automatically?",{"children":[["$","summary",null,{"children":["Does DSU cover accommodation automatically?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Accommodation can have its own request, availability, ranking and evidence rules. Read both the scholarship and housing sections of the call."}]]}],["$","details","Can a consultant guarantee a DSU award?",{"children":[["$","summary",null,{"children":["Can a consultant guarantee a DSU award?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The competent body assesses the official application and documents. Use its portal and published contacts."}]]}]]}]]}]
