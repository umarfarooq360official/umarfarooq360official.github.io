n-strip","role":"note","children":[["$","$L4",null,{"ref":"$undefined","iconNode":"$17:props:children:0:props:children:0:props:iconNode","className":"lucide-shield-check","aria-hidden":"true"}],["$","div",null,{"children":[["$","strong",null,{"children":"6 primary sources linked on this page"}],["$","span",null,{"children":"Details are reviewed against official programme, university, government or employer information where available. Always reopen the current official call before applying."}]]}]]}],false,false,false,["$","article",null,{"className":"article-body article-body--guide","children":[["$","div",null,{"className":"article-note","children":[["$","$L4",null,{"ref":"$undefined","iconNode":[["path",{"d":"M10.5 22H6a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h8a2.4 2.4 0 0 1 1.706.706l3.588 3.588A2.4 2.4 0 0 1 20 8v6","key":"g5mvt7"}],["path",{"d":"M14 2v5a1 1 0 0 0 1 1h5","key":"wfsgrz"}],["path",{"d":"m14 20 2 2 4-4","key":"15kota"}]],"className":"lucide-file-check-corner","aria-hidden":"true"}],["$","div",null,{"children":[["$","strong",null,{"children":"Use this guide with the official instructions."}],["$","p",null,{"children":"Programme prompts, limits and document rules always take priority over general advice."}]]}]]}],[["$","section","Quick answer: DSU is regional",{"id":"section-1","children":[["$","h2",null,{"children":"Quick answer: DSU is regional"}],[["$","p","DSU commonly refers to Italy's diritto allo studio, or right-to-study, support. The responsible authority depends on the region and institution. ER.GO manages relevant benefits in Emilia-Romagna, including for students at participating institutions such as the University of Bologna; a student in another region follows that region's body or university instructions.",{"children":"DSU commonly refers to Italy's diritto allo studio, or right-to-study, support. The responsible authority depends on the region and institution. ER.GO manages relevant benefits in Emilia-Romagna, including for students at participating institutions such as the University of Bologna; a student in another region follows that region's body or university instructions."}],["$","p","Do not apply through a random DSU link found in an old video. Start at the university's current financial-aid page, identify its competent regional body and open the call for the correct academic year.",{"children":"Do not apply through a random DSU link found in an old video. Start at the university's current financial-aid page, identify its competent regional body and open the call for the correct academic year."}]],"$undefined"]}],"$L1c","$L1d","$L1e","$L1f","$L20","$L21"]]}],"$L22","$L23"]}],"$L24"]}]
1a:["$","section",null,{"className":"related-section","children":["$","div",null,{"className":"site-shell","children":[["$","div",null,{"className":"section-heading","children":[["$","span",null,{"className":"eyebrow","children":"Continue exploring"}],["$","h2",null,{"children":"Related pages"}]]}],["$","div",null,{"className":"related-grid","children":[["$","$L3","countries/italy",{"href":"/countries/italy","children":[["$","span",null,{"children":"Italy destination guide · 14 min read"}],["$","h3",null,{"children":"Scholarships and study routes in Italy for international students"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","scholarships/italy",{"href":"/scholarships/italy","children":[["$","span",null,{"children":"Italy funding guide · 13 min read"}],["$","h3",null,{"children":"Scholarships in Italy for international students"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","guides/italy-universities-tuition-fees",{"href":"/guides/italy-universities-tuition-fees","children":[["$","span",null,{"children":"University cost comparison · 14 min read"}],["$","h3",null,{"children":"Italian universities and tuition fees for international students"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","guides/cost-of-living-in-italy-for-students",{"href":"/guides/cost-of-living-in-italy-for-students","children":[["$","span",null,{"children":"Student budget guide · 15 min read"}],["$","h3",null,{"children":"Cost of living in Italy for international students"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","tools/italy-study-cost-calculator",{"href":"/tools/italy-study-cost-calculator","children":[["$","span",null,{"children":"Free Italy budget tool · instant result"}],["$","h3",null,{"children":"Italy study cost and scholarship budget calculator"}],["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]}]
1c:["$","section","Economic and academic conditions work together",{"id":"section-2","children":[["$","h2",null,{"children":"Economic and academic conditions work together"}],[["$","p","A first-year application is normally assessed using economic conditions and the enrolment rules in the call. Continued or later-year benefits can depend on earning the required credits by specified dates. The exact thresholds, credit rules and exceptions must be taken from the current regional notice.",{"children":"A first-year application is normally assessed using economic conditions and the enrolment rules in the call. Continued or later-year benefits can depend on earning the required credits by specified dates. The exact thresholds, credit rules and exceptions must be taken from the current regional notice."}],["$","p","For 2026–2027, ER.GO published €25,000 ISEE and €50,000 ISPE access thresholds for its scholarship and accommodation benefits. Both values had to fall within the stated limits. These are ER.GO figures for a named year and should not be copied to another region or future call.",{"children":"For 2026–2027, ER.GO published €25,000 ISEE and €50,000 ISPE access thresholds for its scholarship and accommodation benefits. Both values had to fall within the stated limits. These are ER.GO figures for a named year and should not be copied to another region or future call."}]],"$undefined"]}]
1d:["$","section","Documents for income and assets outside Italy",{"id":"section-3","children":[["$","h2",null,{"children":"Documents for income and assets outside Italy"}],[["$","p","International applicants whose family unit has income or assets abroad must prove the household's composition and economic position according to the regional instructions. Typical categories include household members, annual income, buildings or land, and bank or other movable assets, but the call determines the precise reference year and evidence.",{"children":"International applicants whose family unit has income or assets abroad must prove the household's composition and economic position according to the regional instructions. Typical categories include household members, annual income, buildings or land, and bank or other movable assets, but the call determines the precise reference year and evidence."}],["$","p","Documents may need issue by the competent authority, translation and legalisation or another accepted authentication. Prepare from the official checklist and keep names, dates and family relationships consistent across every document. A self-written statement is not a substitute when the call requires official evidence.",{"children":"Documents may need issue by the competent authority, translation and legalisation or another accepted authentication. Prepare from the official checklist and keep names, dates and family relationships consistent across every document. A self-written statement is not a substitute when the call requires official evidence."}]],["$","ul",null,{"children":[["$","li","Family composition certificate",{"children":"Family composition certificate"}],["$","li","Income for each adult household member",{"children":"Income for each adult household member"}],["$","li","Property or no-property evidence",{"children":"Property or no-property evidence"}],["$","li","Bank and other asset evidence",{"children":"Bank and other asset evidence"}],["$","li","Required translation",{"children":"Required translation"}],["$","li","Legalisation, apostille or consular process stated in the call",{"children":"Legalisation, apostille or consular process stated in the call"}]]}]]}]
1e:["$","section","Student status can change the benefit",{"id":"section-4","children":[["$","h2",null,{"children":"Student status can change the benefit"}],[["$","p","Regional calls can distinguish students living at home, commuting and living away from home. Accommodation evidence and deadlines can affect this classification. ER.GO explains that the assigned amount varies with domicile and provides specific guidance for international students with income and assets abroad.",{"children":"Regional calls can distinguish students living at home, commuting and living away from home. Accommodation evidence and deadlines can affect this classification. ER.GO explains that the assigned amount varies with domicile and provides specific guidance for international students with income and assets abroad."}],["$","p","Do not assume that selecting an away-from-home option is enough. Read what contract, duration, registration or residence evidence must be submitted and when.",{"children":"Do not assume that selecting an away-from-home option is enough. Read what contract, duration, registration or residence evidence must be submitted and when."}]],"$undefined"]}]
1f:["$","section","Admission and DSU use separate clocks",{"id":"section-5","children":[["$","h2",null,{"children":"Admission and DSU use separate clocks"}],[["$","p","A DSU deadline may arrive before enrolment is complete. Follow the call's rule for applicants awaiting admission and note any later deadline to finalise enrolment. Missing the scholarship deadline is not normally repaired by receiving a university offer later.",{"children":"A DSU deadline may arrive before enrolment is complete. Follow the call's rule for applicants awaiting admission and note any later deadline to finalise enrolment. Missing the scholarship deadline is not normally repaired by receiving a university offer later."}],["$","p","The main ER.GO scholarship deadline shown for 2026–2027 was 24 August 2026 at 16:00. Use it only as historical planning context and check the next official call for new dates.",{"children":"The main ER.GO scholarship deadline shown for 2026–2027 was 24 August 2026 at 16:00. Use it only as historical planning context and check the next official call for new dates."}]],"$undefined"]}]
20:["$","section","What a DSU benefit may contain",{"id":"section-6","children":[["$","h2",null,{"children":"What a DSU benefit may contain"}],[["$","p","Depending on the authority and student status, support may combine a monetary grant with catering, accommodation or other services. The headline amount can be affected by services provided and later verification. Read the payment schedule and conditions before building a budget.",{"children":"Depending on the authority and student status, support may combine a monetary grant with catering, accommodation or other services. The headline amount can be affected by services provided and later verification. Read the payment schedule and conditions before building a budget."}],["$","p","Plan for tuition and mandatory university charges separately. A DSU application can interact with fee reductions, but the university explains how fees are assessed and when documents must be registered.",{"children":"Plan for tuition and mandatory university charges separately. A DSU application can interact with fee reductions, but the university explains how fees are assessed and when documents must be registered."}]],"$undefined"]}]
21:["$","section","Final DSU application checklist",{"id":"section-7","children":[["$","h2",null,{"children":"Final DSU application checklist"}],[["$","p","Complete this check from the current call and keep a saved copy of every submitted record.",{"children":"Complete this check from the current call and keep a saved copy of every submitted record."}]],["$","ul",null,{"children":[["$","li","Correct region and academic year",{"children":"Correct region and academic year"}],["$","li","Eligible course and institution",{"children":"Eligible course and institution"}],["$","li","Economic thresholds checked",{"children":"Economic thresholds checked"}],["$","li","Foreign documents complete and authenticated",{"children":"Foreign documents complete and authenticated"}],["$","li","Online application submitted before the exact time",{"children":"Online application submitted before the exact time"}],["$","li","Accommodation evidence planned",{"children":"Accommodation evidence planned"}],["$","li","Admission and enrolment follow-up dates recorded",{"children":"Admission and enrolment follow-up dates recorded"}],["$","li","Credit and renewal rules understood",{"children":"Credit and renewal rules understood"}]]}]]}]
