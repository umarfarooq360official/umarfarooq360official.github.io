1e:["$","ul",null,{"children":[["$","li","University admission or positive evaluation",{"children":"University admission or positive evaluation"}],["$","li","Universitaly pre-enrolment submitted",{"children":"Universitaly pre-enrolment submitted"}],["$","li","University validation completed",{"children":"University validation completed"}],["$","li","Authorised appointment route followed",{"children":"Authorised appointment route followed"}],["$","li","Complete visa file submitted in person",{"children":"Complete visa file submitted in person"}]]}]
1f:["$","section","The six-stage route from Pakistan to Italy",{"id":"section-2","children":[["$","h2",null,{"children":"The six-stage route from Pakistan to Italy"}],[["$","p","Keep admission, scholarship, Universitaly and visa tasks in separate rows. A scholarship offer does not replace university admission, and a validated pre-enrolment does not guarantee a visa.",{"children":"Keep admission, scholarship, Universitaly and visa tasks in separate rows. A scholarship offer does not replace university admission, and a validated pre-enrolment does not guarantee a visa."}],["$","p","Begin document preparation while the university is evaluating your application, but check the current academic-year instructions before legalising, translating or purchasing anything.",{"children":"Begin document preparation while the university is evaluating your application, but check the current academic-year instructions before legalising, translating or purchasing anything."}]],["$","ul",null,{"children":[["$","li","1. Shortlist the exact degree and intake",{"children":"1. Shortlist the exact degree and intake"}],["$","li","2. Apply through the university portal",{"children":"2. Apply through the university portal"}],["$","li","3. Accept or satisfy the admission conditions",{"children":"3. Accept or satisfy the admission conditions"}],["$","li","4. Complete Universitaly pre-enrolment",{"children":"4. Complete Universitaly pre-enrolment"}],["$","li","5. Follow the authorised Pakistan appointment process",{"children":"5. Follow the authorised Pakistan appointment process"}],["$","li","6. Submit the visa application and wait for the official decision",{"children":"6. Submit the visa application and wait for the official decision"}]]}]]}]
20:["$","section","Build one document file with clear categories",{"id":"section-3","children":[["$","h2",null,{"children":"Build one document file with clear categories"}],[["$","p","The competent mission and current checklist decide the final documents. A planning file commonly includes identity records, university and Universitaly evidence, prior qualifications, financial evidence, accommodation, insurance and travel information.",{"children":"The competent mission and current checklist decide the final documents. A planning file commonly includes identity records, university and Universitaly evidence, prior qualifications, financial evidence, accommodation, insurance and travel information."}],["$","p","Names, dates, passport details and academic records should remain consistent across the file. If a document needs translation, legalisation, apostille, a Declaration of Value or CIMEA evidence, follow the current university and consular instruction rather than a general social-media checklist.",{"children":"Names, dates, passport details and academic records should remain consistent across the file. If a document needs translation, legalisation, apostille, a Declaration of Value or CIMEA evidence, follow the current university and consular instruction rather than a general social-media checklist."}]],["$","ul",null,{"children":[["$","li","Valid passport and required photographs",{"children":"Valid passport and required photographs"}],["$","li","Admission and Universitaly validation evidence",{"children":"Admission and Universitaly validation evidence"}],["$","li","Academic qualifications and requested recognition documents",{"children":"Academic qualifications and requested recognition documents"}],["$","li","Financial means and sponsor evidence where relevant",{"children":"Financial means and sponsor evidence where relevant"}],["$","li","Accommodation evidence",{"children":"Accommodation evidence"}],["$","li","Medical or travel insurance meeting the current rule",{"children":"Medical or travel insurance meeting the current rule"}],["$","li","Forms, fee and any travel reservation requested by the checklist",{"children":"Forms, fee and any travel reservation requested by the checklist"}]]}]]}]
21:["$","section","Financial evidence must tell a coherent story",{"id":"section-4","children":[["$","h2",null,{"children":"Financial evidence must tell a coherent story"}],[["$","p","Visa officers assess whether the applicant can realistically fund tuition and living costs. Present the source of funds clearly and keep sponsor identity, income, bank activity and relationship evidence consistent.",{"children":"Visa officers assess whether the applicant can realistically fund tuition and living costs. Present the source of funds clearly and keep sponsor identity, income, bank activity and relationship evidence consistent."}],["$","p","Required amounts and acceptable evidence can change. Use the current official checklist for the exact figure and period; do not copy an old euro amount from a video. A scholarship may support the file, but it does not automatically remove every financial-document requirement.",{"children":"Required amounts and acceptable evidence can change. Use the current official checklist for the exact figure and period; do not copy an old euro amount from a video. A scholarship may support the file, but it does not automatically remove every financial-document requirement."}]],"$undefined"]}]
22:["$","section","Accommodation, insurance and appointment safety",{"id":"section-5","children":[["$","h2",null,{"children":"Accommodation, insurance and appointment safety"}],[["$","p","Accommodation evidence should match the city, dates and study plan. Insurance must follow the duration, territory and coverage stated in the current checklist. Keep confirmations readable and verifiable.",{"children":"Accommodation evidence should match the city, dates and study plan. Insurance must follow the duration, territory and coverage stated in the current checklist. Keep confirmations readable and verifiable."}],["$","p","Use only the appointment route published by the Embassy or authorised visa centre. The Embassy warns that appointments should not be purchased and that unofficial intermediaries can expose applicants to fraud.",{"children":"Use only the appointment route published by the Embassy or authorised visa centre. The Embassy warns that appointments should not be purchased and that unofficial intermediaries can expose applicants to fraud."}]],"$undefined"]}]
23:["$","section","After arrival: complete the residence steps",{"id":"section-6","children":[["$","h2",null,{"children":"After arrival: complete the residence steps"}],[["$","p","A non-EU student staying for more than three months generally applies for a study residence permit within eight working days of arrival. The university international office can explain local enrolment, tax-code, health and housing procedures.",{"children":"A non-EU student staying for more than three months generally applies for a study residence permit within eight working days of arrival. The university international office can explain local enrolment, tax-code, health and housing procedures."}],["$","p","Carry the documents used for admission and the visa in your hand luggage. Border and local authorities may ask to see evidence again, and the university may still require original or verified academic records for final enrolment.",{"children":"Carry the documents used for admission and the visa in your hand luggage. Border and local authorities may ask to see evidence again, and the university may still require original or verified academic records for final enrolment."}]],["$","ul",null,{"children":[["$","li","Reach the university and confirm final enrolment",{"children":"Reach the university and confirm final enrolment"}],["$","li","Apply for the residence permit within the applicable deadline",{"children":"Apply for the residence permit within the applicable deadline"}],["$","li","Complete tax-code and health-cover steps",{"children":"Complete tax-code and health-cover steps"}],["$","li","Register accommodation where required",{"children":"Register accommodation where required"}],["$","li","Store every receipt and appointment notice",{"children":"Store every receipt and appointment notice"}]]}]]}]
24:["$","section","Final anti-refusal check",{"id":"section-7","children":[["$","h2",null,{"children":"Final anti-refusal check"}],[["$","p","Before submission, compare every document with the current official checklist and arrange the file in the same order. Prepare short, truthful answers about the degree, university, funding, accommodation and career plan.",{"children":"Before submission, compare every document with the current official checklist and arrange the file in the same order. Prepare short, truthful answers about the degree, university, funding, accommodation and career plan."}],["$","p","No website or agent can guarantee approval. AspireCompass provides planning information only; the competent Italian authority makes the visa decision.",{"children":"No website or agent can guarantee approval. AspireCompass provides planning information only; the competent Italian authority makes the visa decision."}]],"$undefined"]}]
