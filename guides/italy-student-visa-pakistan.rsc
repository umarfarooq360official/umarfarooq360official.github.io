26:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","Do Pakistani students apply on Universitaly before the visa?",{"children":[["$","summary",null,{"children":["Do Pakistani students apply on Universitaly before the visa?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"For relevant higher-education study routes, applicants complete Universitaly pre-enrolment and the university validates it before the visa appointment process moves forward. Follow the exact university and Embassy instructions for your intake."}]]}],["$","details","Does Universitaly validation guarantee an Italian student visa?",{"children":[["$","summary",null,{"children":["Does Universitaly validation guarantee an Italian student visa?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It supports the visa process but does not guarantee approval. Admission, funding, pre-enrolment and the visa remain separate decisions."}]]}],["$","details","Should I pay an agent for an Italy visa appointment?",{"children":[["$","summary",null,{"children":["Should I pay an agent for an Italy visa appointment?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. Follow only the appointment route published by the Italian Embassy or its authorised centre. The Embassy has warned applicants not to purchase appointments."}]]}],["$","details","Can a scholarship replace financial evidence?",{"children":[["$","summary",null,{"children":["Can a scholarship replace financial evidence?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Not automatically. The current visa checklist determines which financial and sponsorship evidence is still required after a scholarship is considered."}]]}],["$","details","What must I do after reaching Italy?",{"children":[["$","summary",null,{"child