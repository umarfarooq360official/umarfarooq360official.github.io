21:["$","section","Documents: audit the file before paying",{"id":"section-3","children":[["$","h2",null,{"children":"Documents: audit the file before paying"}],[["$","p","Polimi's checklist requires qualification evidence, the bachelor's transcript, an official CGPA/grading-scale statement and CV; relevant design/architecture routes also require a portfolio. Its page warns that documents cannot be changed or added after application-fee payment.",{"children":"Polimi's checklist requires qualification evidence, the bachelor's transcript, an official CGPA/grading-scale statement and CV; relevant design/architecture routes also require a portfolio. Its page warns that documents cannot be changed or added after application-fee payment."}],["$","p","Run a pre-payment review: readable scans, complete sides, correct names, appropriate language and the correct programme selection. If your final qualification is not available, use the official checklist to confirm the permitted provisional or final-year evidence. Keep a question log rather than uploading an unexplained incomplete file.",{"children":"Run a pre-payment review: readable scans, complete sides, correct names, appropriate language and the correct programme selection. If your final qualification is not available, use the official checklist to confirm the permitted provisional or final-year evidence. Keep a question log rather than uploading an unexplained incomplete file."}]],"$undefined","$undefined","$undefined"]}]
22:["$","section","English evidence and other language obligations",{"id":"section-4","children":[["$","h2",null,{"children":"English evidence and other language obligations"}],[["$","p","Use the 2027–2028 document list for accepted certificates and MOI conditions. The Italy English comparison guide gives the test thresholds and TOEFL test-date distinction.",{"children":"Use the 2027–2028 document list for accepted certificates and MOI conditions. The Italy English comparison guide gives the test thresholds and TOEFL test-date distinction."}],["$","p","Language evidence may be provided after the initial academic application under the stated process, but that does not make it optional. Separately check any Italian requirement for your teaching language and any graduation obligation.",{"children":"Language evidence may be provided after the initial academic application under the stated process, but that does not make it optional. Separately check any Italian requirement for your teaching language and any graduation obligation."}]],"$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for English evidence and other language obligations","children":[["$","$L3","/guides/study-in-italy-admission-english-requirements/",{"href":"/guides/study-in-italy-admission-english-requirements/","children":["Read the English-score comparison",["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
23:["$","section","Merit funding: admission alone is not enough",{"id":"section-5","children":[["$","h2",null,{"children":"Merit funding: admission alone is not enough"}],[["$","p","The 2027–2028 call makes early-bird admission payment a condition and requires a separate Online Services scholarship form. The call gives an acceptance administrative charge of approximately €190; its PDF takes priority over the overview page's older approximate figure.",{"children":"The 2027–2028 call makes early-bird admission payment a condition and requires a separate Online Services scholarship form. The call gives an acceptance administrative charge of approximately €190; its PDF takes priority over the overview page's older approximate figure."}]],[["$","div",null,{"className":"guide-table-wrap","role":"region","aria-label":"Three separate merit-funding tasks for 2027–2028","tabIndex":0,"children":["$","table",null,{"className":"guide-table","children":[["$","caption",null,{"children":"Three separate merit-funding tasks for 2027–2028"}],["$","thead",null,{"children":["$","tr",null,{"children":[["$","th","Task",{"scope":"col","children":"Task"}],["$","th","Published cut-off",{"scope":"col","children":"Published cut-off"}],["$","th","Source",{"scope":"col","children":"Source"}]]}]}],["$","tbody",null,{"children":[["$","tr","0",{"children":[["$","th","0",{"scope":"row","children":"Eligible admission payment"}],["$","td","1",{"children":"1 Oct–1 Dec 2026"}],["$","td","2",{"children":"Merit call, Article 2"}]]}],["$","tr","1",{"children":[["$","th","0",{"scope":"row","children":"Scholarship form"}],["$","td","1",{"children":"15 Dec 2026, 12:00 noon Italian time"}],["$","td","2",{"children":"Merit call, Article 2"}]]}],["$","tr","2",{"children":[["$","th","0",{"scope":"row","children":"Valid English evidence"}],["$","td","1",{"children":"4 Mar 2027"}],["$","td","2",{"children":"Official scholarship overview"}]]}]]}]]}]}],["$","p",null,{"className":"table-source","children":["Source: ",["$","a",null,{"href":"https://www.polimi.it/fileadmin/user_upload/futuri_studenti/borse-di-studio/Merit_Based_Call_For_Applications_a.y._2027-2028.pdf","target":"_blank","rel":"noreferrer","children":"Polimi merit-scholarship call: 2027–2028 PDF"}]]}]],["$","ul",null,{"children":[["$","li","Scholarship value and eligibility depend on award type and campus.",{"children":"Scholarship value and eligibility depend on award type and campus."}],["$","li","Read incompatibility and renewal terms before relying on two funding offers.",{"children":"Read incompatibility and renewal terms before relying on two funding offers."}],["$","li","A tuition waiver may not provide cash for living expenses.",{"children":"A tuition waiver may not provide cash for living expenses."}]]}],"$undefined"]}]
24:["$","section","Tuition and arrival costs",{"id":"section-6","children":[["$","h2",null,{"children":"Tuition and arrival costs"}],[["$","p","Polimi's published 2026–2027 standard-load system runs up to €3,943.04, with ECTS and category conditions. Reserved non-EU master's students with a foreign qualification and without qualifying funding can be charged the maximum. This is a historical budget reference, not a confirmed 2027–2028 invoice.",{"children":"Polimi's published 2026–2027 standard-load system runs up to €3,943.04, with ECTS and category conditions. Reserved non-EU master's students with a foreign qualification and without qualifying funding can be charged the maximum. This is a historical budget reference, not a confirmed 2027–2028 invoice."}],["$","p","Choose the campus before estimating rent. Record tuition without an award, tuition if funded and cash needed before disbursement as three separate figures. Check official accommodation information, then compare actual room offers and commuting costs.",{"children":"Choose the campus before estimating rent. Record tuition without an award, tuition if funded and cash needed before disbursement as three separate figures. Check official accommodation information, then compare actual room offers and commuting costs."}]],"$undefined","$undefined",["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Tuition and arrival costs","children":[["$","$L3","/tools/italy-study-cost-calculator/",{"href":"/tools/italy-study-cost-calculator/","children":["Build your first-year budget",["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
25:["$","section","Before submission and after admission",{"id":"section-7","children":[["$","h2",null,{"children":"Before submission and after admission"}],[["$","p","Apply only when the document audit is complete. Save proof of admission and funding submissions separately. After a positive decision, follow qualification checks and Universitaly instructions for your situation; do not assume an academic offer resolves the visa.",{"children":"Apply only when the document audit is complete. Save proof of admission and funding submissions separately. After a positive decision, follow qualification checks and Universitaly instructions for your situation; do not assume an academic offer resolves the visa."}]],"$undefined",["$","ul",null,{"children":[["$","li","Exact MSc and campus selected.",{"children":"Exact MSc and campus selected."}],["$","li","Qualification and CGPA eligibility checked.",{"children":"Qualification and CGPA eligibility checked."}],["$","li","Documents reviewed before payment.",{"children":"Documents reviewed before payment."}],["$","li","Admission and scholarship receipts saved.",{"children":"Admission and scholarship receipts saved."}],["$","li","English deadline recorded.",{"children":"English deadline recorded."}],["$","li","Unfunded budget and after-admission conditions understood.",{"children":"Unfunded budget and after-admission conditions understood."}]]}],["$","nav",null,{"className":"answer-links","aria-label":"Next steps for Before submission and after admission","children":[["$","$L3","/guides/universitaly-pre-enrolment/",{"href":"/guides/universitaly-pre-enrolment/","children":["Universitaly next steps",["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}],["$","$L3","/guides/italy-dsu-scholarships/",{"href":"/guides/italy-dsu-scholarships/","children":["Compare regional DSU funding",["$","$L4",null,{"ref":"$undefined","iconNode":"$e:props:children:1:props:iconNode","className":"lucide-arrow-right","aria-hidden":"true"}]]}]]}]]}]
