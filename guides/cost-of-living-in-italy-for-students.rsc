],["$","p","Create a low, expected and high estimate. Do not count a scholarship until its amount, payment timing and renewal conditions are confirmed in the current call.",{"children":"Create a low, expected and high estimate. Do not count a scholarship until its amount, payment timing and renewal conditions are confirmed in the current call."}]],"$undefined"]}],"$L19","$L1a","$L1b","$L1c","$L1d"]]}],"$L1e","$L1f"]}],"$L20"]}]
