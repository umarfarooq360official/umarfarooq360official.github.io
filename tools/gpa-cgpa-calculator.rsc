1e:["$","section",null,{"className":"faq-section","children":[["$","span",null,{"className":"eyebrow","children":"Quick answers"}],["$","h2",null,{"children":"Frequently asked questions"}],["$","div",null,{"children":[["$","details","How do I calculate GPA with credit hours?",{"children":[["$","summary",null,{"children":["How do I calculate GPA with credit hours?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Multiply each course grade point by its credit hours, add the results and divide by the total included credit hours. The interactive calculator performs these steps automatically."}]]}],["$","details","How can I calculate the GPA needed to reach a target?",{"children":[["$","summary",null,{"children":["How can I calculate the GPA needed to reach a target?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"Enter your current GPA, completed credits, future credits and target GPA in the target planner. It calculates the average required across the future credits and flags a result above 4.00 as unavailable on a standard 4.0 scale."}]]}],["$","details","Is CGPA divided by 10 and multiplied by 100 always correct?",{"children":[["$","summary",null,{"children":["Is CGPA divided by 10 and multiplied by 100 always correct?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It is only a proportional estimate for a 10-point scale. Universities and credential evaluators may use a different institution- or country-specific method."}]]}],["$","details","Can I convert percentage directly to a 4.0 GPA?",{"children":[["$","summary",null,{"children":["Can I convert percentage directly to a 4.0 GPA?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"You can create a rough proportional estimate, but an official decision may consider grade bands, pass marks, institution standards and individual courses. Follow the receiving institution's instructions."}]]}],["$","details","Does a calculated GPA prove scholarship eligibility?",{"children":[["$","summary",null,{"children":["Does a calculated GPA prove scholarship eligibility?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. It can help you compare an academic threshold, but official eligibility and selection depend on the complete current programme rules."}]]}],["$","details","Does AspireCompass store my grades?",{"children":[["$","summary",null,{"children":["Does AspireCompass store my grades?",["$","span",null,{"children":"+"}]]}],["$","p",null,{"children":"No. The calculator runs in your browser and does not require an account or submission of a transcript."}]]}]]}]]}]
