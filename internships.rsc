21:["$","section","Recognise a legitimate selection process",{"id":"section-4","children":[["$","h2",null,{"children":"Recognise a legitimate selection process"}],[["$","p","A credible vacancy identifies the organisation, role, location, duration, responsibilities and application portal. Be especially cautious when a message moves immediately to private chat, asks for a payment or promises selection without assessment.",{"children":"A credible vacancy identifies the organisation, role, location, duration, responsibilities and application portal. Be especially cautious when a message moves immediately to private chat, asks for a payment or promises selection without assessment."}]],["$","ul",null,{"children":[["$","li","Search for the role on the employer's own domain",{"children":"Search for the role on the employer's own domain"}],["$","li","Check the sender's full email address",{"children":"Check the sender's full email address"}],["$","li","Never pay for a guaranteed interview",{"children":"Never pay for a guaranteed interview"}],["$","li","Do not share banking passwords or one-time codes",{"children":"Do not share banking passwords or one-time codes"}],["$","li","Keep copies of the vacancy and submission receipt",{"children":"Keep copies of the vacancy and submission receipt"}]]}]]}]
